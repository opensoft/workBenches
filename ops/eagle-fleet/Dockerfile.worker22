FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS node
FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS dockercli
FROM ghcr.io/actions/actions-runner@sha256:4ffadc0002b2581327e06101fc8c06cd189232baf79fe561fac9caeb76f5e807 AS runner
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends sudo python3 python3-pip python3-venv python3-yaml build-essential pkg-config jq zsh shellcheck netcat-openbsd openssh-client git git-lfs rsync zip unzip xz-utils bubblewrap curl ca-certificates gnupg libicu70 libkrb5-3 liblttng-ust1 libssl3 libunwind8 zlib1g \
    && useradd --create-home --uid 1001 --user-group --shell /bin/bash runner \
    && usermod -aG sudo runner \
    && printf 'runner ALL=(ALL) NOPASSWD:ALL\nDefaults env_keep += "http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY"\n' > /etc/sudoers.d/eagle-runner \
    && chmod 440 /etc/sudoers.d/eagle-runner \
    && mkdir -p /opt/hostedtoolcache /opt/eagle && chmod 1777 /opt/hostedtoolcache \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && printf 'deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/ /usr/local/
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
COPY --from=runner --chown=1001:1001 /home/runner/ /home/runner/
COPY --chmod=755 job-started.sh /opt/eagle/job-started.sh
COPY --chmod=755 eagle-ssh-proxy /usr/local/bin/eagle-ssh-proxy
COPY --chown=1001:1001 ssh_config /home/runner/.ssh/config
ENV RUNNER_TOOL_CACHE=/opt/hostedtoolcache AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache PIP_BREAK_SYSTEM_PACKAGES=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/eagle/job-started.sh
WORKDIR /home/runner
USER runner
RUN test "$(. /etc/os-release; echo "$VERSION_ID")" = 22.04 && python3 --version && node --version && gh --version && docker compose version && ./bin/Runner.Listener --version
