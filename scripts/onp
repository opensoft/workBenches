#!/usr/bin/env bash
# Legacy name/parent arguments are handled by project new.
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$script_dir/new-project.sh" ]; then
    exec bash "$script_dir/new-project.sh" "$@"
fi
# setup-workbenches also supports copying onp beside the installed executable.
# Route that case through the repository shim so ownership is verified first.
workbenches_root="${WORKBENCHES_ROOT:-}"
if [ -z "$workbenches_root" ] && [ -f "$script_dir/.workbenches-path" ]; then
    workbenches_root="$(cat "$script_dir/.workbenches-path")"
fi
if [ -n "$workbenches_root" ] && [ -f "$workbenches_root/scripts/project" ]; then
    export OPENREPOPROJECT_BIN_DIR="$script_dir"
    exec bash "$workbenches_root/scripts/project" new "$@"
fi
echo 'project is not installed or is not owned by workBenches; run workBenches/scripts/setup-project-command.py' >&2
exit 2
