#!/usr/bin/env bash
# Legacy name/parent arguments are handled by project new.
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$script_dir/new-project.sh" ]; then
    exec bash "$script_dir/new-project.sh" "$@"
fi
# setup-workbenches also supports copying onp beside the installed executable.
if [ -f "$script_dir/project" ]; then
    exec python3 "$script_dir/project" new "$@"
fi
echo 'project is not installed; run workBenches/scripts/setup-project-command.py' >&2
exit 2
