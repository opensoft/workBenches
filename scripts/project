#!/usr/bin/env bash
# workBenches owns discovery of its installation; openRepoProject owns the CLI.
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WORKBENCHES_ROOT="${WORKBENCHES_ROOT:-$(dirname "$script_dir")}"
installer="$script_dir/setup-project-command.py"
candidate_dirs=()
if [ -n "${OPENREPOPROJECT_BIN_DIR:-}" ]; then
    candidate_dirs+=("$OPENREPOPROJECT_BIN_DIR")
else
    command_path="$(command -v project 2>/dev/null || true)"
    if [ -n "$command_path" ]; then
        candidate_dirs+=("$(dirname "$command_path")")
    fi
    discovery_file="${WORKBENCHES_PROJECT_DISCOVERY_FILE:-$HOME/.config/workbenches/project-bin}"
    if [ -f "$discovery_file" ] && [ ! -L "$discovery_file" ]; then
        IFS= read -r discovered_dir < "$discovery_file" || true
        if [[ "$discovered_dir" == /* ]]; then
            candidate_dirs+=("$discovered_dir")
        fi
    fi
    candidate_dirs+=("$HOME/.local/bin" "/usr/local/bin")
fi

for candidate_dir in "${candidate_dirs[@]}"; do
    if python3 "$installer" --bin-dir "$candidate_dir" --resolve-owned >/dev/null 2>&1; then
        exec python3 "$installer" --bin-dir "$candidate_dir" --exec-owned -- "$@"
    fi
done

echo 'project is not installed or is not owned by workBenches. Run: python3 scripts/setup-project-command.py' >&2
exit 2
