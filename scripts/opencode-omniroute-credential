#!/usr/bin/env bash
set -euo pipefail
umask 077

ACTION="${1:-}"
[[ -n "$ACTION" ]] || {
    echo "Usage: opencode-omniroute-credential {capture|install|status} [--force]" >&2
    exit 2
}
shift

FORCE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --force) FORCE=true; shift ;;
        -h|--help)
            echo "Usage: opencode-omniroute-credential {capture|install|status} [--force]"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
done

case "$ACTION" in
    capture|install|status) ;;
    *) echo "Unknown action: $ACTION" >&2; exit 2 ;;
esac

command -v jq >/dev/null 2>&1 || { echo "jq is required." >&2; exit 1; }

credentials_root="${WORKBENCHES_CREDENTIALS_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/workbenches/credentials}"
credential_file="${OMNIROUTE_CREDENTIAL_FILE:-$credentials_root/opencode/omniroute.json}"
opencode_auth_file="${OPENCODE_SHARED_AUTH_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json}"

valid_credential() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] || return 1
    jq -e '
      type == "object"
      and (keys | sort) == ["key", "type"]
      and .type == "api"
      and (.key | type == "string" and length > 0)
    ' "$path" >/dev/null 2>&1
}

valid_installed_auth() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] || return 1
    jq -e '
      type == "object"
      and (.omniroute | type == "object")
      and (.omniroute | keys | sort) == ["key", "type"]
      and .omniroute.type == "api"
      and (.omniroute.key | type == "string" and length > 0)
    ' "$path" >/dev/null 2>&1
}

owner_only_file() {
    local path="$1" mode
    [[ "$(stat -c '%u' "$path")" == "$(id -u)" ]] || return 1
    mode="$(stat -c '%a' "$path")"
    (( (8#$mode & 077) == 0 ))
}

safe_parent() {
    local path="$1" parent
    parent="$(dirname "$path")"
    if [[ ! -d "$parent" ]]; then
        mkdir -p -- "$parent"
        chmod 0700 "$parent"
    fi
    [[ -d "$parent" && ! -L "$parent" && "$(stat -c '%u' "$parent")" == "$(id -u)" ]]
}

case "$ACTION" in
    status)
        installed=false
        escrow_ready=false
        valid_installed_auth "$opencode_auth_file" && installed=true
        if valid_credential "$credential_file" && owner_only_file "$credential_file"; then
            escrow_ready=true
        fi
        printf 'OpenCode OmniRoute: installed=%s escrow-ready=%s\n' "$installed" "$escrow_ready"
        [[ "$installed" == true ]]
        ;;

    capture)
        [[ -f "$opencode_auth_file" && ! -L "$opencode_auth_file" ]] || {
            echo "OpenCode authentication file is missing." >&2
            exit 1
        }
        owner_only_file "$opencode_auth_file" || {
            echo "OpenCode authentication file must be owner-only." >&2
            exit 1
        }
        valid_installed_auth "$opencode_auth_file" || {
            echo "OpenCode has no valid OmniRoute provider credential." >&2
            exit 1
        }
        if [[ -e "$credential_file" && "$FORCE" != true ]]; then
            valid_credential "$credential_file" && owner_only_file "$credential_file" || {
                echo "Existing standalone OmniRoute credential is invalid." >&2
                exit 1
            }
            echo "Preserved existing standalone OmniRoute credential."
            exit 0
        fi
        safe_parent "$credential_file" || {
            echo "Standalone OmniRoute credential parent is unsafe." >&2
            exit 1
        }
        tmp="$(mktemp "$(dirname "$credential_file")/.omniroute.XXXXXX")"
        trap 'rm -f -- "${tmp:-}"' EXIT
        jq '.omniroute' "$opencode_auth_file" >"$tmp"
        chmod 0600 "$tmp"
        valid_credential "$tmp" || {
            echo "Captured OmniRoute provider record is invalid." >&2
            exit 1
        }
        mv -f -- "$tmp" "$credential_file"
        trap - EXIT
        echo "Captured standalone OmniRoute credential for durable backup."
        ;;

    install)
        valid_credential "$credential_file" || {
            echo "Standalone OmniRoute credential is missing or invalid." >&2
            exit 1
        }
        owner_only_file "$credential_file" || {
            echo "Standalone OmniRoute credential must be owner-only." >&2
            exit 1
        }
        if [[ -e "$opencode_auth_file" ]]; then
            [[ -f "$opencode_auth_file" && ! -L "$opencode_auth_file" ]] || {
                echo "OpenCode authentication target is unsafe." >&2
                exit 1
            }
            owner_only_file "$opencode_auth_file" || {
                echo "OpenCode authentication file must be owner-only." >&2
                exit 1
            }
            jq -e 'type == "object"' "$opencode_auth_file" >/dev/null 2>&1 || {
                echo "OpenCode authentication file is not a JSON object." >&2
                exit 1
            }
            if valid_installed_auth "$opencode_auth_file"; then
                if jq -e --slurpfile credential "$credential_file" '.omniroute == $credential[0]' "$opencode_auth_file" >/dev/null; then
                    echo "OpenCode OmniRoute credential is already installed."
                    exit 0
                fi
                if [[ "$FORCE" != true ]]; then
                    echo "Preserved existing OpenCode OmniRoute credential."
                    exit 0
                fi
            fi
        fi
        safe_parent "$opencode_auth_file" || {
            echo "OpenCode authentication parent is unsafe." >&2
            exit 1
        }
        tmp="$(mktemp "$(dirname "$opencode_auth_file")/.auth.XXXXXX")"
        trap 'rm -f -- "${tmp:-}"' EXIT
        if [[ -f "$opencode_auth_file" ]]; then
            jq --slurpfile credential "$credential_file" '.omniroute = $credential[0]' "$opencode_auth_file" >"$tmp"
        else
            jq -n --slurpfile credential "$credential_file" '{omniroute:$credential[0]}' >"$tmp"
        fi
        chmod 0600 "$tmp"
        valid_installed_auth "$tmp" || {
            echo "Generated OpenCode authentication file failed validation." >&2
            exit 1
        }
        mv -f -- "$tmp" "$opencode_auth_file"
        trap - EXIT
        echo "Installed the Opensoft OmniRoute provider record for OpenCode."
        ;;
esac
