def is_usable_skill_tree(path: Path) -> bool:
    root_mode = mode_without_following(path)
    if root_mode is None or not stat.S_ISDIR(root_mode):
        return False
    skill_mode = mode_without_following(path / "SKILL.md")
    return skill_mode is not None and stat.S_ISREG(skill_mode)


def skill_tree_will_be_usable(path: Path, force: bool) -> bool:
    root_mode = mode_without_following(path)
    if root_mode is None:
        return True
    if not stat.S_ISDIR(root_mode):
        return force
    skill_mode = mode_without_following(path / "SKILL.md")
    return skill_mode is None or stat.S_ISREG(skill_mode) or force


def has_compatible_worktree_git_overlay(repo: Path) -> bool:
    overlay_root = repo / ".specify" / "extensions" / "git"
    contents: dict[str, str] = {}
    try:
        for relative_path in WORKTREE_GIT_OVERLAY_REQUIRED_FILES:
            content = read_destination_text(overlay_root / relative_path)
            if content is None:
                return False
            contents[relative_path] = content
    except (OSError, UnicodeError):
        return False

    return LOAD_GIT_WORKTREES_DEFINITION.search(
        contents["scripts/bash/git-common.sh"]
    ) is not None


def can_write_path_or_parent(path: Path) -> bool:
    if path.exists():
        return os.access(path, os.W_OK)
    parent = path.parent
    while not parent.exists() and parent != parent.parent:
        parent = parent.parent
    return os.access(parent, os.W_OK)


def global_agent_entrypoint(agent_root: Path) -> str:
    return f"""# Global Agent Instructions

This file is the user-level entrypoint for shared agent workflow rules across
Codex, Claude, opencode, and other local coding agents. Repository files such as
`AGENTS.md`, `CLAUDE.md`, `openspec/README.md`, and `.specify/README.md` should
point here instead of duplicating global process instructions.

## OpenSpec + Speckit

Read the shared protocol before creating or implementing governed features:

- `{agent_root / "protocols" / "openspec-speckit-workflow.md"}`
- `{agent_root / "protocols" / "project-agent-bootstrap.md"}`

Core rule:

- OpenSpec is the change-governance layer.
- Speckit is the implementation layer.
- Use OpenSpec before implementation when the work changes product,
  architecture, artifact contracts, runtime/model orchestration, routing/review
  policy, edge constraints, or the development workflow.
- Use Speckit for the implementation feature branch/worktree and its
  specify/clarify/plan/tasks/analyze/implement lifecycle.
- Do not duplicate task lists: OpenSpec records governance and handoff; Speckit
  owns implementation tasks.

## Repository Overrides

Repo-local instructions remain authoritative for project-specific details such
as package commands, runtime prerequisites, test commands, source-of-truth docs,
and deployment constraints.
"""


def openspec_speckit_protocol(agent_root: Path) -> str:
    return f"""# OpenSpec and Speckit Shared Workflow

This protocol is the shared source of truth for using OpenSpec and Speckit
together across local coding agents. Repo-local files should reference this file
instead of copying the same process text into each project.

## Authority

Repo-local instructions remain authoritative for product facts, package
commands, runtime prerequisites, source-of-truth docs, test commands, deployment
constraints, and repo-specific safety rules.

This global protocol is authoritative for common OpenSpec/Speckit mechanics
unless a repo-local file explicitly marks a narrower override for that repo.

## Tool Roles

OpenSpec is the change-governance layer. It captures intent, scope, design
decisions, spec deltas, and approval state before non-trivial implementation.

Speckit is the implementation layer. It owns the feature branch/worktree,
`spec.md`, `plan.md`, design artifacts, `tasks.md`, analysis, implementation,
and verification.

Do not duplicate task lists between the two systems. OpenSpec records the
governed decision and handoff. Speckit owns executable implementation tasks.

## When To Use OpenSpec

Create or update an OpenSpec change before implementation when the work changes
product behavior, architecture, artifact contracts, runtime/model orchestration,
routing/review policy, edge constraints, or development workflow rules.

Skip OpenSpec for small implementation-only fixes where an existing Speckit
feature already defines the behavior and no product, architecture, or governance
decision is being made.

## Lifecycle

1. OpenSpec proposal or exploration captures the decision.
2. OpenSpec apply work keeps proposal, design notes, and spec deltas current.
3. The OpenSpec change hands off to exactly one Speckit feature under
   `specs/NNN-*`.
4. Speckit creates or updates the implementation worktree and artifacts.
5. Implementation happens from the Speckit feature worktree.
6. Review and verification happen on the implementation branch or PR.
7. Archive the OpenSpec change only after the corresponding Speckit work and PR
   have landed, or after the change is explicitly abandoned.

For shipped-feature amendments, do not silently rewrite history. Capture the
new interpretation as an OpenSpec change first, then update docs/specs/code
through the normal handoff.

## Worktree Rules

Run `/speckit.specify` only from the root checkout on the repo base branch
unless the repo explicitly documents a different creation path.

Before running `/speckit.specify`, verify from the same shell/container:

```bash
git status -sb
git branch --show-current
```

If the root checkout is not on the intended base branch or has unintended dirty
work, stop and preserve or commit that work before creating a new Speckit
feature.

Do not pre-create agent-prefixed branches for Speckit features. Let Speckit's
feature/worktree hook create the canonical `NNN-feature-name` branch/worktree.

After `/speckit.specify` creates a worktree, run follow-on Speckit commands from
that generated worktree, not from the root checkout:

- `/speckit.clarify`
- `/speckit.checklist`
- `/speckit.plan`
- `/speckit.tasks`
- `/speckit.analyze`
- `/speckit.implement`

If a requested follow-on command targets a worktree that does not exist, stop
and report that. Do not silently fall back to the root checkout.

## Speckit Clarify Rules

When running or prompting `/speckit.clarify`, use a maximum of **25** accepted
clarification questions per clarify round, not the vanilla Spec Kit default of
5. This override applies to Codex skill-driven clarify work, Claude
slash-command prompts, and handoff prompts written for another agent.
Ask one question at a time and stop earlier when all material ambiguities are
resolved.

Clarification answers must be recorded inline in the feature's clarification
file when one exists, such as `clarify-questions.md`, and must also be applied
directly to the relevant sections of `spec.md`. Do not create a separate
answers file unless the user explicitly asks for one.

See `{agent_root / "AGENTS.md"}` for the user-level entrypoint.
"""


