    return template_root, command_template_root


def default_base_branch(repo: Path) -> str:
    for ref in ["refs/heads/main", "refs/remotes/origin/main"]:
        if subprocess.run(
            ["git", "-C", str(repo), "show-ref", "--verify", "--quiet", ref],
            check=False,
        ).returncode == 0:
            return "main"

    result = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--abbrev-ref", "HEAD"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    branch = result.stdout.strip()
    if result.returncode == 0 and branch and branch != "HEAD":
        return branch
    return "main"


def set_top_level_yml_values(path: Path, values: dict[str, str], dry_run: bool) -> None:
    ensure_safe_destination_file(path, set())
    existing_text = read_destination_text(path)
    if existing_text is None:
        lines = [
            "# Git Branching Workflow Extension Configuration",
            "# Managed by setup-openspeckit. Rerun after Speckit upgrades.",
            "",
            "# Branch numbering strategy: \"sequential\" (001, 002, ...) or \"timestamp\" (YYYYMMDD-HHMMSS)",
            "branch_numbering: sequential",
            "",
            "# Feature checkout strategy: \"branch\" keeps work in the current checkout,",
            "# \"worktree\" creates a sibling worktree rooted from base_branch.",
            "checkout_mode: worktree",
            "",
            "# Base branch for new worktree-backed features. Ignored in branch mode.",
            "base_branch: main",
            "",
            "# Parent directory for linked worktrees. Relative paths resolve from the repo root.",
            "worktree_root: ../example-worktrees",
            "",
            "# Auto-commit before/after core commands. Disabled by default.",
            "auto_commit:",
            "  default: false",
        ]
    else:
        lines = existing_text.splitlines()

    seen: set[str] = set()
    updated: list[str] = []
    for line in lines:
        stripped = line.lstrip()
        indent = len(line) - len(stripped)
        replaced = False
        if indent == 0 and ":" in stripped:
            key = stripped.split(":", 1)[0].strip()
            if key in values:
                updated.append(f"{key}: {values[key]}")
                seen.add(key)
                replaced = True
        if not replaced:
            updated.append(line)

    missing = [key for key in values if key not in seen]
    if missing:
        insertion = [f"{key}: {values[key]}" for key in missing]
        if updated and updated[-1].strip():
            updated.append("")
        updated.extend(insertion)

    write_text(path, "\n".join(updated) + "\n", dry_run)


def ensure_extensions_hook(repo: Path, dry_run: bool) -> None:
    path = repo / ".specify" / "extensions.yml"
    ensure_safe_destination_file(path, set())
    hook_text = "speckit.git.feature"
    existing_text = read_destination_text(path)
    if existing_text is not None and hook_text in existing_text:
        log(f"unchanged {path}")
        return

    if existing_text is None:
        lines = [
            "installed:",
            "- git",
            "settings:",
            "  auto_execute_hooks: true",
            "hooks:",
        ]
    else:
        lines = existing_text.splitlines()

    hook = [
        "- extension: git",
        "  command: speckit.git.feature",
        "  enabled: true",
        "  optional: false",
        "  prompt: Execute speckit.git.feature?",
        "  description: Create feature checkout before specification",
        "  condition: null",
    ]

    for index, line in enumerate(lines):
        if line.strip() == "before_specify:":
            child_indent = line[: len(line) - len(line.lstrip(" "))] + "  "
            lines[index + 1 : index + 1] = [child_indent + item for item in hook]
            write_text(path, "\n".join(lines) + "\n", dry_run)
            return

    for index, line in enumerate(lines):
        if line.strip() == "hooks:":
            child_indent = line[: len(line) - len(line.lstrip(" "))] + "  "
            lines[index + 1 : index + 1] = (
                [child_indent + "before_specify:"]
                + [child_indent + "  " + item for item in hook]
            )
            write_text(path, "\n".join(lines) + "\n", dry_run)
            return

    if lines and lines[-1].strip():
        lines.append("")
    lines.extend(["hooks:", "  before_specify:"] + ["    " + item for item in hook])
    write_text(path, "\n".join(lines) + "\n", dry_run)


def refresh_git_extension_manifest_hash(
    repo: Path,
    manifest: Path,
    dry_run: bool,
) -> None:
    registry_path = repo / ".specify" / "extensions" / ".registry"
    ensure_safe_destination_file(registry_path, set())
    registry = read_json(registry_path)
    extensions = registry.get("extensions")
    if not isinstance(extensions, dict):
        return
    git_extension = extensions.get("git")
    if not isinstance(git_extension, dict):
        return

    manifest_content = read_destination_bytes(manifest)
    if manifest_content is None:
        return

    manifest_hash = f"sha256:{hashlib.sha256(manifest_content).hexdigest()}"
    if git_extension.get("manifest_hash") == manifest_hash:
        log(f"unchanged Git extension manifest hash in {registry_path}")
        return
    git_extension["manifest_hash"] = manifest_hash
    write_text(registry_path, json.dumps(registry, indent=2) + "\n", dry_run)


def ensure_worktree_overlay(
    repo: Path,
    template_root: Path | None,
    dry_run: bool,
    force: bool,
    base_branch: str | None,
    worktree_root: str | None,
    skip_worktrees: bool,
) -> set[Path]:
    if skip_worktrees:
        return set()

    if template_root is None:
        raise SystemExit("Speckit worktree template root not found.")

    git_overlay_force = force or not has_compatible_worktree_git_overlay(repo)
    if git_overlay_force and not force:
        log("replacing incompatible Spec Kit git extension with worktree-aware overlay")

    copy_overlay_tree(template_root / "specify" / "extensions" / "git", repo / ".specify" / "extensions" / "git", dry_run, git_overlay_force)
    copy_overlay_tree(template_root / "specify" / "shell", repo / ".specify" / "shell", dry_run, force)
    skill_overlays = (
        (
            template_root / "agents" / "skills" / "speckit-specify",
            repo / ".agents" / "skills" / "speckit-specify",
        ),
        (
            template_root / "agents" / "skills" / "speckit-git-feature",
            repo / ".agents" / "skills" / "speckit-git-feature",
        ),
        (
            template_root / "agents" / "skills" / "speckit-git-validate",
            repo / ".agents" / "skills" / "speckit-git-validate",
        ),
        (
            template_root / "claude" / "skills" / "speckit-specify",
            repo / ".claude" / "skills" / "speckit-specify",
        ),
        (
            template_root / "claude" / "skills" / "speckit-git-feature",
            repo / ".claude" / "skills" / "speckit-git-feature",
        ),
        (
            template_root / "claude" / "skills" / "speckit-git-validate",
            repo / ".claude" / "skills" / "speckit-git-validate",
        ),
        (
            template_root / "codex" / "skills" / "speckit-specify",
            repo / ".codex" / "skills" / "speckit-specify",
        ),
        (
            template_root / "codex" / "skills" / "speckit-git-feature",
            repo / ".codex" / "skills" / "speckit-git-feature",
        ),
        (
            template_root / "codex" / "skills" / "speckit-git-validate",
            repo / ".codex" / "skills" / "speckit-git-validate",
        ),
    )
    overlay_owned_destinations: set[Path] = set()
    for source, destination in skill_overlays:
        safe_source_tree_entries(source)
        if not is_usable_skill_tree(source):
            log(f"skipped unusable worktree skill overlay {source}")
            continue
        copy_overlay_tree(source, destination, dry_run, force)
        if is_usable_skill_tree(destination) or (
            dry_run and skill_tree_will_be_usable(destination, force)
        ):
            overlay_owned_destinations.add(destination)

    config_path = repo / ".specify" / "extensions" / "git" / "git-config.yml"
    existing_config = read_destination_text(config_path)
    existing_keys: set[str] = set()
    if existing_config is not None:
        for line in existing_config.splitlines():
            stripped = line.lstrip()
            if len(line) == len(stripped) and ":" in stripped:
                existing_keys.add(stripped.split(":", 1)[0].strip())

    required_values = {
        "branch_numbering": "sequential",
        "checkout_mode": "worktree",
        "base_branch": default_base_branch(repo),
        "worktree_root": f"../{repo.name}-worktrees",
    }
    values = {
        key: value for key, value in required_values.items() if key not in existing_keys
    }
    if base_branch is not None:
        values["base_branch"] = base_branch
    if worktree_root is not None:
        values["worktree_root"] = worktree_root
    set_top_level_yml_values(
        config_path,
        values,
        dry_run,
    )
    ensure_extensions_hook(repo, dry_run)
    installed_manifest = repo / ".specify" / "extensions" / "git" / "extension.yml"
    manifest_to_hash = (
        template_root / "specify" / "extensions" / "git" / "extension.yml"
        if dry_run and (git_overlay_force or not installed_manifest.exists())
        else installed_manifest
    )
    refresh_git_extension_manifest_hash(
        repo,
        manifest_to_hash,
        dry_run,
    )
    return overlay_owned_destinations


def main() -> int:
    args = parse_args()
    repo = (args.repo.resolve() if args.repo else git_root())
    ensure_safe_specify_destination(repo)
    agent_root = Path(os.environ.get("AGENT_PROTOCOL_ROOT", Path.home() / ".agents")).resolve()
    worktree_templates, command_templates = preflight_source_roots(
        agent_root,
        args.no_worktrees,
        args.no_skill_links,
    )
    integration = args.integration or existing_integration(repo) or "claude"

    log(f"repo: {repo}")
    log(f"agent root: {agent_root}")
    log(f"integration: {integration}")

    ensure_agent_protocol_files(agent_root, args.dry_run)
    ensure_scaffold(repo, args.dry_run, args.skip_init)
    ensure_speckit_initialized(repo, integration, args.dry_run, args.skip_init)
    ensure_speckit_registration(repo, args.dry_run, args.no_speckit_registration)
    overlay_owned_destinations = ensure_worktree_overlay(
        repo,
        worktree_templates,
        args.dry_run,
        args.force,
        args.base_branch,
        args.worktree_root,
        args.no_worktrees,
    )

    if not args.no_repo_agent_pointers:
        ensure_repo_agent_pointers(repo, args.dry_run)

    if not args.preserve_readmes:
        write_text(repo / "openspec" / "README.md", openspec_readme(), args.dry_run)
        write_text(repo / ".specify" / "README.md", specify_readme(), args.dry_run)

    if command_templates:
        copy_missing_tree(
            command_templates,
            repo / ".claude" / "commands" / "opsx",
            args.dry_run,
            args.force,
        )
    else:
        log("skipped opsx command templates: no template root found")

    if not args.no_skill_links:
        ensure_skills(repo, args.dry_run, args.force, overlay_owned_destinations)

    if not args.no_global_agent_pointers:
        ensure_global_agent_pointers(agent_root, args.dry_run)

    log("done")
    return 0


if __name__ == "__main__":
    sys.exit(main())
