def link_or_copy_skill(src: Path, dst: Path, dry_run: bool, force: bool) -> None:
    entries = safe_source_tree_entries(src)
    if not src.exists():
        return
    if dry_run:
        ensure_safe_destination_parent(dst, set())
        destination_mode = mode_without_following(dst)
        if destination_mode is not None and not stat.S_ISLNK(destination_mode):
            if not force:
                log(f"kept existing {dst}")
                return
            if stat.S_ISDIR(destination_mode):
                ensure_safe_destination_tree(dst)
        action = "replace" if destination_mode is not None else "copy"
        log(f"would {action} {dst} with copied directory from {src}")
        return
    with destination_tree_parent(dst, True) as destination_parent_descriptor:
        destination_mode = mode_at(destination_parent_descriptor, dst.name)
        if destination_mode is not None and not stat.S_ISLNK(destination_mode):
            if not force:
                log(f"kept existing {dst}")
                return
            if stat.S_ISDIR(destination_mode):
                ensure_safe_destination_tree(dst)
        if destination_mode is not None:
            remove_entry_at(destination_parent_descriptor, dst.name)
        os.mkdir(dst.name, mode=0o755, dir_fd=destination_parent_descriptor)
        root_descriptor = os.open(
            dst.name,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=destination_parent_descriptor,
        )
        with managed_descriptor(root_descriptor):
            os.fchmod(root_descriptor, 0o755)
            for source in (
                entry for entry in entries if stat.S_ISDIR(entry.mode)
            ):
                ensure_relative_directory(
                    root_descriptor,
                    source.path.relative_to(src).parts,
                    False,
                )
            for source in (
                entry for entry in entries if not stat.S_ISDIR(entry.mode)
            ):
                relative_parts = source.path.relative_to(src).parts
                with relative_directory_descriptor(
                    root_descriptor,
                    relative_parts[:-1],
                ) as parent_descriptor:
                    copy_regular_file_at(source, parent_descriptor, relative_parts[-1])
            if dst.name == "speckit-clarify":
                skill_mode = mode_at(root_descriptor, "SKILL.md")
                if skill_mode is not None and stat.S_ISREG(skill_mode):
                    text = read_regular_text_at(root_descriptor, "SKILL.md")
                    for old, new in CLARIFY_QUOTA_REPLACEMENTS:
                        text = text.replace(old, new)
                    if "one question at a time" not in text.lower():
                        text += "\n## Shared Clarify Contract\n\nAsk one question at a time.\n"
                    publish_text_at(root_descriptor, "SKILL.md", text, 0o644)
    log(f"copied {src} -> {dst}")


def openspec_skill_wrapper(skill: str, action: str, command_path: str) -> str:
    return f"""---
name: {skill}
description: Delegate to the governed OPSX {action} source workflow
---

# Governed OPSX Delegate

The canonical command at [`{command_path}`]({command_path}) is the source workflow.
Load that command and follow it exactly; do not recreate or summarize its procedure here.

Do not execute implementation tasks from OpenSpec artifacts. OpenSpec records
governance and handoff only; the linked Speckit `specs/<feature>/tasks.md` owns
executable implementation work.
"""


def ensure_openspec_skill_wrapper(
    repo: Path,
    agent_dir: str,
    skill: str,
    action: str,
    dry_run: bool,
    force: bool,
) -> None:
    destination = repo / agent_dir / "skills" / skill
    command_path = (
        f"../../commands/opsx/{action}.md"
        if agent_dir == ".claude"
        else f"../../../.claude/commands/opsx/{action}.md"
    )
    wrapper = openspec_skill_wrapper(skill, action, command_path)
    if dry_run:
        ensure_safe_destination_parent(destination, set())
        destination_mode = mode_without_following(destination)
        skill_file = destination / "SKILL.md"
        skill_mode = (
            mode_without_following(skill_file)
            if destination_mode is not None and stat.S_ISDIR(destination_mode)
            else None
        )
        is_current = (
            destination_mode is not None
            and stat.S_ISDIR(destination_mode)
            and sorted(path.name for path in destination.iterdir()) == ["SKILL.md"]
            and skill_mode is not None
            and stat.S_ISREG(skill_mode)
            and skill_file.read_text(encoding="utf-8") == wrapper
            and destination_mode & 0o777 == 0o755
            and skill_mode & 0o777 == 0o644
        )
        if is_current:
            log(f"unchanged {destination}")
            return
        if destination_mode is not None and not force:
            log(f"kept existing {destination}")
            return
        log(f"would write governed OpenSpec wrapper {destination}")
        return
    with destination_tree_parent(destination, True) as parent_descriptor:
        destination_mode = mode_at(parent_descriptor, destination.name)
        is_current = False
        if destination_mode is not None and stat.S_ISDIR(destination_mode):
            destination_descriptor = os.open(
                destination.name,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=parent_descriptor,
            )
            with managed_descriptor(destination_descriptor):
                skill_mode = mode_at(destination_descriptor, "SKILL.md")
                is_current = (
                    sorted(os.listdir(destination_descriptor)) == ["SKILL.md"]
                    and skill_mode is not None
                    and stat.S_ISREG(skill_mode)
                    and read_regular_text_at(destination_descriptor, "SKILL.md") == wrapper
                    and destination_mode & 0o777 == 0o755
                    and skill_mode & 0o777 == 0o644
                )
        if is_current:
            log(f"unchanged {destination}")
            return
        if destination_mode is not None and not force:
            log(f"kept existing {destination}")
            return
        remove_entry_at(parent_descriptor, destination.name)
        os.mkdir(destination.name, mode=0o755, dir_fd=parent_descriptor)
        destination_descriptor = os.open(
            destination.name,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=parent_descriptor,
        )
        with managed_descriptor(destination_descriptor):
            os.fchmod(destination_descriptor, 0o755)
            publish_text_at(destination_descriptor, "SKILL.md", wrapper, 0o644)
    log(f"wrote governed OpenSpec wrapper {destination}")


