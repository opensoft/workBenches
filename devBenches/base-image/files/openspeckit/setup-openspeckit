def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Prepare a repo for the shared OpenSpec/Speckit agent workflow."
    )
    parser.add_argument("--repo", type=Path, help="Repository root. Defaults to git root.")
    parser.add_argument("--dry-run", action="store_true", help="Print planned changes only.")
    parser.add_argument("--force", action="store_true", help="Overwrite existing copied helpers.")
    parser.add_argument(
        "--preserve-readmes",
        action="store_true",
        help="Do not rewrite openspec/README.md or .specify/README.md.",
    )
    parser.add_argument(
        "--skip-init",
        action="store_true",
        help="Do not create optional scaffolding or run specify init; openspec/config.yaml is still ensured.",
    )
    parser.add_argument(
        "--integration",
        help="Spec Kit integration to install when initialization is needed. Defaults to existing integration or claude.",
    )
    parser.add_argument(
        "--no-speckit-registration",
        action="store_true",
        help="Do not register the Spec Kit git extension or bundled speckit workflow.",
    )
    parser.add_argument(
        "--no-worktrees",
        action="store_true",
        help="Do not install the Speckit worktree overlay.",
    )
    parser.add_argument(
        "--base-branch",
        help="Base branch for new Speckit worktrees. Defaults to main when present, otherwise current branch.",
    )
    parser.add_argument(
        "--worktree-root",
        help="Worktree parent path, relative to repo root unless absolute. Defaults to ../<repo-name>-worktrees.",
    )
    parser.add_argument(
        "--no-skill-links",
        action="store_true",
        help="Do not link global skills into repo-local agent folders.",
    )
    parser.add_argument(
        "--no-global-agent-pointers",
        action="store_true",
        help="Do not update user-global agent entrypoint files.",
    )
    parser.add_argument(
        "--no-repo-agent-pointers",
        action="store_true",
        help="Do not update repo-local context files for supported agents.",
    )
    return parser.parse_args()


def log(message: str) -> None:
    print(message)


def run_command(command: list[str], cwd: Path, dry_run: bool) -> None:
    """Run a trusted external command whose internal writes cannot share our descriptors."""
    printable = " ".join(shlex_quote(part) for part in command)
    if dry_run:
        log(f"would run ({cwd}): {printable}")
        return
    log(f"running ({cwd}): {printable}")
    subprocess.run(command, cwd=cwd, check=True)


def shlex_quote(value: str) -> str:
    if not value:
        return "''"
    safe = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_+-=.,/:@%"
    if all(char in safe for char in value):
        return value
    return "'" + value.replace("'", "'\"'\"'") + "'"


def git_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit(
            "Could not determine repo root. Run inside a git repo or pass --repo."
        ) from exc
    return Path(result.stdout.strip()).resolve()


def read_json(path: Path) -> dict[str, object]:
    try:
        text = read_destination_text(path)
        return json.loads(text) if text is not None else {}
    except json.JSONDecodeError:
        return {}


def existing_integration(repo: Path) -> str | None:
    integration_state = read_json(repo / ".specify" / "integration.json")
    value = integration_state.get("integration") or integration_state.get("default_integration")
    if isinstance(value, str) and value:
        return value

    init_options = read_json(repo / ".specify" / "init-options.json")
    value = init_options.get("integration") or init_options.get("ai")
    if isinstance(value, str) and value:
        return value

    return None


def needs_speckit_init(repo: Path) -> bool:
    required = [
        repo / ".specify" / "init-options.json",
        repo / ".specify" / "integration.json",
        repo / ".specify" / "templates" / "spec-template.md",
    ]
    return any(not path.exists() for path in required)


def ensure_speckit_initialized(
    repo: Path,
    integration: str,
    dry_run: bool,
    skip_init: bool,
) -> None:
    if skip_init or not needs_speckit_init(repo):
        return

    command = [
        "specify",
        "init",
        "--here",
        "--force",
        "--integration",
        integration,
        "--script",
        "sh",
        "--ignore-agent-tools",
    ]
    expected_outputs = {Path(".specify")}
    expected_outputs.update(
        Path(relative_path)
        for agent, relative_path in SUPPORTED_AGENT_CONTEXT_FILES
        if agent == integration
    )
    tool_root = SPECIFY_INTEGRATION_TOOL_ROOTS.get(integration)
    if tool_root is not None:
        expected_outputs.add(Path(tool_root))
    run_specify_commands(repo, [command], dry_run, expected_outputs)


def git_extension_registered(repo: Path) -> bool:
    registry = read_json(repo / ".specify" / "extensions" / ".registry")
    extensions = registry.get("extensions")
    if not isinstance(extensions, dict):
        return False
    git_extension = extensions.get("git")
    return isinstance(git_extension, dict) and git_extension.get("enabled") is True


def speckit_workflow_registered(repo: Path) -> bool:
    registry = read_json(repo / ".specify" / "workflows" / "workflow-registry.json")
    workflows = registry.get("workflows")
    return isinstance(workflows, dict) and "speckit" in workflows


def ensure_safe_specify_destination(repo: Path) -> None:
    specify_root = repo / ".specify"
    ensure_safe_destination_file(specify_root, set())
    ensure_safe_destination_tree(specify_root)


def ensure_speckit_registration(repo: Path, dry_run: bool, skip_registration: bool) -> None:
    if skip_registration:
        return
    ensure_safe_specify_destination(repo)
    commands: list[list[str]] = []
    if not git_extension_registered(repo):
        commands.append(["specify", "extension", "add", "git"])
    else:
        log("unchanged Speckit git extension registration")
    if not speckit_workflow_registered(repo):
        commands.append(["specify", "workflow", "add", "speckit"])
    else:
        log("unchanged Speckit workflow registration")
    run_specify_commands(repo, commands, dry_run)


@contextmanager
def managed_descriptor(descriptor: int) -> Iterator[int]:
    try:
        yield descriptor
    finally:
        os.close(descriptor)


@contextmanager
def directory_descriptor(path: Path, create: bool = False) -> Iterator[int]:
    absolute_path = Path(os.path.abspath(path))
    with ExitStack() as descriptors:
        descriptor = descriptors.enter_context(
            managed_descriptor(os.open(absolute_path.anchor, DIRECTORY_OPEN_FLAGS))
        )
        for component in absolute_path.relative_to(absolute_path.anchor).parts:
            created = False
            try:
                child_descriptor = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=descriptor,
                )
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(component, mode=0o755, dir_fd=descriptor)
                created = True
                child_descriptor = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=descriptor,
                )
            if created:
                os.fchmod(child_descriptor, 0o755)
            descriptor = descriptors.enter_context(managed_descriptor(child_descriptor))
        yield descriptor


@contextmanager
def destination_file_parent(path: Path, create: bool) -> Iterator[int]:
    with ExitStack() as descriptors:
        try:
            descriptor = descriptors.enter_context(
                directory_descriptor(path.parent, create)
            )
        except NotADirectoryError:
            ensure_safe_destination_file(path, set())
            raise
        ensure_safe_destination_file(path, set())
        yield descriptor


@contextmanager
def destination_tree_parent(path: Path, create: bool) -> Iterator[int]:
    with ExitStack() as descriptors:
        try:
            descriptor = descriptors.enter_context(
                directory_descriptor(path.parent, create)
            )
        except NotADirectoryError:
            ensure_safe_destination_parent(path, set())
            raise
        ensure_safe_destination_parent(path, set())
        yield descriptor


def mode_at(parent_descriptor: int, name: str) -> int | None:
    try:
        return os.stat(
            name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        ).st_mode
    except FileNotFoundError:
        return None


def read_regular_text_at(parent_descriptor: int, name: str) -> str:
    descriptor = os.open(
        name,
        REGULAR_FILE_OPEN_FLAGS,
        dir_fd=parent_descriptor,
    )
    with os.fdopen(descriptor, encoding="utf-8") as file:
        if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
            raise OSError(f"Refusing to read non-regular destination file {name}")
        return file.read()


def read_regular_bytes_at(parent_descriptor: int, name: str) -> bytes:
    descriptor = os.open(
        name,
        REGULAR_FILE_OPEN_FLAGS,
        dir_fd=parent_descriptor,
    )
    with os.fdopen(descriptor, "rb") as file:
        if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
            raise OSError(f"Refusing to read non-regular destination file {name}")
        return file.read()


def temporary_regular_file(parent_descriptor: int, name: str) -> tuple[str, int]:
    while True:
        temporary_name = f".{name}.tmp-{secrets.token_hex(8)}"
        try:
            descriptor = os.open(
                temporary_name,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=parent_descriptor,
            )
        except FileExistsError:
            continue
        os.fchmod(descriptor, 0o600)
        return temporary_name, descriptor


def write_all(descriptor: int, content: bytes) -> None:
    remaining = memoryview(content)
    while remaining:
        written = os.write(descriptor, remaining)
        remaining = remaining[written:]


def publish_text_at(
    parent_descriptor: int,
    name: str,
    text: str,
    mode: int | None,
) -> None:
    temporary_name, descriptor = temporary_regular_file(parent_descriptor, name)
    try:
        with os.fdopen(descriptor, "wb") as file:
            write_all(file.fileno(), text.encode("utf-8"))
            if mode is not None:
                os.fchmod(file.fileno(), mode)
        os.replace(
            temporary_name,
            name,
            src_dir_fd=parent_descriptor,
            dst_dir_fd=parent_descriptor,
        )
    finally:
        try:
            os.unlink(temporary_name, dir_fd=parent_descriptor)
        except FileNotFoundError:
            pass


def read_destination_text(path: Path) -> str | None:
    try:
        with destination_file_parent(path, False) as parent_descriptor:
            if mode_at(parent_descriptor, path.name) is None:
                return None
            return read_regular_text_at(parent_descriptor, path.name)
    except FileNotFoundError:
        ensure_safe_destination_file(path, set())
        return None


def destination_mode(path: Path) -> int | None:
    try:
        with destination_file_parent(path, False) as parent_descriptor:
            return mode_at(parent_descriptor, path.name)
    except FileNotFoundError:
        ensure_safe_destination_file(path, set())
        return None


def read_destination_bytes(path: Path) -> bytes | None:
    try:
        with destination_file_parent(path, False) as parent_descriptor:
            if mode_at(parent_descriptor, path.name) is None:
                return None
            return read_regular_bytes_at(parent_descriptor, path.name)
    except FileNotFoundError:
        ensure_safe_destination_file(path, set())
        return None


def write_text(path: Path, text: str, dry_run: bool) -> None:
    if dry_run:
        if read_destination_text(path) == text:
            log(f"unchanged {path}")
            return
        log(f"would write {path}")
        return
    with destination_file_parent(path, True) as parent_descriptor:
        destination_mode = mode_at(parent_descriptor, path.name)
        if destination_mode is not None:
            if read_regular_text_at(parent_descriptor, path.name) == text:
                log(f"unchanged {path}")
                return
            file_mode = stat.S_IMODE(destination_mode)
        else:
            file_mode = 0o644
        publish_text_at(parent_descriptor, path.name, text, file_mode)
    log(f"wrote {path}")


def write_text_if_missing(path: Path, text: str, dry_run: bool) -> None:
    if dry_run:
        if destination_mode(path) is not None:
            log(f"kept existing {path}")
            return
        log(f"would write {path}")
        return
    with destination_file_parent(path, True) as parent_descriptor:
        if mode_at(parent_descriptor, path.name) is not None:
            log(f"kept existing {path}")
            return
        publish_text_at(parent_descriptor, path.name, text, 0o644)
    log(f"wrote {path}")


def touch(path: Path, dry_run: bool) -> None:
    if dry_run:
        if destination_mode(path) is not None:
            return
        log(f"would create {path}")
        return
    with destination_file_parent(path, True) as parent_descriptor:
        if mode_at(parent_descriptor, path.name) is not None:
            return
        descriptor = os.open(
            path.name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0),
            0o666,
            dir_fd=parent_descriptor,
        )
        with managed_descriptor(descriptor):
            os.fchmod(descriptor, 0o644)
    log(f"created {path}")


def ensure_destination_directory(path: Path) -> None:
    with destination_tree_parent(path, True) as parent_descriptor:
        mode = mode_at(parent_descriptor, path.name)
        if mode is None:
            os.mkdir(path.name, mode=0o755, dir_fd=parent_descriptor)
            descriptor = os.open(
                path.name,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=parent_descriptor,
            )
            with managed_descriptor(descriptor):
                os.fchmod(descriptor, 0o755)
        elif not stat.S_ISDIR(mode):
            raise FileExistsError(path)


def upsert_block(path: Path, block_body: str, dry_run: bool) -> None:
    ensure_safe_destination_file(path, set())
    block = f"{START}\n{block_body.rstrip()}\n{END}\n"
    existing_text = read_destination_text(path)
    text = "# Agent Instructions\n\n" if existing_text is None else existing_text

    if START in text and END in text:
        before, remainder = text.split(START, 1)
        _, after = remainder.split(END, 1)
        after = after.lstrip("\n")
        separator = "\n" if after else ""
        new_text = before.rstrip() + "\n\n" + block + separator + after
    else:
        if text.startswith("## "):
            new_text = block + "\n" + text
        else:
            marker = "\n## "
            index = text.find(marker)
            if index == -1:
                new_text = text.rstrip() + "\n\n" + block
            else:
                # index points at the newline before the first section heading.
                new_text = text[:index].rstrip() + "\n\n" + block + "\n" + text[index + 1 :]

    write_text(path, new_text, dry_run)


def safe_source_tree_entries(src: Path) -> list[SourceTreeEntry]:
    source_mode = mode_without_following(src)
    if source_mode is None:
        return []
    if stat.S_ISLNK(source_mode):
        raise SystemExit(
            f"Refusing to copy unsafe source tree {src}: symlink found at {src}"
        )
    if not stat.S_ISDIR(source_mode):
        raise SystemExit(
            f"Refusing to copy unsafe source tree {src}: source root is not a directory"
        )
    entries: list[SourceTreeEntry] = []
    for entry in sorted(src.rglob("*")):
        entry_stat = entry.lstat()
        entry_mode = entry_stat.st_mode
        if stat.S_ISLNK(entry_mode):
            raise SystemExit(
                f"Refusing to copy unsafe source tree {src}: symlink found at {entry}"
            )
        if not stat.S_ISDIR(entry_mode) and not stat.S_ISREG(entry_mode):
            raise SystemExit(
                f"Refusing to copy unsafe source tree {src}: non-regular entry at {entry}"
            )
        entries.append(
            SourceTreeEntry(
                path=entry,
                mode=entry_mode,
                device=entry_stat.st_dev,
                inode=entry_stat.st_ino,
            )
        )
    return entries


def normalized_regular_file_mode(source: Path, source_mode: int) -> int:
    if source.suffix.lower() in {".json", ".md", ".yaml", ".yml"}:
        return 0o644
    return 0o755 if source_mode & 0o111 else 0o644


def mode_without_following(path: Path) -> int | None:
    try:
        return path.lstat().st_mode
    except FileNotFoundError:
        return None


def mode_after_directory_replacements(
    path: Path, directories_to_replace: set[Path]
) -> int | None:
    if any(directory in path.parents for directory in directories_to_replace):
        return None
    return mode_without_following(path)


def ensure_safe_destination_parent(path: Path, safe_directories: set[Path]) -> None:
    current = path.parent
    while current not in safe_directories:
        mode = mode_without_following(current)
        if mode is not None:
            if stat.S_ISLNK(mode):
                raise SystemExit(
                    f"Refusing unsafe destination path {path}: symlink parent at {current}"
                )
            if not stat.S_ISDIR(mode):
                raise SystemExit(
                    f"Refusing unsafe destination path {path}: non-directory parent at {current}"
                )
        if current.parent == current:
            return
        current = current.parent


def ensure_safe_destination_file(path: Path, safe_directories: set[Path]) -> None:
    ensure_safe_destination_parent(path, safe_directories)
    mode = mode_without_following(path)
    if mode is not None and stat.S_ISLNK(mode):
        raise SystemExit(f"Refusing unsafe destination path {path}: symlink leaf")


def ensure_safe_destination_tree(path: Path) -> None:
    for entry in sorted(path.rglob("*")):
        if entry.is_symlink():
            raise SystemExit(
                f"Refusing unsafe destination tree {path}: symlink found at {entry}"
            )


def remove_destination_without_following(path: Path) -> None:
    with ExitStack() as descriptors:
        try:
            parent_descriptor = descriptors.enter_context(
                destination_tree_parent(path, False)
            )
        except FileNotFoundError:
            ensure_safe_destination_parent(path, set())
            return
        remove_entry_at(parent_descriptor, path.name)


def remove_entry_at(parent_descriptor: int, name: str) -> None:
    mode = mode_at(parent_descriptor, name)
    if mode is None:
        return
    if stat.S_ISDIR(mode):
        descriptor = os.open(name, DIRECTORY_OPEN_FLAGS, dir_fd=parent_descriptor)
        with managed_descriptor(descriptor):
            for child_name in os.listdir(descriptor):
                remove_entry_at(descriptor, child_name)
        os.rmdir(name, dir_fd=parent_descriptor)
    else:
        os.unlink(name, dir_fd=parent_descriptor)


@contextmanager
def relative_directory_descriptor(
    root_descriptor: int,
    components: tuple[str, ...],
) -> Iterator[int]:
    with ExitStack() as descriptors:
        descriptor = descriptors.enter_context(managed_descriptor(os.dup(root_descriptor)))
        for component in components:
            descriptor = descriptors.enter_context(
                managed_descriptor(
                    os.open(component, DIRECTORY_OPEN_FLAGS, dir_fd=descriptor)
                )
            )
        yield descriptor


def relative_mode(root_descriptor: int, components: tuple[str, ...]) -> int | None:
    if not components:
        return os.fstat(root_descriptor).st_mode
    try:
        with relative_directory_descriptor(
            root_descriptor,
            components[:-1],
        ) as parent_descriptor:
            return mode_at(parent_descriptor, components[-1])
    except FileNotFoundError:
        return None


def ensure_relative_directory(
    root_descriptor: int,
    components: tuple[str, ...],
    replace: bool,
) -> None:
    with ExitStack() as descriptors:
        descriptor = descriptors.enter_context(managed_descriptor(os.dup(root_descriptor)))
        for index, component in enumerate(components):
            mode = mode_at(descriptor, component)
            if mode is not None and not stat.S_ISDIR(mode):
                if not replace or index != len(components) - 1:
                    raise NotADirectoryError(component)
                remove_entry_at(descriptor, component)
                mode = None
            if mode is None:
                os.mkdir(component, mode=0o755, dir_fd=descriptor)
                created = True
            else:
                created = False
            descriptor = descriptors.enter_context(
                managed_descriptor(
                    os.open(component, DIRECTORY_OPEN_FLAGS, dir_fd=descriptor)
                )
            )
            if created:
                os.fchmod(descriptor, 0o755)


def copy_regular_file_at(
    source: SourceTreeEntry,
    parent_descriptor: int,
    name: str,
    destination_mode: int | None = None,
) -> None:
    with directory_descriptor(source.path.parent) as source_parent_descriptor:
        source_descriptor = os.open(
            source.path.name,
            REGULAR_FILE_OPEN_FLAGS,
            dir_fd=source_parent_descriptor,
        )
        with managed_descriptor(source_descriptor):
            source_stat = os.fstat(source_descriptor)
            if (source_stat.st_dev, source_stat.st_ino) != (
                source.device,
                source.inode,
            ):
                raise OSError(f"Refusing substituted source file {source.path}")
            source_mode = source_stat.st_mode
            if not stat.S_ISREG(source_mode):
                raise OSError(f"Refusing to copy non-regular source file {source.path}")
            temporary_name, destination_descriptor = temporary_regular_file(
                parent_descriptor,
                name,
            )
            try:
                with managed_descriptor(destination_descriptor):
                    while True:
                        chunk = os.read(source_descriptor, 1024 * 1024)
                        if not chunk:
                            break
                        write_all(destination_descriptor, chunk)
                    os.fchmod(
                        destination_descriptor,
                        destination_mode
                        if destination_mode is not None
                        else normalized_regular_file_mode(source.path, source_mode),
                    )
                os.replace(
                    temporary_name,
                    name,
                    src_dir_fd=parent_descriptor,
                    dst_dir_fd=parent_descriptor,
                )
            finally:
                try:
                    os.unlink(temporary_name, dir_fd=parent_descriptor)
                except FileNotFoundError:
                    pass


def copy_tree_contents_with_descriptors(
    src: Path,
    dst: Path,
    entries: list[SourceTreeEntry],
    force: bool,
) -> None:
    safe_directories: set[Path] = set()
    blocked_source_directories: set[Path] = set()
    directories_to_create: list[Path] = []
    directories_to_replace: set[Path] = set()

    with destination_tree_parent(dst, True) as destination_parent_descriptor:
        destination_mode = mode_at(destination_parent_descriptor, dst.name)
        root_descriptor: int | None = None
        if destination_mode is None:
            directories_to_create.append(dst)
        elif stat.S_ISLNK(destination_mode):
            raise SystemExit(f"Refusing unsafe destination tree: symlink at {dst}")
        elif stat.S_ISDIR(destination_mode):
            root_descriptor = os.open(
                dst.name,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=destination_parent_descriptor,
            )
        elif force:
            directories_to_replace.add(dst)
            directories_to_create.append(dst)
        else:
            log(f"kept existing {dst}")
            return
        safe_directories.add(dst)

        try:
            for source in (
                entry for entry in entries if stat.S_ISDIR(entry.mode)
            ):
                if any(
                    blocked in source.path.parents
                    for blocked in blocked_source_directories
                ):
                    continue
                target = dst / source.path.relative_to(src)
                ensure_safe_destination_parent(target, safe_directories)
                relative_parts = target.relative_to(dst).parts
                target_mode = (
                    None
                    if root_descriptor is None
                    or any(directory in target.parents for directory in directories_to_replace)
                    else relative_mode(root_descriptor, relative_parts)
                )
                if target_mode is None:
                    directories_to_create.append(target)
                elif stat.S_ISLNK(target_mode):
                    raise SystemExit(
                        f"Refusing unsafe destination tree {dst}: symlink directory at {target}"
                    )
                elif stat.S_ISDIR(target_mode):
                    pass
                elif force:
                    directories_to_replace.add(target)
                    directories_to_create.append(target)
                else:
                    blocked_source_directories.add(source.path)
                    log(f"kept existing {target}")
                    continue
                safe_directories.add(target)

            files_to_copy: list[tuple[SourceTreeEntry, Path]] = []
            files_to_replace: set[Path] = set()
            for source in (
                entry for entry in entries if not stat.S_ISDIR(entry.mode)
            ):
                if any(
                    blocked in source.path.parents
                    for blocked in blocked_source_directories
                ):
                    continue
                target = dst / source.path.relative_to(src)
                ensure_safe_destination_parent(target, safe_directories)
                relative_parts = target.relative_to(dst).parts
                target_mode = (
                    None
                    if root_descriptor is None
                    or any(directory in target.parents for directory in directories_to_replace)
                    else relative_mode(root_descriptor, relative_parts)
                )
                if target_mode is not None and not force:
                    log(f"kept existing {target}")
                    continue
                if target_mode is not None:
                    if stat.S_ISDIR(target_mode):
                        ensure_safe_destination_tree(target)
                    files_to_replace.add(target)
                files_to_copy.append((source, target))

            if dst in directories_to_replace:
                remove_entry_at(destination_parent_descriptor, dst.name)
            if dst in directories_to_create:
                os.mkdir(dst.name, mode=0o755, dir_fd=destination_parent_descriptor)
                root_descriptor = os.open(
                    dst.name,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=destination_parent_descriptor,
                )
                os.fchmod(root_descriptor, 0o755)
            if root_descriptor is None:
                raise RuntimeError(f"Destination root descriptor unavailable for {dst}")

            for directory in sorted(
                (path for path in directories_to_create if path != dst),
                key=lambda path: len(path.parts),
            ):
                ensure_relative_directory(
                    root_descriptor,
                    directory.relative_to(dst).parts,
                    directory in directories_to_replace,
                )

            for source, target in files_to_copy:
                relative_parts = target.relative_to(dst).parts
                with relative_directory_descriptor(
                    root_descriptor,
                    relative_parts[:-1],
                ) as parent_descriptor:
                    if target in files_to_replace and stat.S_ISDIR(
                        mode_at(parent_descriptor, relative_parts[-1]) or 0
                    ):
                        remove_entry_at(parent_descriptor, relative_parts[-1])
                    copy_regular_file_at(source, parent_descriptor, relative_parts[-1])
                log(f"copied {source.path} -> {target}")
        finally:
            if root_descriptor is not None:
                os.close(root_descriptor)


def copy_tree_contents(src: Path, dst: Path, dry_run: bool, force: bool) -> None:
    entries = safe_source_tree_entries(src)
    if not src.exists():
        return
    if not dry_run:
        copy_tree_contents_with_descriptors(src, dst, entries, force)
        return

    safe_directories: set[Path] = set()
    blocked_source_directories: set[Path] = set()
    directories_to_create: list[Path] = []
    directories_to_replace: set[Path] = set()

    ensure_safe_destination_parent(dst, safe_directories)
    destination_mode = mode_without_following(dst)
    if destination_mode is None:
        directories_to_create.append(dst)
    elif stat.S_ISLNK(destination_mode):
        raise SystemExit(f"Refusing unsafe destination tree: symlink at {dst}")
    elif stat.S_ISDIR(destination_mode):
        pass
    elif force:
        directories_to_replace.add(dst)
        directories_to_create.append(dst)
    else:
        log(f"kept existing {dst}")
        return
    safe_directories.add(dst)

    for source in (entry for entry in entries if stat.S_ISDIR(entry.mode)):
        if any(blocked in source.path.parents for blocked in blocked_source_directories):
            continue
        target = dst / source.path.relative_to(src)
        ensure_safe_destination_parent(target, safe_directories)
        target_mode = mode_after_directory_replacements(target, directories_to_replace)
        if target_mode is None:
            directories_to_create.append(target)
        elif stat.S_ISLNK(target_mode):
            raise SystemExit(
                f"Refusing unsafe destination tree {dst}: symlink directory at {target}"
            )
        elif stat.S_ISDIR(target_mode):
            pass
        elif force:
            directories_to_replace.add(target)
            directories_to_create.append(target)
        else:
            blocked_source_directories.add(source.path)
            log(f"kept existing {target}")
            continue
        safe_directories.add(target)

    files_to_copy: list[tuple[SourceTreeEntry, Path]] = []
    files_to_replace: set[Path] = set()
    for source in (entry for entry in entries if not stat.S_ISDIR(entry.mode)):
        if any(blocked in source.path.parents for blocked in blocked_source_directories):
            continue
        target = dst / source.path.relative_to(src)
        ensure_safe_destination_parent(target, safe_directories)
        target_mode = mode_after_directory_replacements(target, directories_to_replace)
        if target_mode is not None and not force:
            log(f"kept existing {target}")
            continue
        if target_mode is not None:
            if stat.S_ISDIR(target_mode):
                ensure_safe_destination_tree(target)
            files_to_replace.add(target)
        files_to_copy.append((source, target))

    for directory in directories_to_create:
        action = "replace" if directory in directories_to_replace else "create"
        log(f"would {action} directory {directory}")
    for source, target in files_to_copy:
        log(f"would copy {source.path} -> {target}")


def import_regular_tree_at(
    src: Path,
    destination_root_descriptor: int,
    destination_components: tuple[str, ...],
) -> None:
    entries = safe_source_tree_entries(src)
    ensure_relative_directory(
        destination_root_descriptor,
        destination_components,
        False,
    )
    for source in (entry for entry in entries if stat.S_ISDIR(entry.mode)):
        relative_parts = destination_components + source.path.relative_to(src).parts
        existing_mode = relative_mode(destination_root_descriptor, relative_parts)
        if existing_mode is not None and not stat.S_ISDIR(existing_mode):
            raise SystemExit(
                f"Refusing unsafe destination tree: non-directory at {'/'.join(relative_parts)}"
            )
        ensure_relative_directory(destination_root_descriptor, relative_parts, False)

    for source in (entry for entry in entries if stat.S_ISREG(entry.mode)):
        relative_parts = destination_components + source.path.relative_to(src).parts
        with relative_directory_descriptor(
            destination_root_descriptor,
            relative_parts[:-1],
        ) as parent_descriptor:
            existing_mode = mode_at(parent_descriptor, relative_parts[-1])
            if existing_mode is not None and not stat.S_ISREG(existing_mode):
                raise SystemExit(
                    f"Refusing unsafe destination tree: non-regular file at {'/'.join(relative_parts)}"
                )
            preserved_mode = (
                stat.S_IMODE(existing_mode) if existing_mode is not None else None
            )
            copy_regular_file_at(
                source,
                parent_descriptor,
                relative_parts[-1],
                preserved_mode,
            )


def preflight_regular_tree_import_at(
    src: Path,
    destination_root_descriptor: int,
    destination_components: tuple[str, ...],
) -> None:
    entries = safe_source_tree_entries(src)
    root_mode = relative_mode(destination_root_descriptor, destination_components)
    if root_mode is not None and not stat.S_ISDIR(root_mode):
        raise SystemExit(
            f"Refusing unsafe destination tree {'/'.join(destination_components)}"
        )
    for source in entries:
        relative_parts = destination_components + source.path.relative_to(src).parts
        destination_mode = relative_mode(destination_root_descriptor, relative_parts)
        if destination_mode is None:
            continue
        source_mode = source.mode
        if stat.S_ISDIR(source_mode) and not stat.S_ISDIR(destination_mode):
            raise SystemExit(
                f"Refusing unsafe destination tree: non-directory at {'/'.join(relative_parts)}"
            )
        if stat.S_ISREG(source_mode) and not stat.S_ISREG(destination_mode):
            raise SystemExit(
                f"Refusing unsafe destination tree: non-regular file at {'/'.join(relative_parts)}"
            )


def import_regular_file_at(
    source: Path,
    destination_root_descriptor: int,
    destination_components: tuple[str, ...],
) -> None:
    try:
        source_stat = source.lstat()
    except FileNotFoundError:
        return
    source_mode = source_stat.st_mode
    if not stat.S_ISREG(source_mode):
        raise SystemExit(f"Refusing non-regular staged output {source}")
    source_entry = SourceTreeEntry(
        path=source,
        mode=source_mode,
        device=source_stat.st_dev,
        inode=source_stat.st_ino,
    )
    ensure_relative_directory(
        destination_root_descriptor,
        destination_components[:-1],
        False,
    )
    with relative_directory_descriptor(
        destination_root_descriptor,
        destination_components[:-1],
    ) as parent_descriptor:
        existing_mode = mode_at(parent_descriptor, destination_components[-1])
        if existing_mode is not None and not stat.S_ISREG(existing_mode):
            raise SystemExit(
                f"Refusing unsafe destination file {'/'.join(destination_components)}"
            )
        preserved_mode = stat.S_IMODE(existing_mode) if existing_mode is not None else None
        copy_regular_file_at(
            source_entry,
            parent_descriptor,
            destination_components[-1],
            preserved_mode,
        )


def run_specify_commands(
    repo: Path,
    commands: list[list[str]],
    dry_run: bool,
    expected_outputs: set[Path] | None = None,
) -> None:
    if not commands:
        return
    if dry_run:
        for command in commands:
            run_command(command, repo, True)
        return

    ensure_safe_specify_destination(repo)
    with directory_descriptor(repo) as repo_descriptor:
        with tempfile.TemporaryDirectory(prefix="setup-openspeckit-") as temporary_root:
            staging_repo = Path(temporary_root) / "repo"
            staging_repo.mkdir(mode=0o755)
            staging_repo.chmod(0o755)
            subprocess.run(
                ["git", "init", "-q", str(staging_repo)],
                check=True,
            )
            specify_source = repo / ".specify"
            specify_source_mode = mode_without_following(specify_source)
            specify_entries = safe_source_tree_entries(specify_source)
            if specify_source_mode is not None:
                copy_tree_contents_with_descriptors(
                    specify_source,
                    staging_repo / ".specify",
                    specify_entries,
                    True,
                )
            for command in commands:
                run_command(command, staging_repo, False)
            outputs = expected_outputs or {Path(".specify")}
            tree_outputs: set[Path] = set()
            file_outputs: set[Path] = set()
            for relative_path in outputs:
                output_mode = mode_without_following(staging_repo / relative_path)
                if output_mode is None:
                    continue
                if stat.S_ISDIR(output_mode):
                    safe_source_tree_entries(staging_repo / relative_path)
                    tree_outputs.add(relative_path)
                elif stat.S_ISREG(output_mode):
                    file_outputs.add(relative_path)
                else:
                    raise SystemExit(
                        f"Refusing non-regular staged output {staging_repo / relative_path}"
                    )
            file_outputs = {
                path
                for path in file_outputs
                if not any(parent in tree_outputs for parent in path.parents)
            }
            for relative_path in tree_outputs:
                preflight_regular_tree_import_at(
                    staging_repo / relative_path,
                    repo_descriptor,
                    relative_path.parts,
                )
            for relative_path in file_outputs:
                destination_mode = relative_mode(repo_descriptor, relative_path.parts)
                if destination_mode is not None and not stat.S_ISREG(destination_mode):
                    raise SystemExit(
                        f"Refusing unsafe destination file {relative_path}"
                    )
            for relative_path in sorted(tree_outputs, key=lambda path: len(path.parts)):
                import_regular_tree_at(
                    staging_repo / relative_path,
                    repo_descriptor,
                    relative_path.parts,
                )
            for relative_path in sorted(file_outputs):
                import_regular_file_at(
                    staging_repo / relative_path,
                    repo_descriptor,
                    relative_path.parts,
                )


def copy_missing_tree(src: Path, dst: Path, dry_run: bool, force: bool) -> None:
