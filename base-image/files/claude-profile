#!/usr/bin/env bash
set -euo pipefail

manifest="${CLAUDE_PROFILES_MANIFEST:-${XDG_CONFIG_HOME:-$HOME/.config}/workbenches/claude-profiles.json}"
base="${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}"
command -v jq >/dev/null 2>&1 || { echo "jq is required." >&2; exit 1; }

# lane-collision-protocol Amendment 8(e), as ruled by A8 Addendum 2 R-A8-5(b).
# Claude reads THIS launcher's per-profile config dir (every exec below carries
# CLAUDE_CONFIG_DIR="$config_dir"), so a SessionStart hook installed in
# ~/.claude/settings.json is never read under `pclaude run` and the entry has
# to be ensured in the profile's own settings instead.
#
# The three values below ARE the canonical entry — ruled 2026-09-12 by the
# orchestrator of the Amendment 8 round, with clause (e)'s text to be changed
# to quote them byte for byte — and the command string is the idempotence key,
# so it is not varied by anything downstream of this line. No `bash -lc`, which
# would source a login profile in front of every session start; no
# `2>/dev/null`, since every line the subcommand prints goes to stderr and the
# block is the point; `|| true` stays by that ruling, because a hook in front
# of every session start is tolerant by construction. `"timeout": 5` is part of
# the entry and not decoration: it is the outer bound on the one path that must
# never hang.
#
# `|| true` swallows the STATUS of a lanes-edit.sh that has no `session-start`
# subcommand; it does not swallow the usage block such a one prints, and that
# block would appear in front of every session on the workstation until the
# brett-wip half lands (F-S4). So the entry is also gated on the subcommand
# existing — an install-time probe, below, which changes nothing about the
# string it writes. The tilde is the harness's to expand;
# `lane_session_start_script` is the same path again, for this script's own
# reads of it.
#
# `scripts/setup-claude-profiles.sh` carries its own copy of these same three
# values (RV-W2, workBenches#63 re-verification; new-workstation#16 adoption
# act 6) so a bare `claude` run — the one case that script's
# `$default_claude_dir/settings.json` exists for — gets this entry too, not
# only the profiles this launcher execs into. Change the string here and there
# together; it is the idempotence key in both files.
lane_session_start_script="$HOME/projects/xFactory/lanes-edit.sh"
lane_session_start_command='~/projects/xFactory/lanes-edit.sh session-start || true'
lane_session_start_matcher='startup|resume|clear|fork'
lane_session_start_timeout=5
# Set by configure_profile_runtime: true when the entry is in this profile's
# settings AND the subcommand it calls exists, i.e. when the hook will speak in
# the session this launch is about to start. Amendment 8(e) makes that hook the
# only no-lane notice in the estate, so the launcher's own note stands down
# against it (lane_note_no_lane).
lane_session_start_ensured=false

# Ensuring it is an append, matched by the EXACT command string: an entry that
# already carries it is left exactly as it is — wherever it sits, whatever
# matcher it shares, whatever else the operator put beside it — and nothing
# else under .hooks is touched. Reused verbatim by both branches below.
lane_session_start_jq='
      .hooks = (.hooks // {})
      | .hooks.SessionStart = (
          (.hooks.SessionStart // []) as $entries
          | if ([$entries[]? | (.hooks // [])[]? | .command] | index($session_start))
            then $entries
            else $entries + [{
              matcher: $session_start_matcher,
              hooks: [{type: "command", command: $session_start, timeout: $session_start_timeout}]
            }]
            end
        )'

configure_profile_runtime() {
  local config_dir="$1" statusline_source statusline_link settings settings_tmp statusline_command default_model
  local guard_source guard_link guard_command guard_ok guard_timeout session_start_ok

  statusline_source="$base/shared/statusline-command.sh"
  if [[ ! -f "$statusline_source" && -f /usr/local/share/workbenches/claude/statusline-command.sh ]]; then
    statusline_source=/usr/local/share/workbenches/claude/statusline-command.sh
  fi

  if [[ -f "$statusline_source" ]]; then
    statusline_link="$config_dir/statusline-command.sh"
    if [[ -L "$statusline_link" || ! -e "$statusline_link" ]]; then
      ln -sfn "$statusline_source" "$statusline_link"
    fi
  fi

  # usage/context guard hook (shared, symlinked like the status line). The
  # model cannot read its own context or rate limits; this hook injects them
  # when a threshold is crossed. Gated per project by
  # <cwd>/.claude/usage-guard.on, so it is silent unless armed.
  guard_source="$base/shared/usage-guard.sh"
  if [[ ! -f "$guard_source" && -f /usr/local/share/workbenches/claude/usage-guard.sh ]]; then
    guard_source=/usr/local/share/workbenches/claude/usage-guard.sh
  fi
  guard_ok=false
  if [[ -f "$guard_source" ]]; then
    guard_link="$config_dir/usage-guard.sh"
    if [[ -L "$guard_link" || ! -e "$guard_link" ]]; then
      ln -sfn "$guard_source" "$guard_link"
    fi
    guard_ok=true
  fi

  # The SessionStart hook is ensured only where the estate it calls can answer
  # it: the script has to be there, and it has to HAVE the subcommand. On
  # opensoft/brett-wip `main` today it does not, and an entry written against
  # it would spend a process per session start printing a usage block. The
  # probe is one local grep of one regular file — no execution, no network, and
  # no way to hang — and a later install is picked up by the next run, because
  # this runs on every one.
  session_start_ok=false
  if [[ -f "$lane_session_start_script" ]] \
    && grep -qF 'session-start' "$lane_session_start_script" 2>/dev/null; then
    session_start_ok=true
  fi

  settings="$config_dir/settings.json"
  if [[ -e "$settings" ]] && ! jq -e 'type == "object"' "$settings" >/dev/null 2>&1; then
    echo "Claude profile settings are not valid JSON: $settings" >&2
    return 1
  fi

  statusline_command='bash "${CLAUDE_CONFIG_DIR}/statusline-command.sh"'
  default_model='claude-fable-5-1'
  guard_command='bash "${CLAUDE_CONFIG_DIR}/usage-guard.sh"'
  # SPEC §9 keeps the guard a HOOK and nothing more: "it cannot act, it can
  # only put one line into the session's context, and it must stay latched,
  # gated and fail-quiet". The automatic swap is therefore the guard's top
  # threshold line turning from advice into a directive and the SESSION
  # performing `/lane-swap` — no register write, no git, no network behind a
  # prompt submit. So 5 seconds remains the outer bound on everything this hook
  # can be asked to do, and the entry is unchanged by Amendment 11.
  guard_timeout=5
  settings_tmp="$(mktemp "$config_dir/.settings.XXXXXX.tmp")"
  if [[ -f "$settings" ]]; then
    jq --arg command "$statusline_command" --arg model "$default_model" \
       --arg guard "$guard_command" --argjson guard_ok "$guard_ok" \
       --argjson guard_timeout "$guard_timeout" \
       --arg session_start "$lane_session_start_command" \
       --arg session_start_matcher "$lane_session_start_matcher" \
       --argjson session_start_timeout "$lane_session_start_timeout" \
       --argjson session_start_ok "$session_start_ok" '
      .statusLine = {type: "command", command: $command, refreshInterval: 10}
      | .permissions = (.permissions // {})
      | .permissions.defaultMode = "bypassPermissions"
      | .effortLevel = (.effortLevel // "xhigh")
      | .model = (.model // $model)
      | (if $guard_ok then
            .hooks = (.hooks // {})
            | .hooks.UserPromptSubmit = [{hooks: [{type: "command", command: $guard, timeout: $guard_timeout}]}]
         else . end)
      | (if $session_start_ok then'"$lane_session_start_jq"' else . end)
    ' "$settings" > "$settings_tmp"
  else
    jq -n --arg command "$statusline_command" --arg model "$default_model" \
       --arg guard "$guard_command" --argjson guard_ok "$guard_ok" \
       --argjson guard_timeout "$guard_timeout" \
       --arg session_start "$lane_session_start_command" \
       --arg session_start_matcher "$lane_session_start_matcher" \
       --argjson session_start_timeout "$lane_session_start_timeout" \
       --argjson session_start_ok "$session_start_ok" '{
      statusLine: {type: "command", command: $command, refreshInterval: 10},
      permissions: {defaultMode: "bypassPermissions"},
      effortLevel: "xhigh",
      model: $model
    }
    | (if $guard_ok then
          .hooks = {UserPromptSubmit: [{hooks: [{type: "command", command: $guard, timeout: $guard_timeout}]}]}
       else . end)
    | (if $session_start_ok then'"$lane_session_start_jq"' else . end)' > "$settings_tmp"
  fi
  chmod 600 "$settings_tmp"
  mv -f "$settings_tmp" "$settings"
  # RV-W1 (workBenches#63 re-verification): set only now, for THIS profile,
  # after its settings.json actually carries the entry — not at probe time.
  # A probe of the estate says the entry CAN be ensured; it says nothing about
  # a profile that has not been through this function yet, and the two came
  # apart the moment the probe could answer true for every profile: a fresh
  # profile's first launch would print neither the launcher's no-lane notice
  # nor the hook's block, because lane_note_no_lane stood down on the probe
  # while the write that makes it true had not happened yet. One launch,
  # self-healing on the next (this function runs on every one) — but the
  # ruling is that the flag names what THIS run wrote, not what the estate
  # merely allows.
  lane_session_start_ensured="$session_start_ok"
}

load_profile_setup_token() {
  local config_dir="$1" token_file mode
  token_file="$config_dir/.setup-token"
  [[ -e "$token_file" ]] || return 0
  [[ -f "$token_file" && ! -L "$token_file" ]] || {
    echo "Claude profile setup token must be a regular file: $token_file" >&2
    return 1
  }
  mode="$(stat -c '%a' "$token_file")"
  [[ "$mode" == 600 ]] || {
    echo "Claude profile setup token must have mode 0600: $token_file" >&2
    return 1
  }
  IFS= read -r CLAUDE_CODE_OAUTH_TOKEN < "$token_file"
  [[ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]] || {
    echo "Claude profile setup token is empty: $token_file" >&2
    return 1
  }
  export CLAUDE_CODE_OAUTH_TOKEN
}

claude_bin="${CLAUDE_BIN:-$(command -v claude || true)}"
if [[ -z "$claude_bin" && -x "$HOME/.local/bin/claude" ]]; then
  claude_bin="$HOME/.local/bin/claude"
fi
mcp_sync="${WORKBENCHES_MCP_SYNC_BIN:-$(command -v workbenches-mcp-sync || true)}"
if [[ -z "$mcp_sync" ]]; then
  launcher_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  [[ -x "$launcher_dir/workbenches-mcp-sync" ]] && mcp_sync="$launcher_dir/workbenches-mcp-sync"
fi

family_uses_shared_mcp() {
  local family="$1"
  local configured=",${WORKBENCHES_SHARED_MCP_FAMILIES:-opensoft},"
  [[ "$configured" == *",$family,"* ]]
}

claude_mcp_snapshot() {
  local metadata="$1" output="$2"
  if [[ -f "$metadata" ]]; then
    jq '{mcpServers: (.mcpServers // {})}' "$metadata" >"$output"
  else
    printf '%s\n' '{"mcpServers":{}}' >"$output"
  fi
  chmod 0600 "$output"
}

claude_add_has_scope() {
  local argument
  for argument in "$@"; do
    [[ "$argument" == --scope || "$argument" == -s || "$argument" == --scope=* ]] && return 0
  done
  return 1
}

# The first Claude argument says whether this launch is a conversation at all.
# `mcp`, `doctor`, `--version` and the other subcommands and one-shots are not,
# so they are neither wrapped in a tmux session of their own nor handed to
# lane-start by the lane default below.
claude_args_start_session() {
  case "${1:-}" in
    mcp|plugin|plugins|doctor|install|update|--help|-h|--version|-v|--print|-p)
      return 1
      ;;
  esac
  return 0
}

claude_run_is_interactive() {
  [[ -t 0 && -t 1 ]] || return 1
  [[ "${WORKBENCHES_CLAUDE_TMUX:-auto}" != off ]] || return 1
  [[ -z "${WORKBENCHES_CLAUDE_TMUX_CHILD:-}" ]] || return 1
  [[ -z "${TMUX:-}" ]] || return 1
  claude_args_start_session "$@"
}

start_profile_tmux() {
  local profile="$1"
  shift
  local launcher session_name command_string="" argument
  local -a env_prefix
  # AMENDMENT 11(2), ACT 1 — THE WINDOW IS REUSED, NEVER REPLACED.
  # This function exists for the launch that came from NO tmux window: it makes
  # one. Called from inside tmux it would replace the lane's own window with a
  # brand-new session whose window is named for the command that made it, and
  # the lane's name and id — the two things precedence 2 and the swap record
  # are keyed on — would not survive the restart. `claude_run_is_interactive`
  # already requires an empty $TMUX, so this is unreachable today; it is here
  # because the property is the amendment and not an emergent consequence of
  # that function's fourth test, and a refactor that loses it must fail loudly
  # rather than quietly start creating sessions again.
  [[ -z "${TMUX:-}" ]] || {
    echo "pclaude: refusing to create a tmux session from inside one; the lane's window is reused (Amendment 11(2))." >&2
    return 1
  }
  env_prefix=(env WORKBENCHES_CLAUDE_TMUX_CHILD=1)
  # --lane/CLAUDE_LANE must survive this re-exec into a new tmux session.
  # tmux does not reliably hand a freshly-exported variable to a new session
  # on an already-running server, so it is threaded through explicitly here
  # rather than relied on via inheritance — same idiom as the guard above.
  [[ -n "${lane:-}" ]] && env_prefix+=("CLAUDE_LANE=$lane")
  [[ "${no_lane:-false}" == true ]] && env_prefix+=("CLAUDE_NO_LANE=1")
  # So must the name of the window this was typed in. The session created here
  # is brand new and its window is named for the command that made it, never
  # for a lane, so the child must read the name captured on this side of the
  # re-exec instead of asking tmux again (capture_lane_window).
  [[ -n "${lane_window:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW=$lane_window")
  # The window's ADDRESS travels the same way, and for the same reason. It is
  # information (Amendment 11(5): the id is stored, the NAME stays the key) —
  # the swap record's `window <session>:<index> <@id>` field — and the child
  # would otherwise record the address of the session this function just made.
  [[ -n "${lane_window_ref:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW_REF=$lane_window_ref")
  [[ -n "${lane_window_id:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW_ID=$lane_window_id")
  # And the lane's directory, when the operator named one: `--dir` is this
  # launcher's own option, so nothing downstream would see it otherwise.
  [[ -n "${lane_dir_flag:-}" ]] && env_prefix+=("CLAUDE_LANE_DIR=$lane_dir_flag")

  command -v tmux >/dev/null 2>&1 || {
    echo "pclaude: tmux is required for interactive profile launches." >&2
    return 1
  }
  launcher="$(readlink -f "${BASH_SOURCE[0]}")"
  session_name="claude-${profile//[^a-zA-Z0-9_-]/-}-$(date +%Y%m%d%H%M%S)-$$"
  for argument in "${env_prefix[@]}" "$launcher" run "$profile" "$@"; do
    printf -v argument '%q' "$argument"
    command_string+="${command_string:+ }$argument"
  done

  # THE NEW WINDOW IS NAMED FOR THE LANE AT BIRTH — SPEC §3, outside tmux.
  # Without `-n`, tmux names the window for the command that made it and global
  # `automatic-rename` then renames it again for whatever is running: on Eagle,
  # 8 of 16 live windows are called `claude`, and a window called `claude` has
  # no lane (Rule 4). `lane-start` renames it to the lane a moment later
  # anyway, so naming it here changes nothing about what this launch does —
  # what it changes is the NEXT restart typed in that window, which finds a
  # window that says which lane it is and binds by precedence 2, with no
  # question, instead of falling to the swap record's.
  #
  # ONLY FOR A LANE THAT IS CERTAIN. `--lane`/`CLAUDE_LANE` is the operator's
  # word and is the only lane knowable on this side of the re-exec: the window
  # rule has no window to read and the swap record's newest-first row is an
  # INFERENCE, which Amendment 8(c) hands over as `--confirm` precisely so
  # lane-start asks before it takes a window. Naming the window for it here
  # would answer that question in advance and in the wrong place — the child
  # would then find a window named for the lane and bind by name, silently,
  # from a guess nobody confirmed. So the inference is left exactly where it
  # is: the child resolves it inside tmux and lane-start asks.
  #
  # `automatic-rename off` is what makes the name stick: `rename-window` turns
  # it off as a side effect (tmux(1)) and `-n` does not, so without this the
  # first command the window runs renames it straight back.
  # `lane` is non-empty HERE only when `--lane` or `CLAUDE_LANE` gave it:
  # resolve_lane has not run yet on this side of the re-exec, and `--no-lane`
  # already emptied it. So the test for certainty is simply that there is one.
  if [[ -n "${lane:-}" ]]; then
    tmux new-session -d -s "$session_name" -n "$lane" -c "$PWD" "$command_string" || {
      echo "pclaude: failed to start tmux session $session_name" >&2
      return 1
    }
    tmux set-window-option -t "$session_name:0" automatic-rename off >/dev/null 2>&1 || true
  else
    tmux new-session -d -s "$session_name" -c "$PWD" "$command_string" || {
      echo "pclaude: failed to start tmux session $session_name" >&2
      return 1
    }
  fi
  tmux set-option -t "$session_name" mouse on >/dev/null 2>&1 || true
  exec tmux attach-session -t "$session_name"
}

export_tmux_identity() {
  local session pane
  [[ -n "${TMUX:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  session="$(tmux display-message -p '#S' 2>/dev/null || true)"
  pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
  [[ -n "$session" ]] && export WORKBENCHES_TMUX_SESSION="$session"
  [[ -n "$pane" ]] && export WORKBENCHES_TMUX_PANE="$pane"
}

# Native Claude records ~/.local/bin/claude as its expected installation path.
# Bench images install the immutable CLI in /usr/local/bin, so provide a
# per-user compatibility link to keep Claude's installer health check accurate.
if [[ ! -e /.dockerenv && "$claude_bin" == "/usr/local/bin/claude" ]]; then
  if mkdir -p "$HOME/.local/bin" 2>/dev/null; then
    if [[ ! -e "$HOME/.local/bin/claude" && ! -L "$HOME/.local/bin/claude" ]]; then
      ln -s /usr/local/bin/claude "$HOME/.local/bin/claude"
    elif [[ -L "$HOME/.local/bin/claude" && ! -e "$HOME/.local/bin/claude" ]]; then
      ln -sfn /usr/local/bin/claude "$HOME/.local/bin/claude"
    fi
  fi
fi

profile_metadata() {
  local requested="$1" normalized row metadata candidate profile_path fallback_row
  local preferred_row preferred_depth=-1 path_depth
  normalized="$(printf '%s' "$requested" | tr '[:upper:]' '[:lower:]')"
  if [[ -f "$manifest" ]]; then
    row="$(jq -r --arg name "$normalized" \
      '.profiles[]
       | select(
           ((.name | ascii_downcase) == $name)
           or any(.aliases[]?; (ascii_downcase == $name))
         )
       | [.name,.email,.family,(.profilePath // .name)] | @tsv' \
      "$manifest" | head -n 1)"
    if [[ -n "$row" ]]; then
      printf '%s\n' "$row"
      return 0
    fi
  fi

  while IFS= read -r -d '' metadata; do
    candidate="$(jq -r --arg name "$normalized" '
      if (((.name // "") | ascii_downcase) == $name)
         or any(.aliases[]?; (ascii_downcase == $name))
      then "match" else empty end
    ' "$metadata")"
    if [[ "$candidate" == "match" ]]; then
      profile_path="${metadata#"$base/profiles/"}"
      profile_path="${profile_path%/.profile.json}"
      row="$(jq -r --arg path "$profile_path" '[.name,.email,.family,$path] | @tsv' "$metadata")"
      if jq -e '(.profilePath // "") | length > 0' "$metadata" >/dev/null; then
        path_depth="$(awk -F/ '{print NF}' <<<"$profile_path")"
        if (( path_depth > preferred_depth )); then
          preferred_row="$row"
          preferred_depth="$path_depth"
        fi
      elif [[ -z "${fallback_row:-}" ]]; then
        fallback_row="$row"
      fi
    fi
  done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
  if [[ -n "${preferred_row:-}" ]]; then
    printf '%s\n' "$preferred_row"
    return 0
  fi
  if [[ -n "${fallback_row:-}" ]]; then
    printf '%s\n' "$fallback_row"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# THE LANE DEFAULT — lane-collision-protocol Amendment 8(c).
#
# `--lane` was opt-in, and a launch without it started a Claude with no lane at
# all: the window kept tmux's automatic rename, no register row was stamped,
# and the resume was left to a picker filtered by a title several transcripts
# share. That is the 2026-09-11 wrong-lineage resume, whose sixth finding was
# simply "the automation never ran" (Amendment 6). So a launch that starts a
# conversation now takes a lane by default, and the lane is RESOLVED rather
# than typed:
#
#   1. --lane / CLAUDE_LANE — what the operator said. Always wins.
#   2. the CURRENT tmux window's name, when `lanes-edit.sh register-row` says
#      the register has a row for it. The window name IS the lane (Rule 4),
#      and lane-start turned tmux's automatic rename off when it took the
#      window, so a window still called `claude` or `zsh` simply is not one.
#   3. the swap record whose `window` sub-field NAMES THIS WINDOW — its
#      `<@id>` first, else its `<session>:<index>`. New in Amendment 11 (SPEC
#      §2), and reachable only because act 1 keeps the window: an exact match
#      on the window the operator is standing in, so no question is asked.
#   4. `lanes-edit.sh swapped <workstation>`, first row — the lane this
#      workstation last PAUSED for a swap and has not resumed since (the
#      record, Amendment 8(b)), read only inside tmux, because taking it means
#      renaming a window.
#   5. nothing: exactly today's behaviour, plus one line saying how to take a
#      lane in this window — and not even that where the SessionStart hook of
#      clause (e) is ensured, since that block says the same thing with the
#      repo and the number filled in.
#
# 2 and 3 are certain — the operator is standing in the lane's own window, and
# the two rules differ only in which end of that fact they read it from, the
# window's name or the record's copy of its address — so both go to lane-start
# BARE, byte-for-byte as an explicit `--lane` always did. 4 is a guess: the
# newest record on the workstation, which on 2026-09-13 was 23 seconds ahead of
# the next one (Evidence 1). It goes as `--confirm` and lane-start asks before
# it renames the window. `--yes` is passed nowhere: it is inert in lane-start
# unless `--confirm` came with it, and `--confirm` is the one case it must
# never come with (F-W2, F-T8).
#
# NOTHING HERE REFUSES A LAUNCH, and after A8 Addendum 2 R-A8-3 that is true of
# the composition and not just of this file: every probe that cannot be made —
# no lane-start, no lanes-edit.sh, a lanes-edit.sh with no `swapped` yet, a
# lane-start with no `--confirm` yet, no tmux to take a window in — falls back
# to 4, and the one path that asks the operator a question launches Claude on
# BOTH answers, because the `--confirm` case runs lane-start instead of exec'ing
# it and catches a decline.
#
# AMENDMENT 11 (ratified 2026-09-13, "a11 1–5 yes, push them") changes three
# things about the above and nothing about its order:
#
#   (1) the verb is optional. `pclaude team03a` IS `pclaude run team03a`, so a
#       restart is one word and a lane is entered without naming one.
#   (2) THE WINDOW IS REUSED, act 1. Run inside tmux this launcher keeps the
#       CURRENT window — it sets CLAUDE_CONFIG_DIR and execs in place — so the
#       window's name and its id survive a restart and rule 2 above, the rule
#       that asks nothing, is the one that fires. Before this, every launch
#       made a fresh tmux session whose window is named for the command that
#       made it, so rule 2 could never fire on a restart and rule 3's one
#       question always could (new-workstation#20, Evidence 1). Outside tmux a
#       session is still created, and there rule 3 is still what binds.
#   (3) the lane's DIRECTORY is learnt and passed as `--dir`
#       (resolve_lane_dir), and lane-start is RUN rather than exec'd on every
#       path, so a refusal can never leave a window with no Claude in it.
#
# and one thing about the swap that is not in this file: at the 95% breakpoint
# the usage guard (`claude-usage-guard.sh`, wired into every profile by
# configure_profile_runtime above) performs the swap itself — the PAUSED
# record and the one restart command — with no question asked, so the record
# rule 3 reads is written whether or not anybody ran `/lane-swap`.

lanes_edit_bin() {
  # Found the way lane-start is, and never as a path spelled for one
  # workstation: on PATH, else beside the lane-start that IS on PATH (both are
  # `lanes/` in opensoft/brett-wip), else the symlink the protocol names.
  local candidate lane_start
  candidate="${WORKBENCHES_LANES_EDIT_BIN:-$(command -v lanes-edit.sh 2>/dev/null || true)}"
  if [[ -z "$candidate" ]]; then
    lane_start="$(command -v lane-start 2>/dev/null || true)"
    if [[ -n "$lane_start" ]]; then
      candidate="$(dirname "$(readlink -f "$lane_start")")/lanes-edit.sh"
    fi
  fi
  [[ -n "$candidate" ]] || candidate="$HOME/projects/xFactory/lanes-edit.sh"
  [[ -x "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

capture_lane_window() {
  # The lane's window is the one this was typed in, and its name is readable
  # only HERE — before start_profile_tmux re-execs into a session tmux names
  # after the command that made it. A child of that re-exec never asks tmux: it
  # takes the name threaded across, which is empty when the launch did not come
  # from a tmux window at all.
  #
  # Amendment 11(5) adds the window's ADDRESS beside its name: `#S:#I` and the
  # id `#{window_id}` (`@7`), which is the one handle that does not change when
  # the window is renamed. The NAME stays the key — the register is keyed on it
  # and the id does not survive a tmux server restart — so the address is
  # carried, exported and recorded as INFORMATION and is never resolved from.
  # It is read in probes of its own rather than in one combined format string,
  # because `display-message -p '#W'` is the read every other part of this
  # feature is specified and tested against and a combined read would change
  # what a fake, a log or an operator's `-p` sees for the answer that matters.
  if [[ -n "${WORKBENCHES_CLAUDE_TMUX_CHILD:-}" ]]; then
    lane_window="${WORKBENCHES_CLAUDE_WINDOW:-}"
    lane_window_ref="${WORKBENCHES_CLAUDE_WINDOW_REF:-}"
    lane_window_id="${WORKBENCHES_CLAUDE_WINDOW_ID:-}"
    return 0
  fi
  lane_window=""
  lane_window_ref=""
  lane_window_id=""
  [[ -n "${TMUX:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  lane_window="$(tmux display-message -p '#W' 2>/dev/null || true)"
  lane_window_ref="$(tmux display-message -p '#S:#I' 2>/dev/null || true)"
  lane_window_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  # An id is `@<digits>` and nothing else. A tmux too old to know the format
  # prints the format back, and a fake or a shim may print anything at all;
  # recording that string as a window id would put a lie in the object log,
  # which is append-only. The ref is `<session>:<index>`, and a session name
  # may contain almost anything, so only the `:<digits>` tail is checked.
  [[ "$lane_window_id" =~ ^@[0-9]+$ ]] || lane_window_id=""
  [[ "$lane_window_ref" =~ ^.+:[0-9]+$ ]] || lane_window_ref=""
  return 0
}

export_lane_identity() {
  # What this launch decided, published for the SESSION it is about to start:
  # the usage guard's automatic swap (Amendment 11(4)) and the `/lane-swap`
  # skill both have to name the lane, its window and its directory, and only
  # this process knows all three at once. They are exported under the
  # launcher's own namespace and never as CLAUDE_LANE, which is an INPUT to
  # this script and to nothing else: exporting it would make every nested
  # launch inherit a lane the operator did not type.
  #
  # The guard re-reads the window name for itself and validates it against the
  # register, because a window can be renamed after this point and the name is
  # the key. These are what it falls back to, and the address and directory it
  # cannot derive.
  [[ -z "${lane:-}" ]] || export WORKBENCHES_CLAUDE_LANE="$lane"
  [[ -z "${lane_source:-}" ]] || export WORKBENCHES_CLAUDE_LANE_SOURCE="$lane_source"
  [[ -z "${lane_window_ref:-}" ]] || export WORKBENCHES_CLAUDE_WINDOW_REF="$lane_window_ref"
  [[ -z "${lane_window_id:-}" ]] || export WORKBENCHES_CLAUDE_WINDOW_ID="$lane_window_id"
  [[ -z "${lane_dir:-}" ]] || export WORKBENCHES_CLAUDE_LANE_DIR="$lane_dir"
}

lane_no_lane_note='no lane for this window; run lane-start <repo> <n> inside it'

lane_note_no_lane() {
  # One situation, ONE line (F-W3). A caller that has something of its own to
  # report passes it; the standing note is appended to it rather than printed
  # under it.
  #
  # And the note itself stands down where the SessionStart hook can speak.
  # Amendment 8(e): that block is "the ONLY no-lane notice in the estate;
  # clause (c) step 4 stands down wherever this hook can speak" — it holds the
  # lane, so it fills in <repo> and <n> instead of leaving them for a reader to
  # translate at the one moment they are trying to get back to work. Printing
  # both is the same instruction twice (R-A8-7, "one no-lane notice not two").
  # Where the hook was not ensured — no estate, or a lanes-edit.sh with no
  # `session-start` yet — nothing else will say it, so this does.
  local reported="${1:-}"
  if [[ "${lane_session_start_ensured:-false}" == true ]]; then
    [[ -n "$reported" ]] || return 0
    echo "pclaude: $reported" >&2
    return 0
  fi
  if [[ -n "$reported" ]]; then
    echo "pclaude: $reported; $lane_no_lane_note" >&2
  else
    echo "pclaude: $lane_no_lane_note" >&2
  fi
}

lane_window_is() {
  # Whether the current tmux window is named for this lane — i.e. whether
  # lane-start took it. Asked only AFTER lane-start has run, on the one path
  # that does not exec it, and never as a source of a lane.
  local want="$1" now
  command -v tmux >/dev/null 2>&1 || return 1
  now="$(tmux display-message -p '#W' 2>/dev/null || true)"
  [[ -n "$now" && "$now" == "$want" ]]
}

lane_start_supports() {
  # `--confirm` arrives with the brett-wip half of Amendment 8. Until it does,
  # a lane-start that has never heard of it must not be handed it, and its own
  # --help is the only thing that can say.
  local flag="$1"
  if [[ -z "${lane_start_help+set}" ]]; then
    lane_start_help="$(lane-start --help 2>/dev/null || true)"
  fi
  [[ "$lane_start_help" == *"$flag"* ]]
}

resolve_lane() {
  # Sets `lane` and `lane_source` (flag|window|record, empty for none) from the
  # Claude arguments this launch carries. Never fails, never refuses: a lane
  # that cannot be resolved is today's behaviour.
  local lanes_edit ws rows status candidate reason swapped_err first_row
  local -a swapped_argv
  if [[ -n "${lane:-}" ]]; then
    lane_source=flag
    return 0
  fi
  [[ "$no_lane" == false ]] || return 0
  claude_args_start_session "$@" || return 0
  # No lane estate on this machine: the whole feature is absent, and saying so
  # on every launch would be noise.
  command -v lane-start >/dev/null 2>&1 || return 0
  lanes_edit="$(lanes_edit_bin || true)"
  if [[ -z "$lanes_edit" ]]; then
    lane_note_no_lane
    return 0
  fi

  # LANES_NO_FETCH=1 on both reads: they are on the path of every launch, and
  # lanes-edit.sh otherwise fetches origin before it answers. A row or a record
  # this workstation wrote is in this workstation's own clone already, and a
  # launcher must not sit on the network to open a terminal.
  #
  # Only 0 is a lane. `register-row` answers 8 for a name with no row and 2 for
  # a window name that is not even lane-shaped (`zsh`, `1:vim*`).
  if [[ -n "${lane_window:-}" ]] \
    && LANES_NO_FETCH=1 "$lanes_edit" register-row "$lane_window" >/dev/null 2>&1; then
    lane="$lane_window"
    lane_source=window
    return 0
  fi

  # The record's lane is a guess about a WINDOW: `lane-start` takes it by
  # renaming the current tmux window (Amendment 5(f)), so there has to be one.
  # Outside tmux there is not — `WORKBENCHES_CLAUDE_TMUX=off`, a launch that is
  # not on a tty — and a lane-start handed a lane it cannot take is how a
  # resolution that "never refuses a launch" refuses one. An interactive launch
  # with no TMUX re-execs into a session of its own before this runs, and the
  # child resolves INSIDE tmux, where this test passes; so the case this closes
  # is exactly the documented direct launch, which keeps its documented
  # behaviour. The window rule above needs no such test: it has no lane to
  # offer unless tmux named the window in the first place.
  if [[ -z "${TMUX:-}" ]]; then
    lane_note_no_lane
    return 0
  fi

  ws="${LANES_WORKSTATION:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)}"
  swapped_argv=(swapped)
  [[ -z "$ws" ]] || swapped_argv+=("$ws")
  swapped_err="$(mktemp "${TMPDIR:-/tmp}/pclaude-swapped.XXXXXX")"
  set +e
  rows="$(LANES_NO_FETCH=1 "$lanes_edit" "${swapped_argv[@]}" 2>"$swapped_err")"
  status=$?
  set -e
  reason="$(cat "$swapped_err" 2>/dev/null || true)"
  rm -f "$swapped_err"
  # 0 with rows `<lane>\t<UTC>\t<window>[\t<dir>]`, most recent first; 8 with
  # none. The contract is the TAB: a row without one is not that shape, and
  # taking its first field would take the whole line — which `cut -f 1` hands
  # back intact, lane-shaped and wrong, for output that never came from
  # `swapped` at all.
  #
  # PRECEDENCE 3 (SPEC §2, new in Amendment 11) — THE RECORD FOR *THIS*
  # WINDOW, and it is not a guess. Every row's third field is the window the
  # swap paused in, `<session>:<index>` and, from Amendment 11(5), its
  # `<@id>` beside it. Where one of those refs IS the window this command was
  # typed in, the lane is an exact match on the window the operator is
  # standing in — the same certainty the window NAME carries in precedence 2,
  # arrived at from the other side — so it goes to lane-start BARE, with no
  # `--confirm` and no question. Only if no row names this window does the
  # newest-first guess of precedence 4 apply, and that one is still confirmed.
  #
  # This is what makes a restart in the lane's own window silent even when the
  # window has LOST its name: a tmux `automatic-rename` that fired, a window
  # renamed by hand, a pane that came back as `zsh`. The id is the better key
  # of the two and is tried first, because a session:index is reused the
  # moment a window is closed and another takes its place, while an id is
  # never reissued for the life of the server.
  if [[ "$status" -eq 0 && -n "$rows" ]] \
    && { [[ -n "${lane_window_id:-}" ]] || [[ -n "${lane_window_ref:-}" ]]; }; then
    candidate="$(printf '%s\n' "$rows" | awk -F'\t' -v id="${lane_window_id:-}" -v ref="${lane_window_ref:-}" '
      NF < 3 { next }
      {
        n = split($3, w, /[ \t]+/)
        for (i = 1; i <= n; i++) {
          if ((id != "" && w[i] == id) || (ref != "" && w[i] == ref)) { print $1; exit }
        }
      }')"
    if [[ "$candidate" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
      lane="$candidate"
      lane_source=window-record
      lane_record_row="$(printf '%s\n' "$rows" | awk -F'\t' -v want="$candidate" '$1 == want { print; exit }')"
      return 0
    fi
  fi
  first_row="$(printf '%s\n' "$rows" | head -n 1)"
  if [[ "$status" -eq 0 && -n "$rows" && "$first_row" == *$'\t'* ]]; then
    candidate="${first_row%%$'\t'*}"
    if [[ "$candidate" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
      lane="$candidate"
      lane_source=record
      # The row this lane came from, kept for resolve_lane_dir: the record is
      # the one place that knows where the lane this workstation paused
      # actually lives, and it is read once (Amendment 11(3)).
      lane_record_row="$first_row"
      return 0
    fi
  fi
  # A lanes-edit.sh from before Amendment 8 exits 2 because it has no `swapped`
  # subcommand at all — but 2 is also its usage code, so a caller bug would look
  # exactly like an old helper and degrade to case 4 in silence (F-W4). The
  # status cannot tell them apart; the helper's own words can, because it says
  # "unknown subcommand" for the one and not for the other. An old helper is
  # expected and silent. A caller bug gets one line, and still a launch.
  if [[ "$status" -ne 0 && "$status" -ne 8 && "$reason" != *"unknown subcommand"* ]]; then
    lane_note_no_lane "lanes-edit.sh ${swapped_argv[*]} exited $status without calling it an unknown subcommand, so this is a caller bug and not an old helper"
    return 0
  fi
  lane_note_no_lane
  return 0
}

# ---------------------------------------------------------------------------
# THE LANE'S DIRECTORY — Amendment 11(3).
#
# `lane-start` needs to know where the lane lives, and its default is
# `$PROJECTS_ROOT/<repo>` — the `<repo>` parsed out of the lane's own name.
# That default is a GUESS about a checkout's path, and on 2026-09-13 it was
# wrong for a real lane: `openXfactory-5` lives in `~/projects/xFactory/
# openxFactory`, so `pclaude --lane openXfactory-5 run team01l` reached
# `lane-start`, which died with "no such directory … pass --dir" — and because
# the launcher `exec`ed it into a tmux session whose only command it was, tmux
# printed `[exited]` and the window closed on a restart that had nothing wrong
# with it (new-workstation#20, Evidence 2).
#
# So the launcher learns the directory where it can and passes `--dir`. In
# order, and never guessing:
#
#   1. `--dir <path>`         — what the operator said. Passed as given.
#   2. `CLAUDE_LANE_DIR`      — the same thing from the environment, so the
#                               re-exec into a new tmux session can carry it.
#   3. the SWAP RECORD        — the lane this workstation paused recorded where
#                               it was (`dir <path>` in the PAUSED payload,
#                               Amendment 11(4)); read only for the lane the
#                               record itself named.
#   4. the REGISTER ROW       — a `dir <path>` / `dir: <path>` field in the
#                               lane's own row, if the register records one.
#   5. the CWD's checkout     — only when its basename IS the lane's `<repo>`
#                               token and lane-start's own default does not
#                               exist. See below.
#   6. nothing                — `--dir` is not passed and lane-start's default
#                               stands, byte for byte as before this existed.
#
# 3 and 4 are read TOLERANTLY: today's `lanes-edit.sh swapped` prints
# `<lane>\t<UTC>\t<window>` and today's register row has no directory in it at
# all, so both rungs simply find nothing and the next one is tried. A helper
# that starts recording one is picked up with no change here, because the field
# is looked for by its LABEL and by nothing positional — an unlabelled column
# that happens to look like a path is not a directory this launcher will act
# on, and a row whose shape changed underneath it can therefore never make it
# start a lane in the wrong tree.
#
# RUNG 5 IS THE ONE INFERENCE, AND IT IS FENCED ON BOTH SIDES. It fires only
# when lane-start's own default `$PROJECTS_ROOT/<repo>` DOES NOT EXIST — so it
# can never change where a lane that already works is started — and only when
# the basename of the cwd's git checkout matches the lane's `<repo>` token
# ignoring case, which is exactly Evidence 2's `openxFactory` vs
# `openXfactory`. A wrong directory here is not a cosmetic error: lane-start
# writes the lane's HOME into the Amendment 7 STARTED line from that
# directory's `origin`, and a home is inherited by every `#n` the lane writes.
# The two fences mean the only thing this rung can do is turn a certain
# refusal into the checkout the operator is standing in, under the lane's own
# name. `WORKBENCHES_CLAUDE_LANE_DIR_FROM_CWD=off` turns it off.

lane_dir_field() {
  # A `dir <path>` / `dir: <path>` / `dir=<path>` field anywhere in the text
  # given, whatever separates the fields around it. Only an ABSOLUTE path is
  # an answer: a relative one has no meaning without the writer's cwd, which
  # nothing here knows, and `~` is the writing shell's and not this one's.
  local text="$1" value
  value="$(printf '%s\n' "$text" \
    | sed -n 's/.*[[:space:]|]dir[:=]\{0,1\}[[:space:]]\{1,\}\(\/[^|;\t]*\).*/\1/p' \
    | head -n 1)"
  value="${value%"${value##*[![:space:]]}"}"
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

resolve_lane_dir() {
  # Sets `lane_dir` and `lane_dir_source`
  # (flag|env|record|recorded|cwd, empty for none). Never fails and never
  # refuses: a directory that cannot be learnt is lane-start's default, which
  # is what every launch before Amendment 11 passed.
  local lanes_edit row candidate repo_token cwd_root default_root status
  lane_dir=""
  lane_dir_source=""
  [[ -n "${lane:-}" ]] || return 0

  # 1 and 2 — the operator's word, passed exactly as given. NOT tested for
  # existence: lane-start's refusal names the path and the flag that fixes it,
  # and a launcher that silently dropped what it was told would hide that.
  if [[ -n "${lane_dir_flag:-}" ]]; then
    lane_dir="$lane_dir_flag"; lane_dir_source=flag; return 0
  fi
  if [[ -n "${CLAUDE_LANE_DIR:-}" ]]; then
    lane_dir="$CLAUDE_LANE_DIR"; lane_dir_source=env; return 0
  fi

  # 3 — THE SWAP RECORD, and only the row that named THIS lane: a record for
  # some other lane says nothing about where this one lives. Free — the row is
  # already in hand from resolve_lane, so nothing is read again for it. SPEC
  # §11 gives `swapped` a FOURTH tab-separated field, `<dir>`; a labelled
  # `dir <path>` anywhere in the row is taken too, so a helper that packs it
  # into the payload instead is read the same way. Today's helper has neither,
  # and finds nothing.
  if [[ -n "${lane_record_row:-}" ]]; then
    candidate="$(printf '%s' "$lane_record_row" | cut -f 4)"
    [[ "$candidate" == /* ]] || candidate="$(lane_dir_field "$lane_record_row" || true)"
    if [[ -n "$candidate" && -d "$candidate" ]]; then
      lane_dir="$candidate"; lane_dir_source=record; return 0
    fi
  fi

  # 4 — THE LANE'S RECORDED DIRECTORY (SPEC §11, `lanes-edit.sh lane-dir
  # <lane>`: the `dir ` sub-field of its log's last lane-kind line carrying
  # one; 0 a path, 8 none, 64 usage). Read with the same LANES_NO_FETCH=1 as
  # every other register read on the path of a launch — a launcher must not sit
  # on the network to open a terminal. A helper that has no such subcommand
  # answers 2 and is simply a helper that records no directory yet; ONLY 0 with
  # an existing directory is an answer, so an unknown-subcommand line can never
  # be mistaken for a path.
  lanes_edit="$(lanes_edit_bin || true)"
  if [[ -n "$lanes_edit" ]]; then
    set +e
    row="$(LANES_NO_FETCH=1 "$lanes_edit" lane-dir "$lane" 2>/dev/null)"
    status=$?
    set -e
    row="${row%%$'\n'*}"
    if [[ "$status" -eq 0 && "$row" == /* && -d "$row" ]]; then
      lane_dir="$row"; lane_dir_source=recorded; return 0
    fi
  fi

  # 5 — THE CWD'S CHECKOUT, and it is the one INFERENCE here, fenced on both
  # sides. It fires only where lane-start's own default `$PROJECTS_ROOT/<repo>`
  # DOES NOT EXIST, so a launch that has always worked keeps working and this
  # rung is not even attempted; and only where the basename of the cwd's git
  # checkout IS the lane's `<repo>` token ignoring case, which is exactly
  # Evidence 2's `openxFactory` against `openXfactory`. A derived path that
  # overrode a working default could move a lane into another tree, where
  # lane-start would write that tree's `origin` into the lane's Amendment 7
  # STARTED line as its HOME — a home every `#n` the lane writes then inherits.
  # Between the two fences the most this rung can do is turn a certain refusal
  # into the checkout the operator is standing in, under the lane's own name.
  # It is a DEGRADATION for the estate as it is today, and it retires itself:
  # once rung 3 or 4 can answer, this one is never reached.
  [[ "${WORKBENCHES_CLAUDE_LANE_DIR_FROM_CWD:-on}" != off ]] || return 0
  repo_token="${lane%-*}"
  [[ -n "$repo_token" && "$repo_token" != "$lane" ]] || return 0
  default_root="${PROJECTS_ROOT:-$HOME/projects}/$repo_token"
  [[ ! -d "$default_root" ]] || return 0
  command -v git >/dev/null 2>&1 || return 0
  cwd_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$cwd_root" && -d "$cwd_root" ]] || return 0
  [[ "$(printf '%s' "${cwd_root##*/}" | tr '[:upper:]' '[:lower:]')" \
     == "$(printf '%s' "$repo_token" | tr '[:upper:]' '[:lower:]')" ]] || return 0
  lane_dir="$cwd_root"
  lane_dir_source=cwd
  return 0
}

# --lane / CLAUDE_LANE / --no-lane are recognised only as leading options,
# before the action/profile — the first token that is not one of them ends this
# loop and is left for the existing parsing below, so anything meant for Claude
# itself (e.g. `claude-profile work --help`) is untouched.
lane="${CLAUDE_LANE:-}"
lane_source=""
lane_window=""
lane_window_ref=""
lane_window_id=""
lane_record_row=""
lane_dir=""
lane_dir_source=""
lane_dir_flag=""
no_lane=false
[[ -z "${CLAUDE_NO_LANE:-}" ]] || no_lane=true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lane)
      [[ $# -ge 2 ]] || { echo "pclaude: --lane needs a value: <repo>-<n>" >&2; exit 2; }
      lane="$2"; shift 2 ;;
    --lane=*) lane="${1#--lane=}"; shift ;;
    --dir)
      [[ $# -ge 2 ]] || { echo "pclaude: --dir needs a value: the lane's checkout" >&2; exit 2; }
      lane_dir_flag="$2"; shift 2 ;;
    --dir=*) lane_dir_flag="${1#--dir=}"; shift ;;
    --no-lane) no_lane=true; shift ;;
    -h|--help)
      cat <<'EOF'
Usage: claude-profile {list|login|status|run} PROFILE [CLAUDE_ARGS...]
       pclaude PROFILE [CLAUDE_ARGS...]

Actions:
  list                 list configured profiles
  login PROFILE        authenticate a profile
  status PROFILE       show Claude auth status for a profile
  run PROFILE [ARGS]   launch Claude under the profile (the default action;
                        "run" itself may be omitted: claude-profile PROFILE)

Options:
  --lane <repo>-<n>    take this lane: hand the final launch to
                        `lane-start <repo>-<n> -- CLAUDE_ARGS` instead of
                        exec'ing Claude directly (also settable as
                        CLAUDE_LANE=<repo>-<n> in the environment).
                        lane-start renames the tmux window to the lane,
                        records the lane register row, and starts Claude
                        with --resume/--name <lane> under this same profile.
                        Requires lane-start on PATH (opensoft/brett-wip,
                        lanes/, linked by that repo's scripts/link-estates).
  --dir <path>         the lane's checkout, passed through to lane-start
                        (also settable as CLAUDE_LANE_DIR in the
                        environment). Without it the directory is derived —
                        see THE LANE'S DIRECTORY below.
  --no-lane            take no lane: exec Claude directly, whatever the
                        window or the swap record says (also settable as
                        CLAUDE_NO_LANE=1 in the environment). Wins over
                        --lane/CLAUDE_LANE.
  -h, --help           show this help

All four are LEADING options: they are read only before the action or the
profile, so everything meant for Claude itself is left untouched.

ONE WORD STARTS A LANE (Amendment 11(1)). `pclaude <profile>` is
`pclaude run <profile>`: a first word that is not one of the four actions is
taken as a profile, and only when it NAMES one. A word that is neither is
refused by name rather than launched as something else, and an option is never
read as a profile. The four action words win over a profile of the same name;
`pclaude run list` starts the profile called `list`.

THE LANE DEFAULT (lane-collision-protocol Amendment 8(c), Amendment 11(2)).
With no --lane, a `run` that starts a conversation resolves the lane itself:
the current tmux window's name when the lane register has a row for it, else
the lane this workstation last paused for a swap and has not resumed since
(handed over as --confirm, so lane-start asks before it takes the window; BOTH
answers start Claude, one of them with no lane). With neither, and with
--no-lane, behaviour is unchanged. There is no /restart on this path.

THE WINDOW IS REUSED (Amendment 11(2), act 1). Run inside tmux, this launcher
keeps the CURRENT window: it sets CLAUDE_CONFIG_DIR and execs in place, so the
window's name and its id survive a restart and the window name resolves the
lane with no question asked. Run outside tmux it creates a session of its own,
as before; that session's window is named for the command that made it, so
there the swap record is what binds. A window named for ANOTHER lane resolves
THAT lane — the window is the key — and --lane or --no-lane is the way out.

THE LANE'S DIRECTORY (Amendment 11(3)). lane-start's default is
$PROJECTS_ROOT/<repo>, and a checkout that is somewhere else used to end the
launch. --dir is passed when this launcher can learn it: --dir, else
CLAUDE_LANE_DIR, else a `dir <path>` field in the swap record, else one in the
register row, else the cwd's own checkout when its name IS the lane's <repo>
and the default does not exist (WORKBENCHES_CLAUDE_LANE_DIR_FROM_CWD=off turns
that last one off). Failing all of those, lane-start's default stands.

NOTHING HERE CAN CLOSE THE WINDOW. lane-start is run, never exec'd: if it
refuses — a directory that is not there, a lane held live elsewhere, a
declined confirm — its own refusal is printed and Claude starts bare in the
same window, with one line saying so.
EOF
      exit 0
      ;;
    *) break ;;
  esac
done
if [[ "$no_lane" == true ]]; then
  lane=""
fi

# ---------------------------------------------------------------------------
# ONE WORD STARTS A LANE — Amendment 11(1). `pclaude team03a` is
# `pclaude run team03a`. The verb was already optional in the sense that any
# unknown first word fell through to `run`, but it fell through UNCONDITIONALLY:
# `pclaude --resume` and `pclaude runn team03a` were both launched as a profile
# and both came back as "Unknown Claude profile: --resume", which names the
# wrong thing and points at nothing. So the fallthrough is now a decision with
# two tests, and the word has to pass both.
#
#   * an OPTION is never a profile. A leading `-` ends the option loop above
#     precisely because anything after it belongs to Claude; reading it as the
#     PROFILE, the one argument Claude never sees, is the one wrong answer.
#   * a profile is a word this launcher can RESOLVE. `profile_metadata` is the
#     same resolution `run` itself makes a line later — manifest first, then
#     the profile directories, names and aliases both — so one word starts
#     exactly the profiles `pclaude list` prints and nothing else.
#
# THE FOUR ACTION WORDS WIN. A profile called `run` or `status` is reachable
# only as `pclaude run run`, which is what the verb being optional means: the
# verb, where it is typed, is the verb. Ambiguity is decided in the one
# direction an operator can undo.
action="${1:-list}"
case "$action" in
  list|login|status|run)
    [[ $# -eq 0 ]] || shift ;;
  -*)
    echo "pclaude: '$action' is an option, not an action or a profile." >&2
    echo "Usage: claude-profile {list|login|status|run} PROFILE [CLAUDE_ARGS...]" >&2
    echo "       pclaude PROFILE [CLAUDE_ARGS...]   (leading options: --lane, --dir, --no-lane)" >&2
    exit 2 ;;
  *)
    if profile_metadata "$action" >/dev/null 2>&1; then
      action=run
    else
      # SPEC §1: "an unknown profile is still exit 2 with `Unknown Claude
      # profile: <name>`, which is what keeps a typo from silently becoming a
      # launch." The same words the `run` arm has always used for the same
      # situation, said one step earlier.
      echo "Unknown Claude profile: $action" >&2
      echo "  pclaude list   shows the profiles this machine has" >&2
      exit 2
    fi ;;
esac

case "$action" in
  list)
    {
      if [[ -f "$manifest" ]]; then
        jq -r '.profiles[] | [.name, .family, .email, ((.aliases // []) | join(","))] | @tsv' "$manifest"
      fi
      while IFS= read -r -d '' metadata; do
        jq -r '[.name,.family,.email,((.aliases // []) | join(","))] | @tsv' "$metadata"
      done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
    } | awk -F '\t' '!seen[tolower($1)]++'
    ;;
  login|status|run)
    profile="${1:?Usage: claude-profile $action PROFILE [arguments]}"; shift
    row="$(profile_metadata "$profile" || true)"
    [[ -n "$row" ]] || { echo "Unknown Claude profile: $profile" >&2; exit 2; }
    IFS=$'\t' read -r profile email family profile_path <<<"$row"
    config_dir="$base/profiles/$profile_path"
    [[ -d "$config_dir" ]] || { echo "Claude profile is not configured: $config_dir" >&2; exit 2; }
    [[ -n "$claude_bin" ]] || { echo "Claude CLI not found." >&2; exit 1; }
    export CLAUDE_PROFILE_NAME="$profile"
    configure_profile_runtime "$config_dir"
    load_profile_setup_token "$config_dir"
    shared_mcp=false
    if family_uses_shared_mcp "$family" && [[ -n "$mcp_sync" && -x "$mcp_sync" ]]; then
      shared_mcp=true
      "$mcp_sync" sync-claude-profile "$family" "$config_dir/.claude.json"
    fi
    case "$action" in
      login) CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" auth login --claudeai --email "$email" "$@" ;;
      status) CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" auth status "${@---text}" ;;
      run)
        if [[ -n "${lane:-}" ]]; then
          command -v lane-start >/dev/null 2>&1 || {
            echo "pclaude: --lane $lane needs lane-start on PATH. Fix:" >&2
            echo "  git clone git@github.com:opensoft/brett-wip.git ~/projects/brett-wip && ~/projects/brett-wip/scripts/link-estates" >&2
            exit 2
          }
        fi
        capture_lane_window
        if claude_run_is_interactive "$@"; then
          start_profile_tmux "$profile" "$@"
        fi
        export_tmux_identity
        if [[ "$shared_mcp" == true && "${1:-}" == mcp \
          && ( "${2:-}" == add || "${2:-}" == add-json ) ]]; then
          metadata="$config_dir/.claude.json"
          before="$(mktemp "$config_dir/.mcp-before.XXXXXX.json")"
          after="$(mktemp "$config_dir/.mcp-after.XXXXXX.json")"
          claude_mcp_snapshot "$metadata" "$before"
          managed_args=("$@")
          if ! claude_add_has_scope "$@"; then
            managed_args=(mcp "$2" --scope user "${@:3}")
          fi
          set +e
          CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" \
            --allow-dangerously-skip-permissions \
            --dangerously-skip-permissions \
            --permission-mode bypassPermissions \
            "${managed_args[@]}"
          command_status=$?
          set -e
          if [[ "$command_status" -eq 0 ]]; then
            claude_mcp_snapshot "$metadata" "$after"
            "$mcp_sync" import-claude-diff "$family" "$profile" "$before" "$after"
            "$mcp_sync" sync-claude-profile "$family" "$metadata"
          fi
          find "$before" "$after" -delete
          exit "$command_status"
        fi
        if [[ "$shared_mcp" == true && "${1:-}" == mcp && "${2:-}" == remove && -n "${3:-}" ]] \
          && "$mcp_sync" has "$family" "$3"; then
          "$mcp_sync" remove "$family" "$3"
          "$mcp_sync" sync-claude-profile "$family" "$config_dir/.claude.json"
          exit 0
        fi
        resolve_lane "$@"
        resolve_lane_dir
        lane_argv=(lane-start)
        # Amendment 11(3). `--dir` is lane-start's oldest option, but a
        # lane-start that somehow has none must not be handed one: the probe is
        # the same `--help` read `--confirm` uses, and it is made once.
        if [[ -n "${lane:-}" && -n "${lane_dir:-}" ]]; then
          if lane_start_supports --dir; then
            lane_argv+=(--dir "$lane_dir")
          else
            lane_dir=""
            lane_dir_source=""
          fi
        fi
        if [[ -n "${lane:-}" && "$lane_source" == record ]]; then
          # A lane read from the record is a guess about a window nobody has
          # named yet, so lane-start must ask before it takes it — and a
          # lane-start that cannot ask is not handed the guess at all. One
          # operator, one situation, ONE line, and it names the lane it left
          # (F-W3).
          if lane_start_supports --confirm; then
            lane_argv+=(--confirm)
          else
            lane_note_no_lane "$lane is the lane this workstation last paused for a swap, but this lane-start cannot ask before it takes a window (no --confirm), so it is left"
            lane=""
          fi
        fi
        # `--yes` is passed nowhere (F-W2, F-T8): it is inert in lane-start
        # unless `--confirm` came with it, and `--confirm` is the one case it
        # must never come with, since answering the question in advance is the
        # opposite of asking it. A window lane and an operator's `--lane` go
        # over bare — byte-for-byte what `--lane` did before this default
        # existed.
        claude_flags=(--allow-dangerously-skip-permissions
                      --dangerously-skip-permissions
                      --permission-mode bypassPermissions)
        # Published only once every part of it is settled: the lane, where it
        # came from, the window's address, and the directory that is actually
        # being passed rather than the one that was merely derived.
        export_lane_identity
        if [[ -n "${lane:-}" ]]; then
          # LANE-START IS RUN, NEVER EXEC'D — A8 Addendum 2 R-A8-3, widened to
          # every lane source by Amendment 11(3).
          #
          # Under Amendment 8 only the confirm path ran it; `--lane` and the
          # window name were `exec`ed, byte-for-byte as `--lane` always had
          # been. Then `pclaude --lane openXfactory-5 run team01l` met a lane
          # whose checkout is not `$PROJECTS_ROOT/<repo>`: lane-start exited 1
          # with "no such directory … pass --dir", the exec'd process was the
          # only command of the tmux session the launcher had just made, and
          # tmux printed `[exited]` over a window with no Claude in it
          # (new-workstation#20, Evidence 2). An exec cannot catch anything, so
          # the one place that could keep that window alive was gone before the
          # refusal happened. There is no lane source for which that trade is
          # worth making, so there is now one path for all of them.
          set +e
          CLAUDE_CONFIG_DIR="$config_dir" CLAUDE_BIN="$claude_bin" \
            "${lane_argv[@]}" "$lane" -- "${claude_flags[@]}" "$@"
          lane_status=$?
          set -e
          # WHICH STATUSES ARE LANE-START'S OWN. It documents exactly two:
          # 1 environment — not inside tmux, no register, NO SUCH DIRECTORY —
          # and 2 refusal — an argument error, a name a window cannot take, a
          # lane live in another window. In both, nothing was renamed, nothing
          # was written and Claude never started. Every other status came from
          # a Claude that lane-start exec'd, and is this launcher's status too;
          # so is 0, which is also how a lane-start that DECLINED the confirm
          # question reports having launched Claude bare itself. Starting a
          # second Claude behind either would be worse than the dead end this
          # catches.
          #
          # 1 and 2 are also statuses a Claude can return on its own, and the
          # window is what tells the two apart: taking a lane renames the
          # window to it (Amendment 5(f)), and a lane-start that never took one
          # left the name alone. That read is EXACT wherever the window was not
          # already the lane's — the `--lane`, record and no-window paths, which
          # is every path a restart can close a window on. Where the window was
          # ALREADY the lane (the window default, Amendment 11(2)) the rename
          # is a no-op and the read cannot separate them: there the status is
          # handed back, because the launcher is a command in an existing
          # window's shell there and a refusal returns the operator to the
          # prompt with lane-start's own words above it — while a bare Claude
          # started behind a session that may still be the lane's would mint a
          # new transcript in the lane's own window, which is the lineage fault
          # the whole protocol exists to prevent.
          if [[ "$lane_status" -eq 0 ]] \
            || { [[ "$lane_status" -ne 1 && "$lane_status" -ne 2 ]]; } \
            || lane_window_is "$lane"; then
            exit "$lane_status"
          fi
          # lane-start's own refusal is already on the terminal: it is never
          # captured here, so nothing swallows it and nothing repeats it. This
          # is the launcher's one line beside it (F-W3), and it says what
          # happens next.
          lane_note_no_lane "lane-start did not take $lane (exit $lane_status); starting Claude with no lane in this window"
          # And this session is not in that lane, so nothing downstream may
          # read that it is — the usage guard's automatic swap would otherwise
          # write a PAUSED record for a lane this window never took.
          unset WORKBENCHES_CLAUDE_LANE WORKBENCHES_CLAUDE_LANE_SOURCE \
                WORKBENCHES_CLAUDE_LANE_DIR
        fi
        CLAUDE_CONFIG_DIR="$config_dir" exec "$claude_bin" "${claude_flags[@]}" "$@"
        ;;
    esac
    ;;
  *) echo "Usage: claude-profile {list|login|status|run} [PROFILE]" >&2; exit 2 ;;
esac
