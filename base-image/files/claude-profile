          managed_args=("$@")
          if ! claude_add_has_scope "$@"; then
            managed_args=(mcp "$2" --scope user "${@:3}")
          fi
          set +e
          CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" \
            --allow-dangerously-skip-permissions \
            --dangerously-skip-permissions \
            --permission-mode bypassPermissions \
            "${managed_args[@]}"
          command_status=$?
          set -e
          if [[ "$command_status" -eq 0 ]]; then
            claude_mcp_snapshot "$metadata" "$after"
            "$mcp_sync" import-claude-diff "$family" "$profile" "$before" "$after"
            "$mcp_sync" sync-claude-profile "$family" "$metadata"
          fi
          find "$before" "$after" -delete
