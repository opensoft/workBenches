#!/usr/bin/env bash
set -euo pipefail

manifest="${CLAUDE_PROFILES_MANIFEST:-${XDG_CONFIG_HOME:-$HOME/.config}/workbenches/claude-profiles.json}"
base="${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}"
command -v jq >/dev/null 2>&1 || { echo "jq is required." >&2; exit 1; }

# lane-collision-protocol Amendment 8(e), as ruled by A8 Addendum 2 R-A8-5(b).
# Claude reads THIS launcher's per-profile config dir (every exec below carries
# CLAUDE_CONFIG_DIR="$config_dir"), so a SessionStart hook installed in
# ~/.claude/settings.json is never read under `pclaude run` and the entry has
# to be ensured in the profile's own settings instead.
#
# The three values below ARE the canonical entry — ruled 2026-09-12 by the
# orchestrator of the Amendment 8 round, with clause (e)'s text to be changed
# to quote them byte for byte — and the command string is the idempotence key,
# so it is not varied by anything downstream of this line. No `bash -lc`, which
# would source a login profile in front of every session start; no
# `2>/dev/null`, since every line the subcommand prints goes to stderr and the
# block is the point; `|| true` stays by that ruling, because a hook in front
# of every session start is tolerant by construction. `"timeout": 5` is part of
# the entry and not decoration: it is the outer bound on the one path that must
# never hang.
#
# `|| true` swallows the STATUS of a lanes-edit.sh that has no `session-start`
# subcommand; it does not swallow the usage block such a one prints, and that
# block would appear in front of every session on the workstation until the
# brett-wip half lands (F-S4). So the entry is also gated on the subcommand
# existing — an install-time probe, below, which changes nothing about the
# string it writes. The tilde is the harness's to expand;
# `lane_session_start_script` is the same path again, for this script's own
# reads of it.
#
# `scripts/setup-claude-profiles.sh` carries its own copy of these same three
# values (RV-W2, workBenches#63 re-verification; new-workstation#16 adoption
# act 6) so a bare `claude` run — the one case that script's
# `$default_claude_dir/settings.json` exists for — gets this entry too, not
# only the profiles this launcher execs into. Change the string here and there
# together; it is the idempotence key in both files.
lane_session_start_script="$HOME/projects/xFactory/lanes-edit.sh"
lane_session_start_command='~/projects/xFactory/lanes-edit.sh session-start || true'
lane_session_start_matcher='startup|resume|clear|fork'
lane_session_start_timeout=5
# Set by configure_profile_runtime: true when the entry is in this profile's
# settings AND the subcommand it calls exists, i.e. when the hook will speak in
# the session this launch is about to start. Amendment 8(e) makes that hook the
# only no-lane notice in the estate, so the launcher's own note stands down
# against it (lane_note_no_lane).
lane_session_start_ensured=false

# Ensuring it is an append, matched by the EXACT command string: an entry that
# already carries it is left exactly as it is — wherever it sits, whatever
# matcher it shares, whatever else the operator put beside it — and nothing
# else under .hooks is touched. Reused verbatim by both branches below.
lane_session_start_jq='
      .hooks = (.hooks // {})
      | .hooks.SessionStart = (
          (.hooks.SessionStart // []) as $entries
          | if ([$entries[]? | (.hooks // [])[]? | .command] | index($session_start))
            then $entries
            else $entries + [{
              matcher: $session_start_matcher,
              hooks: [{type: "command", command: $session_start, timeout: $session_start_timeout}]
            }]
            end
        )'

configure_profile_runtime() {
  local config_dir="$1" statusline_source statusline_link settings settings_tmp statusline_command default_model
  local guard_source guard_link guard_command guard_ok guard_timeout session_start_ok

  statusline_source="$base/shared/statusline-command.sh"
  if [[ ! -f "$statusline_source" && -f /usr/local/share/workbenches/claude/statusline-command.sh ]]; then
    statusline_source=/usr/local/share/workbenches/claude/statusline-command.sh
  fi

  if [[ -f "$statusline_source" ]]; then
    statusline_link="$config_dir/statusline-command.sh"
    if [[ -L "$statusline_link" || ! -e "$statusline_link" ]]; then
      ln -sfn "$statusline_source" "$statusline_link"
    fi
  fi

  # usage/context guard hook (shared, symlinked like the status line). The
  # model cannot read its own context or rate limits; this hook injects them
  # when a threshold is crossed. Gated per project by
  # <cwd>/.claude/usage-guard.on, so it is silent unless armed.
  guard_source="$base/shared/usage-guard.sh"
  if [[ ! -f "$guard_source" && -f /usr/local/share/workbenches/claude/usage-guard.sh ]]; then
    guard_source=/usr/local/share/workbenches/claude/usage-guard.sh
  fi
  guard_ok=false
  if [[ -f "$guard_source" ]]; then
    guard_link="$config_dir/usage-guard.sh"
    if [[ -L "$guard_link" || ! -e "$guard_link" ]]; then
      ln -sfn "$guard_source" "$guard_link"
    fi
    guard_ok=true
  fi

  # The SessionStart hook is ensured only where the estate it calls can answer
  # it: the script has to be there, and it has to HAVE the subcommand. On
  # opensoft/brett-wip `main` today it does not, and an entry written against
  # it would spend a process per session start printing a usage block. The
  # probe is one local grep of one regular file — no execution, no network, and
  # no way to hang — and a later install is picked up by the next run, because
  # this runs on every one.
  session_start_ok=false
  if [[ -f "$lane_session_start_script" ]] \
    && grep -qF 'session-start' "$lane_session_start_script" 2>/dev/null; then
    session_start_ok=true
  fi

  settings="$config_dir/settings.json"
  if [[ -e "$settings" ]] && ! jq -e 'type == "object"' "$settings" >/dev/null 2>&1; then
    echo "Claude profile settings are not valid JSON: $settings" >&2
    return 1
  fi

  statusline_command='bash "${CLAUDE_CONFIG_DIR}/statusline-command.sh"'
  default_model='claude-fable-5-1'
  guard_command='bash "${CLAUDE_CONFIG_DIR}/usage-guard.sh"'
  # SPEC §9 keeps the guard a HOOK and nothing more: "it cannot act, it can
  # only put one line into the session's context, and it must stay latched,
  # gated and fail-quiet". The automatic swap is therefore the guard's top
  # threshold line turning from advice into a directive and the SESSION
  # performing `/lane-swap` — no register write, no git, no network behind a
  # prompt submit. So 5 seconds remains the outer bound on everything this hook
  # can be asked to do, and the entry is unchanged by Amendment 11.
  guard_timeout=5
  settings_tmp="$(mktemp "$config_dir/.settings.XXXXXX.tmp")"
  if [[ -f "$settings" ]]; then
    jq --arg command "$statusline_command" --arg model "$default_model" \
       --arg guard "$guard_command" --argjson guard_ok "$guard_ok" \
       --argjson guard_timeout "$guard_timeout" \
       --arg session_start "$lane_session_start_command" \
       --arg session_start_matcher "$lane_session_start_matcher" \
       --argjson session_start_timeout "$lane_session_start_timeout" \
       --argjson session_start_ok "$session_start_ok" '
      .statusLine = {type: "command", command: $command, refreshInterval: 10}
      | .permissions = (.permissions // {})
      | .permissions.defaultMode = "bypassPermissions"
      | .effortLevel = (.effortLevel // "xhigh")
      | .model = (.model // $model)
      | (if $guard_ok then
            .hooks = (.hooks // {})
            | .hooks.UserPromptSubmit = [{hooks: [{type: "command", command: $guard, timeout: $guard_timeout}]}]
         else . end)
      | (if $session_start_ok then'"$lane_session_start_jq"' else . end)
    ' "$settings" > "$settings_tmp"
  else
    jq -n --arg command "$statusline_command" --arg model "$default_model" \
       --arg guard "$guard_command" --argjson guard_ok "$guard_ok" \
       --argjson guard_timeout "$guard_timeout" \
       --arg session_start "$lane_session_start_command" \
       --arg session_start_matcher "$lane_session_start_matcher" \
       --argjson session_start_timeout "$lane_session_start_timeout" \
       --argjson session_start_ok "$session_start_ok" '{
      statusLine: {type: "command", command: $command, refreshInterval: 10},
      permissions: {defaultMode: "bypassPermissions"},
      effortLevel: "xhigh",
      model: $model
    }
    | (if $guard_ok then
          .hooks = {UserPromptSubmit: [{hooks: [{type: "command", command: $guard, timeout: $guard_timeout}]}]}
       else . end)
    | (if $session_start_ok then'"$lane_session_start_jq"' else . end)' > "$settings_tmp"
  fi
  chmod 600 "$settings_tmp"
  mv -f "$settings_tmp" "$settings"
  # RV-W1 (workBenches#63 re-verification): set only now, for THIS profile,
  # after its settings.json actually carries the entry — not at probe time.
  # A probe of the estate says the entry CAN be ensured; it says nothing about
  # a profile that has not been through this function yet, and the two came
  # apart the moment the probe could answer true for every profile: a fresh
  # profile's first launch would print neither the launcher's no-lane notice
  # nor the hook's block, because lane_note_no_lane stood down on the probe
  # while the write that makes it true had not happened yet. One launch,
  # self-healing on the next (this function runs on every one) — but the
  # ruling is that the flag names what THIS run wrote, not what the estate
  # merely allows.
  lane_session_start_ensured="$session_start_ok"
}

load_profile_setup_token() {
  local config_dir="$1" token_file mode
  token_file="$config_dir/.setup-token"
  [[ -e "$token_file" ]] || return 0
  [[ -f "$token_file" && ! -L "$token_file" ]] || {
    echo "Claude profile setup token must be a regular file: $token_file" >&2
    return 1
  }
  mode="$(stat -c '%a' "$token_file")"
  [[ "$mode" == 600 ]] || {
    echo "Claude profile setup token must have mode 0600: $token_file" >&2
    return 1
  }
  IFS= read -r CLAUDE_CODE_OAUTH_TOKEN < "$token_file"
  [[ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]] || {
    echo "Claude profile setup token is empty: $token_file" >&2
    return 1
  }
  export CLAUDE_CODE_OAUTH_TOKEN
}

claude_bin="${CLAUDE_BIN:-$(command -v claude || true)}"
if [[ -z "$claude_bin" && -x "$HOME/.local/bin/claude" ]]; then
  claude_bin="$HOME/.local/bin/claude"
fi
mcp_sync="${WORKBENCHES_MCP_SYNC_BIN:-$(command -v workbenches-mcp-sync || true)}"
if [[ -z "$mcp_sync" ]]; then
  launcher_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  [[ -x "$launcher_dir/workbenches-mcp-sync" ]] && mcp_sync="$launcher_dir/workbenches-mcp-sync"
fi

family_uses_shared_mcp() {
  local family="$1"
  local configured=",${WORKBENCHES_SHARED_MCP_FAMILIES:-opensoft},"
  [[ "$configured" == *",$family,"* ]]
}

claude_mcp_snapshot() {
  local metadata="$1" output="$2"
  if [[ -f "$metadata" ]]; then
    jq '{mcpServers: (.mcpServers // {})}' "$metadata" >"$output"
  else
    printf '%s\n' '{"mcpServers":{}}' >"$output"
  fi
  chmod 0600 "$output"
}

claude_add_has_scope() {
  local argument
  for argument in "$@"; do
    [[ "$argument" == --scope || "$argument" == -s || "$argument" == --scope=* ]] && return 0
  done
  return 1
}

# The first Claude argument says whether this launch is a conversation at all.
# `mcp`, `doctor`, `--version` and the other subcommands and one-shots are not,
# so they are neither wrapped in a tmux session of their own nor handed to
# lane-start by the lane default below.
claude_args_start_session() {
  case "${1:-}" in
    mcp|plugin|plugins|doctor|install|update|--help|-h|--version|-v|--print|-p)
      return 1
      ;;
  esac
  return 0
}

claude_run_is_interactive() {
  [[ -t 0 && -t 1 ]] || return 1
  [[ "${WORKBENCHES_CLAUDE_TMUX:-auto}" != off ]] || return 1
  [[ -z "${WORKBENCHES_CLAUDE_TMUX_CHILD:-}" ]] || return 1
  [[ -z "${TMUX:-}" ]] || return 1
  claude_args_start_session "$@"
}

# ---------------------------------------------------------------------------
# ACT 1 — THE LAUNCHER REUSES THE TMUX WINDOW (Amendment 11(b) act 1, SPEC §3).
#
# Inside tmux this is already true and is now a contract rather than an
# accident: no session is created, the launch happens in the current window,
# and the launcher NEVER renames it — renaming is lane-start's act alone
# (Amendment 5(f)) — so the name and the `@id` both survive a restart and
# precedence 2 answers with nothing asked.
#
# Outside tmux there is no window to keep, and act 1 is three steps:
#
#   1. RESOLVE THE LANE BEFORE THE SESSION IS CREATED. Today the resolution
#      happens in the child, after the session exists, which is why the child
#      has to be handed the parent's window name at all. Out here precedences 1,
#      4 and 5 answer as they do today, and precedence 3 — which has no `<@id>`
#      to compare, there being no window this process is standing in — is tried
#      on the RECORD's `<session>:<index>` alone and only where tmux resolves it
#      NOW. Where nothing resolves, step 3 gives no answer at all; it is not
#      "matched loosely".
#   2. REUSE THE RECORDED WINDOW WHERE IT STILL EXISTS. Respawn that window's
#      pane with the launch command and attach to its session instead of making
#      one. The name and the id both survive, and the lane's next record writes
#      the same id back. Where the id names no window, nothing is lost: step 3.
#   3. OTHERWISE CREATE THE SESSION AS BEFORE, naming its window for the lane at
#      birth ONLY for a lane nobody has to confirm.
#
# WHAT THE PARENT RESOLVES IS NEVER HANDED DOWN AS THE ANSWER. The lane found
# here decides which window to reuse and nothing else: it is not exported as
# CLAUDE_LANE and not passed as `--lane`, so a lane that came from the
# newest-first guess still reaches lane-start as `--confirm` in the child and is
# still asked about. Pre-answering that question in the parent is exactly what
# act 1 step 3's fence exists to prevent, and it would be no better done here.

act1_reuse_lane=""
act1_reuse_pane=""
act1_reuse_window=""
act1_reuse_session=""
act1_reuse_name=""
act1_reuse_ref=""
act1_reuse_id=""
act1_reuse_kill=false
act1_start_dir=""

act1_window_probe() {
  # One read of one window, by whichever ref names it: `<@id>` or
  # `<session>:<index>`. Prints `<@id>|<session>:<index>|<%pane>|<name>` and
  # exits non-zero where tmux resolves nothing — which IS the answer whenever a
  # record names a window that is gone, and the reason the match is fenced on
  # liveness at all: a `<session>:<index>` is reused the instant a window closes
  # and the next one takes its index, so matching a dead ref is how a lane would
  # bind to a stranger's pane.
  tmux display-message -p -t "$1" \
    '#{window_id}|#{session_name}:#{window_index}|#{pane_id}|#{window_name}' \
    2>/dev/null
}

act1_resolve_lane() {
  # ACT 1 STEP 1. Sets `act1_reuse_lane`, which is used for step 2 and for
  # nothing else. Precedence 1 first — the operator's own word, the only lane
  # that is certain out here. Then precedence 3 on the records' own window refs,
  # newest first, taking the first record whose window tmux resolves NOW. Then
  # precedence 4, the newest swap, which is a guess and is treated as one.
  local row ref probe
  act1_reuse_lane=""
  [[ "${no_lane:-false}" == false ]] || return 0
  if [[ -n "${lane:-}" ]]; then
    act1_reuse_lane="$lane"
    return 0
  fi
  claude_args_start_session "$@" || return 0
  command -v lane-start >/dev/null 2>&1 || return 0
  swapped_read
  [[ "${swapped_status:-8}" -eq 0 && -n "${swapped_rows:-}" ]] || return 0
  while IFS= read -r row; do
    [[ "$row" == *$'\t'* ]] || continue
    for ref in $(printf '%s' "$row" | cut -f 3); do
      probe="$(act1_window_probe "$ref" || true)"
      [[ -n "$probe" ]] || continue
      act1_reuse_lane="${row%%$'\t'*}"
      [[ "$act1_reuse_lane" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || act1_reuse_lane=""
      [[ -z "$act1_reuse_lane" ]] || return 0
    done
  done <<< "$swapped_rows"
  # Precedence 3 answered nothing: no record names a window that still exists.
  # Precedence 4's newest row is the guess, and it is only ever a reuse
  # candidate here — the child asks about it.
  row="$(printf '%s\n' "$swapped_rows" | head -n 1)"
  [[ "$row" == *$'\t'* ]] || return 0
  act1_reuse_lane="${row%%$'\t'*}"
  [[ "$act1_reuse_lane" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || act1_reuse_lane=""
  return 0
}

act1_find_window() {
  # ACT 1 STEP 2's probe. Sets `act1_reuse_*` where the lane's own swap record
  # names a window that STILL EXISTS, and leaves them empty otherwise.
  local lane_name="$1" row window_field ref probe want
  act1_reuse_pane=""; act1_reuse_window=""; act1_reuse_session=""
  act1_reuse_name=""; act1_reuse_ref=""; act1_reuse_id=""; act1_reuse_kill=false
  [[ -n "$lane_name" ]] || return 1
  [[ "${WORKBENCHES_CLAUDE_WINDOW_REUSE:-on}" != off ]] || return 1
  row="$(lane_swapped_row "$lane_name" || true)"
  [[ -n "$row" ]] || return 1
  window_field="$(printf '%s' "$row" | cut -f 3)"
  [[ -n "$window_field" ]] || return 1
  # The `<@id>` is tried FIRST and the `<session>:<index>` second — clause (b)'s
  # own order, and the id is the better key because it is never reissued for the
  # life of the server. A probe that answers must answer about the ref it was
  # ASKED about: tmux resolves `<session>:<index>` to whatever holds that index
  # now, so the returned ref is compared back against the one we asked for.
  for want in $(printf '%s' "$window_field" | tr ' \t' '\n\n' | grep '^@[0-9]\+$' || true) \
              $(printf '%s' "$window_field" | tr ' \t' '\n\n' | grep -v '^@[0-9]\+$' || true); do
    [[ -n "$want" ]] || continue
    probe="$(act1_window_probe "$want" || true)"
    [[ -n "$probe" ]] || continue
    ref="${probe%%|*}"
    if [[ "$want" == @* ]]; then
      [[ "$ref" == "$want" ]] || continue
    else
      [[ "$(printf '%s' "$probe" | cut -d '|' -f 2)" == "$want" ]] || continue
    fi
    act1_reuse_id="$ref"
    act1_reuse_ref="$(printf '%s' "$probe" | cut -d '|' -f 2)"
    act1_reuse_pane="$(printf '%s' "$probe" | cut -d '|' -f 3)"
    act1_reuse_name="$(printf '%s' "$probe" | cut -d '|' -f 4-)"
    act1_reuse_window="$act1_reuse_ref"
    act1_reuse_session="${act1_reuse_ref%:*}"
    break
  done
  [[ -n "$act1_reuse_pane" ]] || return 1

  # WHOSE PANE IS IT. Killing somebody else's pane to reuse its window is the
  # one act Amendment 8(f) refuses by name, and a record can outlive the window
  # it names being given to another lane: `lane-start` renames a window to the
  # lane when it takes it (Amendment 5(f)), so the window's CURRENT NAME is the
  # estate's own word about whose it is now.
  #
  #   * the name IS this lane's  → the pane's own process is the session this
  #     restart replaces, which is the text's condition for `-k`, and the
  #     ordinary state right after a swap because /lane-swap kills nothing.
  #   * the name is ANOTHER LANE'S, per the register  → this window is not ours
  #     to take at all. Do not reuse it; step 3 makes a session.
  #   * anything else — no name, an unreadable one, a name the register does not
  #     know  → not provably another lane's and not provably ours, so never
  #     `-k`: a plain `respawn-pane` on a live pane exits 1, which is not an
  #     error to report but the window being in use, and step 3 follows.
  if [[ "$act1_reuse_name" == "$lane_name" ]]; then
    act1_reuse_kill=true
  elif [[ -n "$act1_reuse_name" ]]; then
    local lanes_edit
    lanes_edit="$(lanes_edit_bin || true)"
    if [[ -n "$lanes_edit" ]] \
      && LANES_NO_FETCH=1 "$lanes_edit" register-row "$act1_reuse_name" >/dev/null 2>&1; then
      act1_reuse_pane=""
      return 1
    fi
  fi
  return 0
}

act1_resolve_start_dir() {
  # THE START DIRECTORY OF THE WINDOW ACT 1 IS ABOUT TO CREATE OR RESPAWN —
  # Evidence 3. Without it the session is keyed to the terminal the operator
  # happened to type in (`/workspace`, in the evidence), and the harness reads
  # its instructions and memory from there.
  #
  # ONLY FOR A LANE THIS SIDE IS CERTAIN OF, which is the same fence act 1 step
  # 3 already applies to the window's NAME, for the same reason: `--lane` /
  # `CLAUDE_LANE` is the operator's word, and a window whose pane step 2 is
  # reusing was matched from that lane's own record. The newest-first guess of
  # precedence 4 names no directory here — the child resolves the lane, asks
  # about it through `--confirm`, and enters the directory itself.
  local certain="" saved_lane
  act1_start_dir=""
  if [[ -n "${lane_dir_flag:-}" ]]; then
    act1_start_dir="$lane_dir_flag"
  elif [[ -n "${CLAUDE_LANE_DIR:-}" ]]; then
    act1_start_dir="$CLAUDE_LANE_DIR"
  else
    if [[ -n "${lane:-}" ]]; then
      certain="$lane"
    elif [[ -n "$act1_reuse_pane" && -n "$act1_reuse_lane" ]]; then
      certain="$act1_reuse_lane"
    fi
    [[ -n "$certain" ]] || return 0
    saved_lane="${lane:-}"
    lane="$certain"
    resolve_lane_dir
    lane="$saved_lane"
    act1_start_dir="${lane_dir:-}"
    # What this side resolved decides a START DIRECTORY and nothing else — the
    # same rule act 1 step 1 holds for the lane. The child re-reads the order
    # for itself and is the one that refuses a directory that is gone, where it
    # can name the lane it belongs to.
    lane_dir=""
    lane_dir_source=""
  fi
  # tmux refuses a `-c` that is not a directory and the whole launch would fail
  # with it. A directory that is gone is the CHILD's refusal to make.
  [[ -n "$act1_start_dir" && -d "$act1_start_dir" ]] || act1_start_dir=""
  return 0
}

# THE CHILD'S ENVIRONMENT AND ITS ARGV, COMPOSED FROM WHAT IS TRUE *NOW*.
#
# This is called TWICE, and the second call is the fix for a real defect. Act 1
# step 2 copies the recorded window's name and address into `lane_window*` the
# moment `act1_find_window` succeeds, and they are threaded to the child here.
# If the `respawn-pane` then FAILS — a live pane that is not provably this
# lane's, a tmux that refuses the option twice — the launch falls through to
# step 3 and creates a BRAND-NEW session, and the child in that new window was
# still being handed `WORKBENCHES_CLAUDE_WINDOW`/`_REF`/`_ID` for the window it
# is not in. The swap record that child later writes names that window, where
# the amendment makes the `window` sub-field a fact about the writer's own
# window (#21 clause (c), `:687-692` at `0e40d6e` — the merge that put the
# ratified text on `brettheap/new-workstation` main as
# `home/.agents/protocols/lane-collision-protocol-amendment-11.md`) — a lie in
# an append-only log, and one that would send the next restart's precedence 3
# at a stranger's pane.
#
# THE CITATION NAMES A CLAUSE AND A HEAD, and that is round 4's own finding
# rather than a style note. It gave `:630-635` and no head, and MEASURED THAT
# PARAGRAPH HAS NOW MOVED THREE TIMES: `:630` at `2fc8db4` (where the citation
# was written and true), `:642` at `1f88a12`, `:663` at `e7b639e` and `:687` on
# `main` at `0e40d6e`. THE THIRD MOVE WAS THE RATIFICATION ITSELF — the commit
# that flipped the Status line to `in force` also added the Amendments 12 and 13
# reconciliation section — so a text going in force does not freeze its line
# numbers, it shifts them one last time. A reader checking this comment against
# the landed text at the number it FIRST gave would land 57 lines short, in the
# middle of clause (c)'s `STARTED`/`RESUMED` preamble, and read something that
# does not say what this comment says it says. That is `CF2-W1`'s defect one
# size smaller — a sentence about another document that the other document no
# longer supports — and the fix is the same shape: the CLAUSE is the anchor,
# because clause letters do not move, and a line number is only readable beside
# the head it was read at. Section 0 of the launcher's suite refuses a bare one
# over all eight artefacts this PR ships.
#
# AND THAT TEXT IS NO LONGER A DRAFT. Amendment 11 was RATIFIED by Brett Heap
# 2026-09-13T19:41:04Z, verbatim "ratify 21 and 71 when ready"
# (brettheap/new-workstation#20 issuecomment-5655633533), and LANDED as
# `0e40d6e` with the ratification commit `f12f96b`: the file named above is on
# main, its Status line reads `in force`, and that path — not a PR diff — is
# where a reader of this comment goes. THAT WORD DOES NOT RATIFY THIS FILE: the
# amendment's own ratified list says the launcher half "lands under the same
# word when its own confirmation says READY, and at this head it does not", so
# this PR is still under review and no line here may say otherwise.
#
# So the fall-through CLEARS the three and composes again. Recomposing is the
# whole reason this is a function: `command_string` is built from `env_prefix`,
# and a `command_string` built before the failure cannot be corrected after it.
act1_compose_child_command() {
  env_prefix=(env WORKBENCHES_CLAUDE_TMUX_CHILD=1)
  # THE WORKSTATION, THREADED INTO THE SESSION THIS LAUNCH CREATES (`R-A11-14`).
  # `lane_export_workstation` has already exported it on this side of the
  # re-exec; tmux does not reliably hand a freshly-exported variable to a new
  # session on an already-running server, which is why every other value below
  # is threaded explicitly, and this one is what every WRITER in the session
  # reads — a session that comes up without it can write no lane record at all.
  [[ -z "${LANES_WORKSTATION:-}" ]] || env_prefix+=("LANES_WORKSTATION=$LANES_WORKSTATION")
  # --lane/CLAUDE_LANE must survive this re-exec into a new tmux session.
  # tmux does not reliably hand a freshly-exported variable to a new session
  # on an already-running server, so it is threaded through explicitly here
  # rather than relied on via inheritance — same idiom as the guard above.
  [[ -n "${lane:-}" ]] && env_prefix+=("CLAUDE_LANE=$lane")
  [[ "${no_lane:-false}" == true ]] && env_prefix+=("CLAUDE_NO_LANE=1")
  # So must the name of the window this was typed in — or, on the reuse path,
  # the name of the window being reused. A session created fresh below has its
  # window named for the command that made it unless the lane is certain, so the
  # child must read what was captured on this side of the re-exec instead of
  # asking tmux again (capture_lane_window).
  [[ -n "${lane_window:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW=$lane_window")
  # The window's ADDRESS travels the same way, and for the same reason. It is
  # information (Amendment 11(5): the id is stored, the NAME stays the key) —
  # the swap record's `window <session>:<index> <@id>` field.
  [[ -n "${lane_window_ref:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW_REF=$lane_window_ref")
  [[ -n "${lane_window_id:-}" ]] && env_prefix+=("WORKBENCHES_CLAUDE_WINDOW_ID=$lane_window_id")
  # And the lane's directory, when the operator named one — IN EITHER OF ITS
  # TWO SPELLINGS. `--dir` is this launcher's own option, so nothing downstream
  # would see it otherwise; and `CLAUDE_LANE_DIR`, which `--help` advertises as
  # the same thing, is lost here too unless it is threaded. `tmux new-session`
  # hands the command the SERVER's environment, not this client's, so a variable
  # the operator exported in their own shell reaches the child only if it is
  # written into the command string — which is the reason every other value
  # above is. `--dir` wins where both are given, exactly as the directory
  # order's rung 1 has it.
  [[ -n "${lane_dir_flag:-${CLAUDE_LANE_DIR:-}}" ]] \
    && env_prefix+=("CLAUDE_LANE_DIR=${lane_dir_flag:-${CLAUDE_LANE_DIR:-}}")

  command_string=""
  for argument in "${env_prefix[@]}" "$launcher" run "$profile" "$@"; do
    printf -v argument '%q' "$argument"
    command_string+="${command_string:+ }$argument"
  done
}

start_profile_tmux() {
  local profile="$1"
  shift
  local launcher session_name command_string="" argument reuse_status
  local -a env_prefix
  # AMENDMENT 11(2), ACT 1 — THE WINDOW IS REUSED, NEVER REPLACED.
  # This function exists for the launch that came from NO tmux window. Called
  # from inside tmux it would replace the lane's own window with a brand-new
  # session, and the lane's name and id — the two things precedence 2 and the
  # swap record are keyed on — would not survive the restart.
  # `claude_run_is_interactive` already requires an empty $TMUX, so this is
  # unreachable today; it is here because the property is the amendment and not
  # an emergent consequence of that function's fourth test, and a refactor that
  # loses it must fail loudly rather than quietly start creating sessions again.
  [[ -z "${TMUX:-}" ]] || {
    echo "pclaude: refusing to create a tmux session from inside one; the lane's window is reused (Amendment 11(2))." >&2
    return 1
  }
  command -v tmux >/dev/null 2>&1 || {
    echo "pclaude: tmux is required for interactive profile launches." >&2
    return 1
  }

  # ACT 1 STEPS 1 AND 2, in that order and before anything is created.
  act1_resolve_lane "$@"
  if act1_find_window "$act1_reuse_lane"; then
    # The window survives, so the values the child is handed are ITS values and
    # not the empty ones this side of a launch outside tmux would otherwise
    # thread: the child comes up in a real window whose name and id the estate
    # already knows, and binds by precedence 2 or 3 with nothing asked.
    lane_window="$act1_reuse_name"
    lane_window_ref="$act1_reuse_ref"
    lane_window_id="$act1_reuse_id"
  fi
  # ...and the directory that window is to stand in (Evidence 3), which needs
  # step 2's answer and so is resolved after it.
  act1_resolve_start_dir

  launcher="$(readlink -f "${BASH_SOURCE[0]}")"
  session_name="claude-${profile//[^a-zA-Z0-9_-]/-}-$(date +%Y%m%d%H%M%S)-$$"
  act1_compose_child_command "$@"

  # ACT 1 STEP 2 — RESPAWN THE RECORDED WINDOW'S PANE AND ATTACH TO ITS SESSION.
  # `-c` THE LANE'S OWN DIRECTORY where act 1 learnt one (Evidence 3): without
  # it the pane keeps whatever start directory it was born with, which is the
  # lane's tree only if the window was made for the lane in the first place —
  # and Evidence 3 is a window that was not. A non-zero status is NOT an error
  # to report — on a live pane a plain `respawn-pane` exits 1 saying the pane
  # is still active, which is the launcher being told the window is in use — so
  # it falls to step 3 and makes a session.
  if [[ -n "$act1_reuse_pane" ]]; then
    local -a respawn_dir=()
    [[ -z "$act1_start_dir" ]] || respawn_dir=(-c "$act1_start_dir")
    set +e
    if [[ "$act1_reuse_kill" == true ]]; then
      tmux respawn-pane -k ${respawn_dir[@]+"${respawn_dir[@]}"} -t "$act1_reuse_pane" "$command_string" >/dev/null 2>&1
    else
      tmux respawn-pane ${respawn_dir[@]+"${respawn_dir[@]}"} -t "$act1_reuse_pane" "$command_string" >/dev/null 2>&1
    fi
    reuse_status=$?
    # A tmux too old for `respawn-pane -c` (it arrives in 2.6) refuses the
    # OPTION, not the pane, and the reuse is act 1's whole point — so the one
    # retry is made without it and the child's own `cd` covers the difference.
    if [[ "$reuse_status" -ne 0 && ${#respawn_dir[@]} -gt 0 ]]; then
      if [[ "$act1_reuse_kill" == true ]]; then
        tmux respawn-pane -k -t "$act1_reuse_pane" "$command_string" >/dev/null 2>&1
      else
        tmux respawn-pane -t "$act1_reuse_pane" "$command_string" >/dev/null 2>&1
      fi
      reuse_status=$?
    fi
    set -e
    if [[ "$reuse_status" -eq 0 ]]; then
      tmux select-window -t "$act1_reuse_window" >/dev/null 2>&1 || true
      exec tmux attach-session -t "$act1_reuse_session"
    fi
    # THE REUSE FAILED, SO THE WINDOW IT WAS FOR IS NOT THE CHILD'S WINDOW.
    # Step 3 below creates a new session; a child in it that carried the
    # recorded window's name and address would bind by precedence 2 or 3 to a
    # window it is not standing in, and would write that window into its own
    # swap record. Clear the three and compose the command again — the values
    # go back to exactly what this side of a launch outside tmux holds when no
    # record named a live window at all.
    lane_window=""
    lane_window_ref=""
    lane_window_id=""
    act1_compose_child_command "$@"
  fi

  # ACT 1 STEP 3 — OTHERWISE CREATE THE SESSION, AND NAME ITS WINDOW FOR THE
  # LANE AT BIRTH, ONLY FOR A LANE NOBODY HAS TO CONFIRM.
  # Without `-n`, tmux names the window for the command that made it and global
  # `automatic-rename` then renames it again for whatever is running: on Eagle,
  # 8 of 16 live windows are called `claude`, and a window called `claude` has
  # no lane (Rule 4). `lane-start` renames it to the lane a moment later
  # anyway, so naming it here changes nothing about what this launch does —
  # what it changes is the NEXT restart typed in that window, which finds a
  # window that says which lane it is and binds by precedence 2, with no
  # question, instead of falling to the swap record's.
  #
  # ONLY FOR A LANE THAT IS CERTAIN. `--lane`/`CLAUDE_LANE` is the operator's
  # word. The swap record's newest-first row is an INFERENCE, which Amendment
  # 8(c) hands over as `--confirm` precisely so lane-start asks before it takes
  # a window. Naming the window for it here would answer that question in
  # advance and in the wrong place — the child would then find a window named
  # for the lane and bind by name, silently, from a guess nobody confirmed. So
  # the inference is left exactly where it is: the child resolves it inside tmux
  # and lane-start asks. Precedence 3 cannot arise here either, because a record
  # whose window resolves was reused at step 2 and one whose window does not
  # resolve is not an answer at all.
  #
  # `automatic-rename off` is what makes the name stick: `rename-window` turns
  # it off as a side effect (tmux(1)) and `-n` does not, so without this the
  # first command the window runs renames it straight back. (`-n` alone already
  # sets `automatic-rename` to 0 — verified — so this is belt and braces, not
  # the load-bearing half.)
  # `lane` is non-empty HERE only when `--lane` or `CLAUDE_LANE` gave it:
  # resolve_lane has not run on this side of the re-exec, act 1's own resolution
  # is deliberately not written back to it, and `--no-lane` already emptied it.
  # So the test for certainty is simply that there is one.
  if [[ -n "${lane:-}" ]]; then
    tmux new-session -d -s "$session_name" -n "$lane" -c "${act1_start_dir:-$PWD}" "$command_string" || {
      echo "pclaude: failed to start tmux session $session_name" >&2
      return 1
    }
    tmux set-window-option -t "$session_name:0" automatic-rename off >/dev/null 2>&1 || true
  else
    tmux new-session -d -s "$session_name" -c "${act1_start_dir:-$PWD}" "$command_string" || {
      echo "pclaude: failed to start tmux session $session_name" >&2
      return 1
    }
  fi
  tmux set-option -t "$session_name" mouse on >/dev/null 2>&1 || true
  exec tmux attach-session -t "$session_name"
}

export_tmux_identity() {
  local session pane
  [[ -n "${TMUX:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  session="$(tmux display-message -p '#S' 2>/dev/null || true)"
  pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
  [[ -n "$session" ]] && export WORKBENCHES_TMUX_SESSION="$session"
  [[ -n "$pane" ]] && export WORKBENCHES_TMUX_PANE="$pane"
}

# Native Claude records ~/.local/bin/claude as its expected installation path.
# Bench images install the immutable CLI in /usr/local/bin, so provide a
# per-user compatibility link to keep Claude's installer health check accurate.
if [[ ! -e /.dockerenv && "$claude_bin" == "/usr/local/bin/claude" ]]; then
  if mkdir -p "$HOME/.local/bin" 2>/dev/null; then
    if [[ ! -e "$HOME/.local/bin/claude" && ! -L "$HOME/.local/bin/claude" ]]; then
      ln -s /usr/local/bin/claude "$HOME/.local/bin/claude"
    elif [[ -L "$HOME/.local/bin/claude" && ! -e "$HOME/.local/bin/claude" ]]; then
      ln -sfn /usr/local/bin/claude "$HOME/.local/bin/claude"
    fi
  fi
fi

profile_metadata() {
  local requested="$1" normalized row metadata candidate profile_path fallback_row
  local preferred_row preferred_depth=-1 path_depth
  normalized="$(printf '%s' "$requested" | tr '[:upper:]' '[:lower:]')"
  if [[ -f "$manifest" ]]; then
    row="$(jq -r --arg name "$normalized" \
      '.profiles[]
       | select(
           ((.name | ascii_downcase) == $name)
           or any(.aliases[]?; (ascii_downcase == $name))
         )
       | [.name,.email,.family,(.profilePath // .name)] | @tsv' \
      "$manifest" | head -n 1)"
    if [[ -n "$row" ]]; then
      printf '%s\n' "$row"
      return 0
    fi
  fi

  while IFS= read -r -d '' metadata; do
    candidate="$(jq -r --arg name "$normalized" '
      if (((.name // "") | ascii_downcase) == $name)
         or any(.aliases[]?; (ascii_downcase == $name))
      then "match" else empty end
    ' "$metadata")"
    if [[ "$candidate" == "match" ]]; then
      profile_path="${metadata#"$base/profiles/"}"
      profile_path="${profile_path%/.profile.json}"
      row="$(jq -r --arg path "$profile_path" '[.name,.email,.family,$path] | @tsv' "$metadata")"
      if jq -e '(.profilePath // "") | length > 0' "$metadata" >/dev/null; then
        path_depth="$(awk -F/ '{print NF}' <<<"$profile_path")"
        if (( path_depth > preferred_depth )); then
          preferred_row="$row"
          preferred_depth="$path_depth"
        fi
      elif [[ -z "${fallback_row:-}" ]]; then
        fallback_row="$row"
      fi
    fi
  done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
  if [[ -n "${preferred_row:-}" ]]; then
    printf '%s\n' "$preferred_row"
    return 0
  fi
  if [[ -n "${fallback_row:-}" ]]; then
    printf '%s\n' "$fallback_row"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# THE LANE DEFAULT — lane-collision-protocol Amendment 8(c).
#
# `--lane` was opt-in, and a launch without it started a Claude with no lane at
# all: the window kept tmux's automatic rename, no register row was stamped,
# and the resume was left to a picker filtered by a title several transcripts
# share. That is the 2026-09-11 wrong-lineage resume, whose sixth finding was
# simply "the automation never ran" (Amendment 6). So a launch that starts a
# conversation now takes a lane by default, and the lane is RESOLVED rather
# than typed:
#
#   1. --lane / CLAUDE_LANE — what the operator said. Always wins.
#   2. the CURRENT tmux window's name, when `lanes-edit.sh register-row` says
#      the register has a row for it. The window name IS the lane (Rule 4),
#      and lane-start turned tmux's automatic rename off when it took the
#      window, so a window still called `claude` or `zsh` simply is not one.
#   3. the swap record whose `window` sub-field NAMES THIS WINDOW — its
#      `<@id>` first, else its `<session>:<index>`. New in Amendment 11 (SPEC
#      §2), and reachable only because act 1 keeps the window: an exact match
#      on the window the operator is standing in, so no question is asked.
#   4. `lanes-edit.sh swapped <workstation>`, first row — the lane this
#      workstation last PAUSED for a swap and has not resumed since (the
#      record, Amendment 8(b)), read only inside tmux, because taking it means
#      renaming a window.
#   5. nothing: exactly today's behaviour, plus one line saying how to take a
#      lane in this window — and not even that where the SessionStart hook of
#      clause (e) is ensured, since that block says the same thing with the
#      repo and the number filled in.
#
# 2 and 3 are certain — the operator is standing in the lane's own window, and
# the two rules differ only in which end of that fact they read it from, the
# window's name or the record's copy of its address — so both go to lane-start
# BARE, byte-for-byte as an explicit `--lane` always did. 4 is a guess: the
# newest record on the workstation, which on 2026-09-13 was 23 seconds ahead of
# the next one (Evidence 1). It goes as `--confirm` and lane-start asks before
# it renames the window. `--yes` is passed nowhere: it is inert in lane-start
# unless `--confirm` came with it, and `--confirm` is the one case it must
# never come with (F-W2, F-T8).
#
# NOTHING HERE REFUSES A LAUNCH, and after A8 Addendum 2 R-A8-3 that is true of
# the composition and not just of this file: every probe that cannot be made —
# no lane-start, no lanes-edit.sh, a lanes-edit.sh with no `swapped` yet, a
# lane-start with no `--confirm` yet, no tmux to take a window in — falls back
# to 4, and the one path that asks the operator a question launches Claude on
# BOTH answers, because the `--confirm` case runs lane-start instead of exec'ing
# it and catches a decline.
#
# AMENDMENT 11 (ratified 2026-09-13, "a11 1–5 yes, push them") changes three
# things about the above and nothing about its order:
#
#   (1) the verb is optional. `pclaude team03a` IS `pclaude run team03a`, so a
#       restart is one word and a lane is entered without naming one.
#   (2) THE WINDOW IS REUSED, act 1. Run inside tmux this launcher keeps the
#       CURRENT window — it sets CLAUDE_CONFIG_DIR and execs in place — so the
#       window's name and its id survive a restart and rule 2 above, the rule
#       that asks nothing, is the one that fires. Before this, every launch
#       made a fresh tmux session whose window is named for the command that
#       made it, so rule 2 could never fire on a restart and rule 3's one
#       question always could (new-workstation#20, Evidence 1). Outside tmux
#       the launcher first REUSES the window a swap record names where that
#       window still exists, and only failing that creates a session — whose
#       window it names for the lane at birth when the lane is certain.
#   (3) the lane's DIRECTORY is learnt and passed as `--dir`
#       (resolve_lane_dir), and lane-start is RUN rather than exec'd on every
#       path, so a refusal can never leave a window with no Claude in it.
#
# and one thing about the swap that is not in this file: at the 95% breakpoint
# the usage guard (`claude-usage-guard.sh`, wired into every profile by
# configure_profile_runtime above) turns its top five-hour line from ADVICE
# into a DIRECTIVE — run `/lane-swap` now, with no question asked — and THE
# SESSION performs the swap.
#
# THE GUARD ITSELF PERFORMS NO STEP OF IT, and this comment used to say it did.
# It is a `UserPromptSubmit` hook: it composes one string and `printf`s it
# (`claude-usage-guard.sh:167-179`) and that is the whole of what it can do —
# gated, latched and fail-quiet are why, and none of the three may be traded
# away for an act behind a keystroke (SPEC §9; the amendment text, clause (g):
# "It cannot act. It can put one line into the session's context … the
# automatic swap is not a new actor: it is the guard's existing top `five`
# threshold line changing from advice into a directive, and the session
# performing it"). So a swap with no PAUSED record is a session that did not
# take the directive, and the file to open is the skill, not the guard.

lanes_edit_bin() {
  # Found the way lane-start is, and never as a path spelled for one
  # workstation: on PATH, else beside the lane-start that IS on PATH (both are
  # `lanes/` in opensoft/brett-wip), else the symlink the protocol names.
  local candidate lane_start
  candidate="${WORKBENCHES_LANES_EDIT_BIN:-$(command -v lanes-edit.sh 2>/dev/null || true)}"
  if [[ -z "$candidate" ]]; then
    lane_start="$(command -v lane-start 2>/dev/null || true)"
    if [[ -n "$lane_start" ]]; then
      candidate="$(dirname "$(readlink -f "$lane_start")")/lanes-edit.sh"
    fi
  fi
  [[ -n "$candidate" ]] || candidate="$HOME/projects/xFactory/lanes-edit.sh"
  [[ -x "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

capture_lane_window() {
  # The lane's window is the one this was typed in, and its name is readable
  # only HERE — before start_profile_tmux re-execs into a session tmux names
  # after the command that made it. A child of that re-exec never asks tmux: it
  # takes the name threaded across, which is empty when the launch did not come
  # from a tmux window at all.
  #
  # Amendment 11(5) adds the window's ADDRESS beside its name: `#S:#I` and the
  # id `#{window_id}` (`@7`), which is the one handle that does not change when
  # the window is renamed. The NAME stays the key — the register is keyed on it
  # and the id does not survive a tmux server restart — so the address is
  # carried, exported and recorded as INFORMATION and is never resolved from.
  # It is read in probes of its own rather than in one combined format string,
  # because `display-message -p '#W'` is the read every other part of this
  # feature is specified and tested against and a combined read would change
  # what a fake, a log or an operator's `-p` sees for the answer that matters.
  if [[ -n "${WORKBENCHES_CLAUDE_TMUX_CHILD:-}" ]]; then
    lane_window="${WORKBENCHES_CLAUDE_WINDOW:-}"
    lane_window_ref="${WORKBENCHES_CLAUDE_WINDOW_REF:-}"
    lane_window_id="${WORKBENCHES_CLAUDE_WINDOW_ID:-}"
    return 0
  fi
  lane_window=""
  lane_window_ref=""
  lane_window_id=""
  [[ -n "${TMUX:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  lane_window="$(tmux display-message -p '#W' 2>/dev/null || true)"
  lane_window_ref="$(tmux display-message -p '#S:#I' 2>/dev/null || true)"
  lane_window_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  # An id is `@<digits>` and nothing else. A tmux too old to know the format
  # prints the format back, and a fake or a shim may print anything at all;
  # recording that string as a window id would put a lie in the object log,
  # which is append-only. The ref is `<session>:<index>`, and a session name
  # may contain almost anything, so only the `:<digits>` tail is checked.
  [[ "$lane_window_id" =~ ^@[0-9]+$ ]] || lane_window_id=""
  [[ "$lane_window_ref" =~ ^.+:[0-9]+$ ]] || lane_window_ref=""
  return 0
}

export_lane_identity() {
  # What this launch decided, published for the SESSION it is about to start:
  # the usage guard's automatic swap (Amendment 11(4)) and the `/lane-swap`
  # skill both have to name the lane, its window and its directory, and only
  # this process knows all three at once. They are exported under the
  # launcher's own namespace and never as CLAUDE_LANE, which is an INPUT to
  # this script and to nothing else: exporting it would make every nested
  # launch inherit a lane the operator did not type.
  #
  # The guard re-reads the window name for itself and validates it against the
  # register, because a window can be renamed after this point and the name is
  # the key. These are what it falls back to, and the address and directory it
  # cannot derive.
  #
  # WHAT THIS LAUNCH DID NOT HAND OVER IS UNSET, NEVER MERELY LEFT. The guard
  # states the contract itself (`claude-usage-guard.sh:146-148`): the fence is
  # "the lane the launcher already knows it handed over: WORKBENCHES_CLAUDE_LANE,
  # exported by claude-profile only after lane-start took the lane and UNSET
  # again where lane-start declined it", and clause (g) says the same. A bare
  # `[[ -z $lane ]] || export` did not keep it: it left an INHERITED marker
  # standing, so a nested `pclaude --no-lane <profile>` came up carrying the
  # OUTER session's lane and the automatic swap would write a PAUSED record for
  # a lane this launch explicitly refused. Every value below is now set or
  # removed, so after this function the environment says exactly what this
  # launch handed over and nothing else.
  #
  # THE RAW `CLAUDE_LANE`/`CLAUDE_LANE_DIR` GO WITH THEM where nothing was
  # handed over. They are INPUTS, read at precedence 1 and at the directory
  # order's rung 1, so an inherited one is a nested launch re-selecting a lane
  # this one refused — the same defeat one variable along. Where a lane WAS
  # handed over they are left exactly as the operator set them.
  #
  # AND A `--confirm` LANE IS NOT A LANE THIS LAUNCHER KNOWS IT HANDED OVER.
  # Precedence 4's newest-first row is an INFERENCE: `lane-start --confirm`
  # asks, and on a DECLINE it starts bare Claude itself and exits 0 — the same
  # 0 it returns having taken the lane. Nothing here can tell those apart
  # afterwards, and the environment has to be right BEFORE. So the marker is
  # published for the sources that are certain — `--lane`/`CLAUDE_LANE`, the
  # window's own name, and the record naming THIS window, all of which reach
  # lane-start bare — and withheld for the one that is a question. The cost is
  # that an ACCEPTED confirm gets the guard's advice at 95% instead of its
  # directive; the alternative is a DECLINED one writing a PAUSED record for a
  # lane it does not hold, which is the collision this protocol exists to
  # prevent. Under-firing is recoverable and over-firing is not, and clause (g)
  # picks the same side ("the lane the launcher ALREADY KNOWS it handed over").
  local handed_over=""
  if [[ -n "${lane:-}" && "${lane_source:-}" != record ]]; then
    handed_over="$lane"
  fi
  if [[ -n "$handed_over" ]]; then
    export WORKBENCHES_CLAUDE_LANE="$handed_over"
    export WORKBENCHES_CLAUDE_LANE_SOURCE="${lane_source:-}"
    if [[ -n "${lane_dir:-}" ]]; then
      export WORKBENCHES_CLAUDE_LANE_DIR="$lane_dir"
    else
      unset WORKBENCHES_CLAUDE_LANE_DIR
    fi
  else
    unset WORKBENCHES_CLAUDE_LANE WORKBENCHES_CLAUDE_LANE_SOURCE \
          WORKBENCHES_CLAUDE_LANE_DIR CLAUDE_LANE CLAUDE_LANE_DIR
  fi
  # The WINDOW's address is a fact about the window and not about the lane, so
  # it is published whenever it is known and removed whenever it is not — an
  # inherited ref would name a window this session is not in (the same fault
  # act 1's fall-through fixes one function along).
  if [[ -n "${lane_window_ref:-}" ]]; then
    export WORKBENCHES_CLAUDE_WINDOW_REF="$lane_window_ref"
  else
    unset WORKBENCHES_CLAUDE_WINDOW_REF
  fi
  if [[ -n "${lane_window_id:-}" ]]; then
    export WORKBENCHES_CLAUDE_WINDOW_ID="$lane_window_id"
  else
    unset WORKBENCHES_CLAUDE_WINDOW_ID
  fi
}

lane_no_lane_note='no lane for this window; run lane-start <repo> <n> inside it'
# ONE INSTALL ACT, IN ONE SPELLING, AND IT IS NAMED BY CAPABILITY — `R-A11-13`
# (A11 Addendum 3 on new-workstation#20, ratified by Brett Heap 2026-09-13
# "a11 addendum 3 yes"). Two places name it — the `--lane` refusal below and
# Evidence 5's notice — and an operator handed two different commands for one
# missing tool has to decide which is current, so both read the one function
# below and no second spelling of the act exists in this file.
#
# WHICH act it is, is a question about THIS MACHINE and not about which
# amendment is in force. Amendment 9 clause (b) makes `openRepoTools --install`
# the placer of the lane helpers, superseding Amendment 5's "reach PATH through
# its scripts/link-estates", and workBenches' own setup.sh ALREADY runs that
# command (setup.sh -> setup-estate-commands.sh): the lane tools become part of
# a step this estate already has, so NO SECOND INSTALLER is named here and none
# is wanted. But until Amendment 9 act 3 lands, the copy installed on this
# machine places park, resume, status and itself and nothing else — its own
# `--help` says exactly that, measured — and naming it to an operator whose
# lane-start is missing hands them a command that cannot fix their machine.
#
# So the installed tool's own `--help` is asked, because it is the only thing
# that can say which interval this machine is in: a copy that lists the lane
# tools IS their placer and `openRepoTools --install` is the act; a copy that
# does not, is not, and the act is the workspace repository's own
# `scripts/link-estates`. The probe costs one process on the one path where the
# lane tool is already missing, and nothing at all on any other launch.
#
# AND THE INTERVAL HAS TWO ENDS, NOT ONE. The text bounds it on Amendment 9 act
# 3 LANDING; this probe fires on the INSTALLED copy's `--help`, and those are
# not the same event, so a host that has not re-run `--install` since act 3
# merged is still on the fallback afterwards. Amendment 9 **act 5**
# (`opensoft/brett-wip#6` @`1483d55`, "the workspace repository keeps data
# only") lands inside that window and DELETES `scripts/link-estates` — the very
# file this fallback names. So the second end of the interval is act 5, and the
# resolver below has a branch for the state act 5 leaves behind: the checkout
# present and its script gone, where the act is `openRepoTools --install` with
# the reason, and never a path that is not there (`CF2-W11`).
#
# AND THE REPOSITORY IS THE ONE THIS MACHINE NAMES. `workspace.yaml` is where a
# person names their own workspace repository — this repo's own README gives it
# as the whole of that step's idempotence, and AGENT_PROTOCOL_ROOT moves the
# file — so a hard-coded `git clone git@github.com:opensoft/brett-wip.git` is
# one operator's estate printed at everybody else's. `link-estates` on its own
# is not an act either: it is a script inside a repository, and a word with no
# repository in front of it is not something anyone can run.
lane_workspace_field() {
  # One scalar out of workspace.yaml, without a YAML parser: the file is one
  # level deep, `yq` is on no machine this is guaranteed to run on, and the two
  # keys read here are the two `setup.sh` writes.
  #
  # THIS IS `scripts/setup-workspace-repo.sh`'s `yaml_value` RULE, NOT A SECOND
  # ONE. That function is this repository's own reader of this same file and it
  # already states the two things a looser one gets wrong, in its own comment:
  # "One key, first occurrence, TOP LEVEL ONLY -- the `orgs:` map Amendment 9(a)
  # puts out of scope is indented, so an anchored match never reaches into it"
  # and "The comment and trailing whitespace are stripped BEFORE the surrounding
  # quotes: `path: "~/projects/wip" # default checkout` must not leave a
  # trailing quote stuck to the end of the value."
  #
  # This copy used to allow leading whitespace (so an indented key under `orgs:`
  # could match) and strip no inline comment (so `path: "<checkout>" # default
  # checkout` printed the comment INSIDE the remediation command, where
  # everything after the `#` is commented out and what an operator would
  # actually run is a bare `git clone` into a quoted path). Both are gone, and
  # the two implementations are compared field-by-field over a table by
  # `test-claude-profile-amendment-11.sh` — the launcher is copied into the base
  # image while that script stays in the checkout, so one file cannot source the
  # other, and a differential test is what keeps one rule from becoming two.
  local file="$1" key="$2" line
  line="$(sed -n "s/^$key:[[:space:]]*//p" "$file" 2>/dev/null | head -n 1)" || return 0
  line="${line%%[[:space:]]#*}"
  line="${line%"${line##*[![:space:]]}"}"
  line="${line%\"}"; line="${line#\"}"
  line="${line%\'}"; line="${line#\'}"
  case "$line" in
    "~/"*) line="$HOME/${line#\~/}" ;;
    "~")   line="$HOME" ;;
  esac
  printf '%s\n' "$line"
}

lane_print_path() {
  # A PATH THAT IS PRINTED INSIDE A COMMAND AN OPERATOR WILL PASTE. The install
  # act is the one line rule (a) exists to make runnable, and a workspace path
  # carrying a space printed bare is a command that will not run — it is never
  # executed here, so the "unintended commands" half of the automated reviewer's
  # reading does not arise, but the broken-command half does. `%q` quotes only
  # where quoting changes anything, so the ordinary path stays copy-pasteable
  # and greppable exactly as it reads.
  local quoted
  printf -v quoted '%q' "$1"
  printf '%s\n' "$quoted"
}

lane_start_install_act() {
  # Resolved at most once per launch and printed; the two callers below print
  # what this returns and hold no copy of their own.
  if [[ -n "${lane_start_install_act_answer+set}" ]]; then
    printf '%s\n' "$lane_start_install_act_answer"
    return 0
  fi
  local help yaml repository path
  lane_start_install_act_answer=""
  if command -v openRepoTools >/dev/null 2>&1; then
    help="$(openRepoTools --help 2>&1 || true)"
    case "$help" in
      *lane-start*)
        lane_start_install_act_answer='openRepoTools --install'
        printf '%s\n' "$lane_start_install_act_answer"
        return 0
        ;;
    esac
  fi
  yaml="${AGENT_PROTOCOL_ROOT:-$HOME/.agents}/workspace.yaml"
  repository=""
  path=""
  if [[ -r "$yaml" ]]; then
    repository="$(lane_workspace_field "$yaml" repository)"
    path="$(lane_workspace_field "$yaml" path)"
  fi
  # `~` EXPANSION IS THE READER'S, not this caller's: one rule, one place, and
  # `~user` — which no `$HOME${path#\~}` can expand correctly — is left alone
  # there rather than mangled here.
  #
  # FOUR BRANCHES, AND THE THIRD IS NEW (`CF2-W11`, the act-5 addendum on
  # `opensoft/brett-wip#6` @`1483d55`, which DELETES `scripts/link-estates` from
  # the workspace repository). The `-e` test below is what makes act 5 bite
  # rather than what saves it: with the script gone it goes false, and the old
  # second branch then printed a `git clone` FOR A PATH THAT IS ALREADY THERE —
  # a clone that fails with "destination path already exists", followed by a
  # script that is not in the repository any more. Two failures in the one act
  # rule (a) exists to name.
  #
  # So the clone form is fenced on the checkout NOT EXISTING, and the case it
  # used to swallow — checkout present, script absent — gets a branch that names
  # a real command instead of a path that is not there. It is the capability
  # branch's own act, `openRepoTools --install`, with the reason beside it:
  # after act 5 there is no interval act left on this machine, and the only act
  # that can ever place the lane tools is the one Amendment 9 act 3 makes work.
  # Naming it is not naming two spellings at once — it is the same one act,
  # arrived at because the other no longer exists.
  #
  # Why this is not simply act 3's problem: the text bounds the interval on act
  # 3 LANDING, while the probe above fires on the INSTALLED copy's `--help`. A
  # host that has not re-run `--install` since act 3 merged is still on this
  # fallback when act 5 lands, and that window is what this branch is for.
  if [[ -n "$path" && -e "$path/scripts/link-estates" ]]; then
    lane_start_install_act_answer="$(lane_print_path "$path/scripts/link-estates")"
  elif [[ -n "$path" && -n "$repository" && ! -d "$path" ]]; then
    lane_start_install_act_answer="git clone git@github.com:$repository.git $(lane_print_path "$path") && $(lane_print_path "$path/scripts/link-estates")"
  elif [[ -n "$path" && -d "$path" ]]; then
    lane_start_install_act_answer="openRepoTools --install (the interval act is gone: $(lane_print_path "$path") has no scripts/link-estates, which Amendment 9 act 5 removes, so the act that places the lane tools is the one act 3 adds to --install's list)"
  else
    lane_start_install_act_answer="name your workspace repository in $yaml (repository: <owner>/<name>, path: <checkout>), then run its scripts/link-estates"
  fi
  printf '%s\n' "$lane_start_install_act_answer"
}

lane_note_no_lane_start() {
  # LANE-START IS ABSENT, AND THE LAUNCHER SAYS SO — Evidence 5
  # (new-workstation#20, 2026-09-13T17:29:58Z). This branch used to return in
  # silence, on the reasoning that a machine with no lane estate should not be
  # told about one on every launch. It was measured wrong. After this
  # workstation was rebuilt, the `~/.local/bin` symlinks that
  # `scripts/link-estates` places were gone while `/usr/local/bin/claude-profile`
  # was still there, so every restart took this branch: a Claude with no lane —
  # no register stamp, a record name the harness derives for itself (Evidence 4)
  # and a window left called `claude` — three times in one afternoon, with
  # nothing said. `--resume <uuid>` still continued the transcript, which is why
  # the loss was invisible.
  #
  # THE LAUNCHER CANNOT TELL THE TWO CASES APART, and that is the argument: a
  # machine that never had the estate and a machine whose links vanished this
  # morning present identically here. So the fact is stated on the FIRST line
  # this launch prints, the install act is named beside it, and the launch still
  # happens — nothing here refuses one (A8 Addendum 2 `R-A8-3`).
  #
  # It is NOT routed through lane_note_no_lane and does NOT stand down for the
  # SessionStart hook (`R-A8-7`, one no-lane notice not two): that block reports
  # the lane it could not bind, which is a different fact and one it can still
  # report — Evidence 5 measured it doing exactly that — and nothing but this
  # line can say the TOOL is missing. It replaces the standing note rather than
  # printing beside it, because "run lane-start <repo> <n>" names a command this
  # machine does not have.
  #
  # ONE SITUATION, ONE LINE — and the act rides on it rather than under it.
  # This printed the reason and then `pclaude:   fix: <act>` beneath it, which
  # is one situation on two lines. SPEC rev 5 §16(a) and the amendment text
  # (rule (a), "It composes with Amendment 8(c) step 4 rather than repealing
  # it": A8 gives the one-notice shape `pclaude: <reason>; <note>` "for exactly
  # the case where the launcher has something of its own to report beside the
  # standing no-lane note, and this line is that reason half. One situation,
  # one line.") give the shape, and the shape is a single `pclaude: ...; ...`.
  # The substance is unchanged and is what the ruling actually names: never
  # silent, the act named, printed FIRST, and replacing the standing note
  # rather than doubling it.
  echo "pclaude: lane-start is not on PATH, so this launch takes NO LANE: no register stamp, a session name the harness derives, and this window left as it is (new-workstation#20, Evidence 5); fix: $(lane_start_install_act)" >&2
}

lane_note_no_lane() {
  # One situation, ONE line (F-W3). A caller that has something of its own to
  # report passes it; the standing note is appended to it rather than printed
  # under it.
  #
  # And the note itself stands down where the SessionStart hook can speak.
  # Amendment 8(e): that block is "the ONLY no-lane notice in the estate;
  # clause (c) step 4 stands down wherever this hook can speak" — it holds the
  # lane, so it fills in <repo> and <n> instead of leaving them for a reader to
  # translate at the one moment they are trying to get back to work. Printing
  # both is the same instruction twice (R-A8-7, "one no-lane notice not two").
  # Where the hook was not ensured — no estate, or a lanes-edit.sh with no
  # `session-start` yet — nothing else will say it, so this does.
  local reported="${1:-}"
  if [[ "${lane_session_start_ensured:-false}" == true ]]; then
    [[ -n "$reported" ]] || return 0
    echo "pclaude: $reported" >&2
    return 0
  fi
  if [[ -n "$reported" ]]; then
    echo "pclaude: $reported; $lane_no_lane_note" >&2
  else
    echo "pclaude: $lane_no_lane_note" >&2
  fi
}

lane_window_is() {
  # Whether the current tmux window is named for this lane — i.e. whether
  # lane-start took it. Asked only AFTER lane-start has run, on the one path
  # that does not exec it, and never as a source of a lane.
  local want="$1" now
  command -v tmux >/dev/null 2>&1 || return 1
  now="$(tmux display-message -p '#W' 2>/dev/null || true)"
  [[ -n "$now" && "$now" == "$want" ]]
}

lane_is_pane_root() {
  # WHETHER THIS PROCESS IS THE PANE'S ROOT COMMAND — i.e. whether there is a
  # prompt behind a refusal, or nothing at all. `R-A11-16` (A11 Addendum 3 on
  # new-workstation#20, ratified by Brett Heap 2026-09-13 "a11 addendum 3 yes")
  # closes RV-W3 HERE rather than documenting it.
  #
  # The fence used to be the environment marker alone, and the case it did not
  # cover was real: a window whose ONLY command is `pclaude` and which this
  # launcher did not create — `tmux new-window -n <lane> 'pclaude <profile>'`, a
  # tmux configuration line, a pane respawned by hand — carries no
  # WORKBENCHES_CLAUDE_TMUX_CHILD, so a lane-start refusal in a window already
  # named for the lane was handed back and tmux printed `[exited]` over a window
  # with no Claude in it. That is Evidence 2 through a third door.
  #
  # WORKBENCHES_CLAUDE_TMUX_CHILD stays as the FAST PATH: act 1 sets it on both
  # of its paths, it costs nothing to read, and it is true by construction.
  # Failing that, the PANE is asked. `#{pane_pid}` is the process tmux started
  # for this pane, and this process's ancestry is walked up towards it: a
  # process on the way that is NOT this launcher (or a shell wrapper tmux made
  # to run it) is a command of its own, and a command of its own is the prompt a
  # refusal returns to — so the walk stops there and the status is handed back,
  # exactly as before. Reaching `#{pane_pid}` with nothing but this launcher in
  # between means this process IS the pane's root command and there is no prompt
  # behind it, so the caller drops to bare Claude.
  #
  # EVERY FAILURE ANSWERS "NOT THE ROOT", which is the answer that changes
  # nothing: no tmux, no `ps`, a `#{pane_pid}` that is not a number, a walk that
  # runs out of depth. This function can only ever CLOSE the third door; it can
  # never open a fourth.
  [[ -z "${WORKBENCHES_CLAUDE_TMUX_CHILD:-}" ]] || return 0
  [[ -n "${TMUX:-}" ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1
  command -v ps >/dev/null 2>&1 || return 1
  local pane_pid pid args self depth
  local -a target=()
  [[ -z "${TMUX_PANE:-}" ]] || target=(-t "$TMUX_PANE")
  pane_pid="$(tmux display-message -p ${target[@]+"${target[@]}"} '#{pane_pid}' 2>/dev/null || true)"
  [[ "$pane_pid" =~ ^[0-9]+$ ]] || return 1
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  pid=$$
  depth=0
  while [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 1 && depth < 8 )); do
    args="$(ps -o args= -p "$pid" 2>/dev/null || true)"
    [[ "$args" == *"$self"* || "$args" == *claude-profile* || "$args" == *pclaude* ]] || return 1
    [[ "$pid" != "$pane_pid" ]] || return 0
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
    depth=$((depth + 1))
  done
  return 1
}

lane_start_supports() {
  # `--confirm` arrives with the brett-wip half of Amendment 8. Until it does,
  # a lane-start that has never heard of it must not be handed it, and its own
  # --help is the only thing that can say.
  local flag="$1"
  if [[ -z "${lane_start_help+set}" ]]; then
    lane_start_help="$(lane-start --help 2>/dev/null || true)"
  fi
  [[ "$lane_start_help" == *"$flag"* ]]
}

lane_in_container() {
  # The three markers a container leaves for a process that is not root and
  # cannot read the host: Docker's own file, the OCI/podman one, and the
  # `container=` the systemd convention exports. Any of them is enough; none of
  # them can be faked by the estate, which is the point.
  [[ -e /.dockerenv || -e /run/.containerenv || -n "${container:-}" ]]
}

lane_workstation() {
  # THE WORKSTATION NAME COMES FROM CONFIGURATION, AND NEVER FROM `hostname`
  # INSIDE A CONTAINER — Evidence 6 (new-workstation#20, 2026-09-13T17:57:45Z).
  #
  # The register is keyed on the WORKSTATION: `swapped <ws>` answers with the
  # rows that workstation wrote, and this lane's own records say `Eagle`. Inside
  # a bench container `hostname -s` is the container id — `0e7d1a79a07e`, as
  # measured — and a launcher that passes it asks for the swap records of a
  # machine that has existed for an hour and will not exist tomorrow. The read
  # answers nothing, precedence 4 falls through, and NOTHING SAYS WHY: that is
  # the same silence Evidence 5 ruled out one function along. Worse, the forked
  # orchestrator of Evidence 6 WROTE records under that id, so an id that comes
  # back tomorrow on another container would read a stranger's rows back as this
  # workstation's.
  #
  # `LANES_WORKSTATION` is the estate's own word and is honoured everywhere,
  # container or not — it is the configuration the ruling names. Failing that,
  # `hostname` stands exactly as it did, but only where this is NOT a container.
  # Inside one with nothing configured there is NO answer, and the caller says
  # so rather than guessing: R-A9-13's seam is this, and the tooling half of it
  # is the tooling PR's.
  local name
  name="${LANES_WORKSTATION:-}"
  if [[ -z "$name" ]] && ! lane_in_container; then
    name="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  fi
  printf '%s\n' "$name"
}

lane_export_workstation() {
  # THE LAUNCHER OWNS `LANES_WORKSTATION` — `R-A11-14` (A11 Addendum 3 on
  # new-workstation#20, ratified by Brett Heap 2026-09-13 "a11 addendum 3
  # yes"). Evidence 6 left the reader honouring this variable and the writer
  # refusing without it, and NOTHING ON THE ESTATE SET IT: a contract with no
  # owner, which in a bench container means every lane write stops.
  #
  # The owner is this launcher, because it is the one process that runs on the
  # HOST and starts the sessions everything else runs in. The name is resolved
  # once, here, by the same function precedence 4 reads — configured value
  # first, `hostname` only where this is not a container — and EXPORTED, so the
  # Claude this launch starts, the /lane-swap skill inside it and every other
  # writer downstream read the host's word instead of asking a container what
  # its name is. An already-configured value wins, because `lane_workstation`
  # takes it first; where there is no answer at all, nothing is exported and
  # nothing is invented, and the writers refuse and say which variable is
  # missing (SKILL.md step 4). The container half of the same ruling is
  # `scripts/wave-container-shell.sh`, which passes it through `docker exec`.
  local name
  name="$(lane_workstation)"
  [[ -n "$name" ]] || return 0
  export LANES_WORKSTATION="$name"
}

# THE SWAP RECORDS, READ AT MOST ONCE PER LAUNCH. Two callers want them — the
# lane order's precedence 4 and the directory order's rung 2 — and `swapped` is
# on the path of every launch, so the read is cached rather than repeated. It
# is never a fetch: LANES_NO_FETCH=1, because a row this workstation wrote is in
# this workstation's own clone already and a launcher must not sit on the
# network to open a terminal.
swapped_read() {
  local lanes_edit ws err
  [[ -z "${swapped_read_done:-}" ]] || return 0
  swapped_read_done=1
  swapped_rows=""
  swapped_status=8
  swapped_reason=""
  swapped_ws_unknown=""
  swapped_argv=(swapped)
  lanes_edit="$(lanes_edit_bin || true)"
  [[ -n "$lanes_edit" ]] || return 0
  ws="$(lane_workstation)"
  # NO WORKSTATION, NO READ (Evidence 6). Passing nothing would leave the helper
  # to derive one from the same `hostname` this just refused, which is the wrong
  # answer arrived at one process later; passing the container id would ask for
  # a machine that is not this one. So the records are not read at all, the
  # caller that needed them names the gap, and every step that does not need
  # them is untouched.
  if [[ -z "$ws" ]]; then
    swapped_ws_unknown=1
    return 0
  fi
  swapped_argv+=("$ws")
  err="$(mktemp "${TMPDIR:-/tmp}/pclaude-swapped.XXXXXX")"
  set +e
  swapped_rows="$(LANES_NO_FETCH=1 "$lanes_edit" "${swapped_argv[@]}" 2>"$err")"
  swapped_status=$?
  set -e
  swapped_reason="$(cat "$err" 2>/dev/null || true)"
  rm -f "$err"
  return 0
}

lane_swapped_row() {
  # The swap record row that names THIS lane, or nothing. The contract is the
  # TAB (SPEC §11): `<lane>\t<UTC>\t<window>[\t<dir>]`, and a line without one
  # is not a record row — taking its first field would take the whole line,
  # which `cut -f 1` hands back intact, lane-shaped and wrong.
  local want="$1"
  swapped_read
  [[ "${swapped_status:-8}" -eq 0 && -n "${swapped_rows:-}" ]] || return 1
  printf '%s\n' "$swapped_rows" \
    | awk -F'\t' -v want="$want" 'NF >= 2 && $1 == want { print; exit }' \
    | grep . || return 1
}

window_lane_read() {
  # PRECEDENCE 3's read, and it is the HELPER'S (SPEC §11, clause (h)):
  # `lanes-edit.sh window-lane <@id>` / `<session>:<index>` answers "the
  # register row whose name is the window's name, else the swap record whose
  # `window` names that id or that `session:index`". ONE RULE, ONE
  # IMPLEMENTATION — the launcher, `/restart` and the `/lane-swap` skill are its
  # three callers, and a launcher that parsed `swapped` rows for itself would be
  # a second implementation of a rule that exists to stop the three disagreeing
  # about which lane a window is.
  #
  # Codes, exactly as SPEC §2 assigns them: 0 a lane · 8 none · 64 its own usage
  # error · 2 A HELPER PREDATING AMENDMENT 11, which exits 2 for an unknown
  # subcommand exactly as a pre-Amendment-8 one did for `swapped`. The two kinds
  # of 2 are told apart by the helper's own WORDS and never by its status, the
  # way this launcher already tells them apart for `swapped`: an old helper is
  # expected and silent, a caller's bug gets one line. Either way the read
  # answers nothing and the caller falls to the NEXT step.
  # The answer goes into `window_lane_answer` rather than onto stdout, and that
  # is not a style choice: a failed read has to be NAMED, `lane_read_note` is
  # how it is carried down the order, and a function called inside `$( )` sets
  # its globals in a subshell that dies with the substitution — the notice
  # would be lost exactly in the case it exists for.
  local ref="$1" lanes_edit out status err reason
  window_lane_answer=""
  lanes_edit="$(lanes_edit_bin || true)"
  [[ -n "$lanes_edit" ]] || return 1
  err="$(mktemp "${TMPDIR:-/tmp}/pclaude-window-lane.XXXXXX")"
  set +e
  out="$(LANES_NO_FETCH=1 "$lanes_edit" window-lane "$ref" 2>"$err")"
  status=$?
  set -e
  reason="$(cat "$err" 2>/dev/null || true)"
  rm -f "$err"
  out="${out%%$'\n'*}"
  case "$status" in
    0)
      if [[ "$out" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
        window_lane_answer="$out"
        return 0
      fi
      lane_read_note="${lane_read_note:-lanes-edit.sh window-lane $ref exited 0 without printing a lane}"
      return 1
      ;;
    8) return 1 ;;
    *)
      [[ "$reason" == *"unknown subcommand"* ]] \
        || lane_read_note="${lane_read_note:-lanes-edit.sh window-lane $ref exited $status without calling it an unknown subcommand, so this is a caller bug and not an old helper}"
      return 1
      ;;
  esac
}

lane_note_read_failed() {
  # A FAILED READ IS NAMED WHERE IT FAILED, and the order carries on below it
  # (SPEC §2: "A failed read falls to the NEXT step, not to step 5"). Printed
  # once, and only where a lane was found anyway — where none was, the note
  # goes INTO the single no-lane line instead, because R-A8-7 is one no-lane
  # notice and not two.
  [[ -n "${lane_read_note:-}" ]] || return 0
  echo "pclaude: $lane_read_note" >&2
  lane_read_note=""
window_lane_answer=""
}

resolve_lane() {
  # Sets `lane` and `lane_source` (flag|window|window-record|record, empty for
  # none) from the Claude arguments this launch carries. Never fails, never
  # refuses: a lane that cannot be resolved is today's behaviour.
  local lanes_edit candidate first_row ref
  window_lane_answer=""
  if [[ -n "${lane:-}" ]]; then
    lane_source=flag
    return 0
  fi
  [[ "$no_lane" == false ]] || return 0
  claude_args_start_session "$@" || return 0
  # NO LANE-START ON THIS MACHINE — said, never silent (Evidence 5). The two
  # fences above stand: `--no-lane` is the operator's own word, and a launch
  # that starts no conversation takes no lane in the first place, so neither is
  # a degradation to report.
  if ! command -v lane-start >/dev/null 2>&1; then
    lane_note_no_lane_start
    return 0
  fi
  lanes_edit="$(lanes_edit_bin || true)"
  if [[ -z "$lanes_edit" ]]; then
    lane_note_no_lane
    return 0
  fi

  # LANES_NO_FETCH=1 on every read below: they are on the path of every launch,
  # and lanes-edit.sh otherwise fetches origin before it answers.
  #
  # PRECEDENCE 2 — THE WINDOW'S NAME. Only 0 is a lane. `register-row` answers
  # 8 for a name with no row and 2 for a window name that is not even
  # lane-shaped (`zsh`, `1:vim*`).
  if [[ -n "${lane_window:-}" ]] \
    && LANES_NO_FETCH=1 "$lanes_edit" register-row "$lane_window" >/dev/null 2>&1; then
    lane="$lane_window"
    lane_source=window
    return 0
  fi

  # The record's lane is a guess about a WINDOW: `lane-start` takes it by
  # renaming the current tmux window (Amendment 5(f)), so there has to be one.
  # Outside tmux there is not — `WORKBENCHES_CLAUDE_TMUX=off`, a launch that is
  # not on a tty — and a lane-start handed a lane it cannot take is how a
  # resolution that "never refuses a launch" refuses one. An interactive launch
  # with no TMUX re-execs into a session of its own before this runs, and the
  # child resolves INSIDE tmux, where this test passes; so the case this closes
  # is exactly the documented direct launch, which keeps its documented
  # behaviour. The window rule above needs no such test: it has no lane to
  # offer unless tmux named the window in the first place.
  if [[ -z "${TMUX:-}" ]]; then
    lane_note_no_lane
    return 0
  fi

  # PRECEDENCE 3 (SPEC §2 row 3, new in Amendment 11) — THE RECORD FOR *THIS*
  # WINDOW, and it is not a guess. Where a swap record's `window` sub-field
  # names the window this command was typed in, the lane is an exact match on
  # the window the operator is standing in — the same certainty the window NAME
  # carries in precedence 2, arrived at from the other side — so it goes to
  # lane-start BARE, with no `--confirm` and no question. Only if nothing names
  # this window does the newest-first guess of precedence 4 apply, and that one
  # is still confirmed.
  #
  # This is what makes a restart in the lane's own window silent even when the
  # window has LOST its name: a tmux `automatic-rename` that fired, a window
  # renamed by hand, a pane that came back as `zsh`.
  #
  # THE `<@id>` IS TRIED FIRST AND THE `<session>:<index>` SECOND, which is the
  # amendment's own words (clause (b), SPEC §2 row 3). The id is the better key
  # — a `<session>:<index>` is reused the instant a window closes and the next
  # one takes its index, while an id is never reissued for the life of the
  # server — so it is asked about before the ref is, and the ref is asked about
  # only where the id answered nothing.
  #
  # AND EITHER IS TAKEN ONLY WHERE THAT WINDOW STILL EXISTS. Here that fence
  # costs nothing to hold: both refs were read out of `tmux display-message` in
  # `capture_lane_window` a moment ago, for the window this process is standing
  # in, so the window they name is this one and it exists by construction.
  # Outside tmux — act 1, where there is no current window — the fence is a
  # live `display-message -t` probe, and `act1_window_reuse` makes it.
  for ref in "${lane_window_id:-}" "${lane_window_ref:-}"; do
    [[ -n "$ref" ]] || continue
    if window_lane_read "$ref"; then
      lane="$window_lane_answer"
      lane_source=window-record
      lane_note_read_failed
      return 0
    fi
  done

  # PRECEDENCE 4 — THE WORKSTATION'S NEWEST SWAP, and it IS a guess about which
  # window, so it is handed to lane-start as `--confirm` and lane-start asks.
  # 0 with rows `<lane>\t<UTC>\t<window>[\t<dir>]`, most recent first; 8 with
  # none. The contract is the TAB: a row without one is not that shape.
  swapped_read
  # ...and where the read could not be MADE because this container names no
  # workstation (Evidence 6), that is named HERE — at the one step that wanted
  # it — and not by the read itself, which the directory order also calls and
  # which has its own line for a directory it could not learn.
  # NO APOSTROPHE IN THIS DEFAULT, and that is not style: bash reads a `'` inside
  # a `${x:-word}` as opening a quote, so one here swallows the rest of the file
  # and every function defined below it goes missing at run time.
  #
  # AND WHETHER `bash -n` CATCHES IT DEPENDS ON WHAT FOLLOWS, WHICH IS WHY THE
  # SUITE NOW RUNS `shellcheck` BESIDE IT (CF-W4, corrected under `R-A11-16`).
  # Measured on this workstation, GNU bash 5.2.21, by putting one apostrophe
  # into this very default and running both tools over THIS file:
  #   $ bash -n base-image/files/claude-profile      -> exit 0, says nothing
  #   $ shellcheck -S error base-image/files/claude-profile
  #                                                  -> SC1073/SC1072, :1382
  # (the `$ ` prompts are load-bearing: a comment line that starts with the
  # linter's own name is read as a shellcheck DIRECTIVE and fails the gate —
  # measured here the moment this comment was first written.)
  # `bash -n` sees a syntax error only where the stray quote is still open at
  # END OF FILE. Every apostrophe below it can close it again — and a file this
  # size has many — after which the file parses perfectly while everything
  # between the two lives inside a string. The confirmation review measured a
  # three-line file, where the quote does reach EOF unbalanced and `bash -n`
  # does exit 2; both measurements are right, and the difference is exactly what
  # follows the trap. So the claim this comment used to make is true of this
  # file and false in general, and neither wording is a reason to skip the
  # check: the linter is the half that holds this class, the gate at the top of
  # `test-claude-profile-amendment-11.sh` runs both, and the comment stays
  # because the failure mode is invisible on INSPECTION — the file still reads
  # like bash, and the loss shows up as a function that is simply not there.
  if [[ -n "${swapped_ws_unknown:-}" ]]; then
    lane_read_note="${lane_read_note:-this is a container and LANES_WORKSTATION names no workstation, so the swap records for this workstation were not read (new-workstation#20, Evidence 6); the launcher on the host exports it into every session and container it starts, so set LANES_WORKSTATION=<workstation> here}"
  fi
  first_row="$(printf '%s\n' "${swapped_rows:-}" | head -n 1)"
  if [[ "${swapped_status:-8}" -eq 0 && -n "${swapped_rows:-}" && "$first_row" == *$'\t'* ]]; then
    candidate="${first_row%%$'\t'*}"
    if [[ "$candidate" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
      lane="$candidate"
      lane_source=record
      lane_note_read_failed
      return 0
    fi
  fi
  # A lanes-edit.sh from before Amendment 8 exits 2 because it has no `swapped`
  # subcommand at all — but 2 is also its usage code, so a caller bug would look
  # exactly like an old helper and degrade to case 5 in silence (F-W4). The
  # status cannot tell them apart; the helper's own words can, because it says
  # "unknown subcommand" for the one and not for the other. An old helper is
  # expected and silent. A caller bug gets one line, and still a launch.
  if [[ "${swapped_status:-8}" -ne 0 && "${swapped_status:-8}" -ne 8 \
        && "${swapped_reason:-}" != *"unknown subcommand"* ]]; then
    lane_read_note="lanes-edit.sh ${swapped_argv[*]} exited ${swapped_status} without calling it an unknown subcommand, so this is a caller bug and not an old helper"
  fi
  # PRECEDENCE 5 — no lane, one notice, and still a launch.
  if [[ -n "${lane_read_note:-}" ]]; then
    lane_note_no_lane "$lane_read_note"
    lane_read_note=""
  else
    lane_note_no_lane
  fi
  return 0
}

# ---------------------------------------------------------------------------
# THE LANE'S DIRECTORY — Amendment 11(3).
#
# `lane-start` needs to know where the lane lives, and its default is
# `$PROJECTS_ROOT/<repo>` — the `<repo>` parsed out of the lane's own name.
# That default is a GUESS about a checkout's path, and on 2026-09-13 it was
# wrong for a real lane: `openXfactory-5` lives in `~/projects/xFactory/
# openxFactory`, so `pclaude --lane openXfactory-5 run team01l` reached
# `lane-start`, which died with "no such directory … pass --dir" — and because
# the launcher `exec`ed it into a tmux session whose only command it was, tmux
# printed `[exited]` and the window closed on a restart that had nothing wrong
# with it (new-workstation#20, Evidence 2).
#
# So the launcher learns the directory where it can and passes `--dir`. THE
# PRECEDENCE IS THE SPEC'S, and it has FOUR RUNGS AND NO FIFTH (SPEC §4,
# Amendment 11(c), A11 Addendum 1 `R-A11-3`). First answer wins:
#
#   1. `--dir <path>`         — the operator's word, on this launcher or on
#                               lane-start, together with the `CLAUDE_LANE_DIR`
#                               that carries it across the re-exec into a new
#                               tmux session, exactly as `CLAUDE_LANE` carries
#                               `--lane` at precedence 1 of the lane order.
#                               ONE RUNG, two spellings of the same word. Not
#                               tested for existence: lane-start's own refusal
#                               names the path and the flag that fixes it, and a
#                               launcher that silently dropped what it was told
#                               would hide that.
#   2. the SWAP RECORD's `dir` — the lane this workstation paused recorded where
#                               it was (`dir <path>` in the PAUSED payload, and
#                               `swapped`'s fourth tab-separated field), read
#                               only for the row that names THIS lane.
#   3. `lanes-edit.sh lane-dir <lane>` — the `dir ` sub-field of the lane's log's
#                               LAST lane-kind line carrying one, in file order
#                               (SPEC §11); written by lane-start on the
#                               STARTED/RESUMED line.
#   4. `$PROJECTS_ROOT/<repo>` — lane-start's own default, reached by passing no
#                               `--dir` at all, and only the default for a lane
#                               that has never been started under this
#                               amendment. Byte for byte what every launch
#                               before Amendment 11 passed.
#
# THERE IS NO FIFTH RUNG, AND THE CWD'S OWN CHECKOUT IS RULED OUT BY NAME.
# This launcher's first pass had one: the cwd's git checkout where its basename
# case-insensitively equalled the lane's `<repo>` token and `$PROJECTS_ROOT/
# <repo>` did not exist. It was never authorised, and A11 Addendum 1 `R-A11-3`
# removed it here rather than ruling it in with its two fences: `lane-start`
# writes the lane's HOME into its Amendment 7 `STARTED` line from that
# directory's `origin`, and every `#n` the lane afterwards writes inherits it,
# so an inference that can silently re-home a lane is not worth the refusal it
# saves — and the refusal names `--dir`, which is one word. Evidence 2's own
# command is served by rung 1 today and by rung 2 the moment the swap writes a
# `dir`, which is the tooling PR's act (SPEC §13.3 and §13.5).
#
# Rungs 2 and 3 are read TOLERANTLY: today's `lanes-edit.sh swapped` prints
# `<lane>\t<UTC>\t<window>` with no fourth field and today's helper has no
# `lane-dir` subcommand at all, so both simply find nothing and rung 4 stands.
# A helper that starts recording one is picked up with no change here.

lane_dir_field() {
  # The SPEC's field and only the SPEC's field: `dir <path>`, a payload
  # sub-field in Amendment 7(b)'s grammar — the label, one space, an ABSOLUTE
  # path (SPEC §5). A relative path has no meaning without the writer's cwd,
  # which nothing here knows, and `~` is the writing shell's and not this one's.
  #
  # A PATH CONTAINING A SPACE IS QUOTED, NOT REFUSED (SPEC §5, A11 Addendum 1
  # `R-A11-6`): the space is 7(b)'s separator between several refs inside one
  # sub-field — which is what the `window` sub-field's two refs rely on — so the
  # writer writes `dir "/home/b/my projects/x"` and EVERY READER takes a value
  # opening with `"` as running to its closing `"`, stripping both. This is one
  # of those readers. A path carrying `, `, ` — ` or a `"` of its own was
  # refused by the writer and never appears here at all.
  local text="$1" value
  value="$(printf '%s\n' "$text" \
    | sed -n 's/.*[[:space:]|]dir[[:space:]]\{1,\}"\([^"]*\)".*/\1/p' \
    | head -n 1)"
  if [[ -z "$value" ]]; then
    value="$(printf '%s\n' "$text" \
      | sed -n 's/.*[[:space:]|]dir[[:space:]]\{1,\}\(\/[^|;"\t]*\).*/\1/p' \
      | head -n 1)"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

resolve_lane_dir() {
  # Sets `lane_dir` and `lane_dir_source` (flag|env|record|recorded, empty for
  # rung 4). Never fails and never refuses: a directory that cannot be learnt is
  # lane-start's default, which is what every launch before Amendment 11 passed.
  local lanes_edit row candidate status
  lane_dir=""
  lane_dir_source=""
  [[ -n "${lane:-}" ]] || return 0

  # RUNG 1 — the operator's word, in either of its two spellings, passed
  # exactly as given and NOT tested for existence (see above).
  if [[ -n "${lane_dir_flag:-}" ]]; then
    lane_dir="$lane_dir_flag"; lane_dir_source=flag; return 0
  fi
  if [[ -n "${CLAUDE_LANE_DIR:-}" ]]; then
    lane_dir="$CLAUDE_LANE_DIR"; lane_dir_source=env; return 0
  fi

  # RUNG 2 — THE SWAP RECORD, and only the row that names THIS lane: a record
  # for some other lane says nothing about where this one lives. The row is
  # already in hand wherever `swapped` was read to resolve the lane, and
  # `swapped_rows` reads it at most once per launch otherwise — which is the
  # case the `window-lane` and `--lane` paths reach, since neither of them
  # reads `swapped` at all. SPEC §11 gives `swapped` a FOURTH tab-separated
  # field, `<dir>`; a `dir <path>` sub-field anywhere in the row is taken too,
  # so a helper that packs it into the payload instead is read the same way.
  swapped_read
  row="$(lane_swapped_row "$lane" || true)"
  if [[ -n "$row" ]]; then
    candidate="$(printf '%s' "$row" | cut -f 4)"
    [[ "$candidate" == /* || "$candidate" == '"'* ]] || candidate=""
    [[ -n "$candidate" ]] || candidate="$(lane_dir_field "$row" || true)"
    candidate="${candidate%\"}"; candidate="${candidate#\"}"
    # WHAT THE RECORD SAYS IS THE ANSWER, EXISTING OR NOT (RV-W2, A11 Addendum 2
    # `R-A11-11`). An earlier pass required `-d` here, which looks like caution
    # and is the opposite: a lane whose checkout has MOVED then falls through
    # rungs 2 and 3 to rung 4, `$PROJECTS_ROOT/<repo>` — and where that path
    # exists but is a different tree, the lane is started in it and `lane-start`
    # writes the lane's HOME from that tree's `origin` (Amendment 7's STARTED
    # line), which every `#n` afterwards inherits. That is `R-A11-3`'s own
    # hazard, reached from the record instead of from the cwd. So a recorded
    # directory that is gone is a REFUSAL NAMING THE PATH (enter_lane_dir),
    # never a silent re-home.
    if [[ -n "$candidate" ]]; then
      lane_dir="$candidate"; lane_dir_source=record; return 0
    fi
  fi

  # RUNG 3 — THE LANE'S RECORDED DIRECTORY (SPEC §11, `lanes-edit.sh lane-dir
  # <lane>`: the `dir ` sub-field of its log's last lane-kind line carrying
  # one; 0 a path, 8 none, 64 usage, 2 a helper predating Amendment 11). Read
  # with the same LANES_NO_FETCH=1 as every other register read on the path of
  # a launch — a launcher must not sit on the network to open a terminal. ONLY
  # 0 WITH AN ABSOLUTE PATH is an answer, so the unknown-subcommand line
  # today's helper prints can never be mistaken for a path, and every other
  # code simply leaves rung 4 standing. The path is NOT tested for existence,
  # for rung 2's reason: what the lane's log recorded is this lane's tree, and
  # a tree that is gone is a refusal naming it, never a fall to rung 4's guess
  # (RV-W2, `R-A11-11`).
  lanes_edit="$(lanes_edit_bin || true)"
  if [[ -n "$lanes_edit" ]]; then
    set +e
    row="$(LANES_NO_FETCH=1 "$lanes_edit" lane-dir "$lane" 2>/dev/null)"
    status=$?
    set -e
    row="${row%%$'\n'*}"
    row="${row%\"}"; row="${row#\"}"
    if [[ "$status" -eq 0 && "$row" == /* ]]; then
      lane_dir="$row"; lane_dir_source=recorded; return 0
    fi
  fi

  # RUNG 4 — lane-start's own default, reached by passing no `--dir`. There is
  # nothing here to write: `lane_dir` is empty and the launcher hands the lane
  # over exactly as it did before Amendment 11 existed.
  return 0
}

enter_lane_dir() {
  # THE LAUNCH HAPPENS IN THE LANE'S DIRECTORY — Evidence 3 (new-workstation#20,
  # 2026-09-13T17:20:55Z), and it is load-bearing for far more than `--dir`.
  #
  # A restart of this very lane was typed from `/workspace`. The launcher made
  # its tmux session there, so the HARNESS KEYED THE SESSION TO THAT DIRECTORY:
  # the repository's CLAUDE.md and the lane's memory did not load and the
  # scratchpad moved, while `--resume <uuid>` still continued the transcript.
  # Nothing refused, nothing warned; the session simply came up without its
  # instructions. A lane is a checkout, so a launch that binds one and starts
  # somewhere else has not started that lane at all.
  #
  # So the directory the order above resolved is ENTERED before anything is
  # launched — before `lane-start`, and therefore before the Claude it execs —
  # and act 1 creates its session with `-c` the same directory, so the pane
  # agrees with the process. Relative paths in CLAUDE_ARGS are read from the
  # lane's tree after this point, which is the tree they are about.
  #
  # AND A RECORDED DIRECTORY THAT IS GONE IS A REFUSAL NAMING THE PATH (RV-W2,
  # `R-A11-11`). It is never a fall to rung 4: `lane-start` writes the lane's
  # HOME into its Amendment 7 `STARTED` line from the directory it starts in,
  # so a silent re-home rewrites the lane's identity out of whatever tree
  # happens to sit at `$PROJECTS_ROOT/<repo>`, and every `#n` inherits it. The
  # refusal names the path, the record it came from, and `--dir`, which is one
  # word.
  local reason
  lane_dir_entered=""
  lane_dir_note=""
  [[ -n "${lane:-}" ]] || return 0
  if [[ -z "${lane_dir:-}" ]]; then
    # RUNG 4 — NOTHING WAS LEARNT, SO NOTHING IS ENTERED, AND THE LAUNCHER SAYS
    # SO. This is every lane on the estate until §13.5's cutover has run for it,
    # and it is the OTHER half of Evidence 3: `lane-start` cds for its own
    # launch, so where it takes the lane the session is keyed to the directory
    # IT chose and there is nothing here to report — but where it does not, the
    # bare Claude behind SPEC §2's run-not-exec drop starts wherever this was
    # typed, and that session loads neither the repository's CLAUDE.md nor the
    # lane's memory while `--resume` still continues the transcript, which is
    # exactly why nobody noticed for an afternoon.
    #
    # CARRIED, NOT PRINTED (F-W3, `R-A8-7`: one situation, ONE line). The drop
    # already prints one line and this is the same launch, so the fact goes into
    # it and arrives at the moment it bites rather than one launch early.
    lane_dir_note="no directory is recorded for $lane, so this Claude starts in $PWD and loads whatever that tree carries (Evidence 3); name it once with --dir <path>"
    return 0
  fi
  if [[ -d "$lane_dir" ]]; then
    if cd -- "$lane_dir" 2>/dev/null; then
      lane_dir_entered="$lane_dir"
      return 0
    fi
    reason="cannot be entered"
  else
    reason="is not there"
  fi
  # RUNG 1 IS THE OPERATOR'S OWN WORD, and SPEC §4 keeps it untested by name:
  # "lane-start's refusal names the path and the flag". There is nothing to
  # enter, so the launch goes on and lane-start says so in its own words —
  # which is one refusal, from the one place that can also name `--dir` as the
  # thing to change. Two refusals for one typo would be two.
  case "${lane_dir_source:-}" in
    flag|env) return 0 ;;
  esac
  case "${lane_dir_source:-}" in
    record)   reason="$reason (recorded by this lane's own swap record)" ;;
    recorded) reason="$reason (recorded by lanes-edit.sh lane-dir $lane)" ;;
  esac
  echo "pclaude: the directory recorded for $lane $reason: $lane_dir" >&2
  echo "pclaude:   NOT re-homed to lane-start's default: a lane started in another tree takes that tree's origin as its home, and every #n inherits it." >&2
  echo "pclaude:   fix: pclaude --dir <path> --lane $lane ${CLAUDE_PROFILE_NAME:-<profile>}, or put the checkout back." >&2
  if lane_is_pane_root; then
    # `R-A11-4`, and the same fence the status-passthrough arm carries: this
    # process is the only command of its pane — a window the launcher itself
    # made or respawned, or (since `R-A11-16`) one whose root command this
    # process is — so exiting here would leave tmux printing `[exited]` over a
    # window with no Claude in it — Evidence 2 through a fourth door. The lane
    # is dropped instead, nothing downstream may read that this session holds
    # it, and Claude starts bare in the window, exactly as it does behind a
    # lane-start refusal.
    lane=""
    lane_dir=""
    lane_dir_source=""
    lane_note_no_lane "the lane's recorded directory is gone, so this window took no lane"
    return 0
  fi
  exit 2
}

# --lane / CLAUDE_LANE / --no-lane are recognised only as leading options,
# before the action/profile — the first token that is not one of them ends this
# loop and is left for the existing parsing below, so anything meant for Claude
# itself (e.g. `claude-profile work --help`) is untouched.
lane="${CLAUDE_LANE:-}"
lane_source=""
lane_window=""
lane_window_ref=""
lane_window_id=""
# The swap records, read at most once per launch (swapped_read) and shared by
# the lane order's precedence 4 and the directory order's rung 2.
swapped_read_done=""
swapped_rows=""
swapped_status=8
swapped_reason=""
# Set by swapped_read where this is a container with no configured workstation,
# so precedence 4 can name the read it could not make (Evidence 6).
swapped_ws_unknown=""
swapped_argv=(swapped)
# The first failed read of the lane order, named where it failed and carried
# down the order so the notice is printed once (SPEC §2).
lane_read_note=""
lane_dir=""
lane_dir_source=""
lane_dir_flag=""
# What enter_lane_dir could NOT do, carried into the one line the bare-Claude
# drop already prints rather than printed beside it (F-W3, R-A8-7).
lane_dir_note=""
# The directory this launch actually entered (Evidence 3), empty where none was
# learnt. Published for the record the swap writes, and for nothing else.
