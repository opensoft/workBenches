# two tests, and the word has to pass both.
#
#   * an OPTION is never a profile. A leading `-` ends the option loop above
#     precisely because anything after it belongs to Claude; reading it as the
#     PROFILE, the one argument Claude never sees, is the one wrong answer.
#   * a profile is a word this launcher can RESOLVE. `profile_metadata` is the
#     same resolution `run` itself makes a line later — manifest first, then
#     the profile directories, names and aliases both — so one word starts
#     exactly the profiles `pclaude list` prints and nothing else.
#
# THE FOUR ACTION WORDS WIN. A profile called `run` or `status` is reachable
# only as `pclaude run run`, which is what the verb being optional means: the
# verb, where it is typed, is the verb. Ambiguity is decided in the one
# direction an operator can undo.
action="${1:-list}"
case "$action" in
  list|login|status|run)
    [[ $# -eq 0 ]] || shift ;;
  -*)
    echo "pclaude: '$action' is an option, not an action or a profile." >&2
    echo "Usage: claude-profile {list|login|status|run} PROFILE [CLAUDE_ARGS...]" >&2
    echo "       pclaude PROFILE [CLAUDE_ARGS...]   (leading options: --lane, --dir, --no-lane)" >&2
    exit 2 ;;
  *)
    if profile_metadata "$action" >/dev/null 2>&1; then
      action=run
    else
      # SPEC §1: "an unknown profile is still exit 2 with `Unknown Claude
      # profile: <name>`, which is what keeps a typo from silently becoming a
      # launch." The same words the `run` arm has always used for the same
      # situation, said one step earlier.
      echo "Unknown Claude profile: $action" >&2
      echo "  pclaude list   shows the profiles this machine has" >&2
      exit 2
    fi ;;
esac

case "$action" in
  list)
    {
      if [[ -f "$manifest" ]]; then
        jq -r '.profiles[] | [.name, .family, .email, ((.aliases // []) | join(","))] | @tsv' "$manifest"
      fi
      while IFS= read -r -d '' metadata; do
        jq -r '[.name,.family,.email,((.aliases // []) | join(","))] | @tsv' "$metadata"
      done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
    } | awk -F '\t' '!seen[tolower($1)]++'
    ;;
  login|status|run)
    profile="${1:?Usage: claude-profile $action PROFILE [arguments]}"; shift
    row="$(profile_metadata "$profile" || true)"
    [[ -n "$row" ]] || { echo "Unknown Claude profile: $profile" >&2; exit 2; }
    IFS=$'\t' read -r profile email family profile_path <<<"$row"
    config_dir="$base/profiles/$profile_path"
    [[ -d "$config_dir" ]] || { echo "Claude profile is not configured: $config_dir" >&2; exit 2; }
    [[ -n "$claude_bin" ]] || { echo "Claude CLI not found." >&2; exit 1; }
    export CLAUDE_PROFILE_NAME="$profile"
    configure_profile_runtime "$config_dir"
    load_profile_setup_token "$config_dir"
    shared_mcp=false
    if family_uses_shared_mcp "$family" && [[ -n "$mcp_sync" && -x "$mcp_sync" ]]; then
      shared_mcp=true
      "$mcp_sync" sync-claude-profile "$family" "$config_dir/.claude.json"
    fi
    case "$action" in
      login) CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" auth login --claudeai --email "$email" "$@" ;;
      status) CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" auth status "${@---text}" ;;
      run)
        if [[ -n "${lane:-}" ]]; then
          # THE FIX IS THE INSTALL ACT, NOT A PATH INTO SOMEBODY'S WIP.
          # lane-collision-protocol Amendment 9(b) moves the lane tooling to
          # opensoft/openRepoTools and makes `openRepoTools --install` their
          # placer; Amendment 9's adoption act 5 then STRIPS
          # `scripts/link-estates` out of the workspace repository altogether
          # (opensoft/brett-wip#6 @1483d55). A refusal that told a person to
          # clone that repository and run that script would name a path that
          # stops existing -- and it named one operator's estate at everybody
          # else's terminal besides.
          command -v lane-start >/dev/null 2>&1 || {
            # One situation, one line, here too: this is the other place the
            # install act is printed, and an operator who meets both should
            # not meet two shapes of one notice (SPEC rev 5 §16(a)).
            echo "pclaude: --lane $lane needs lane-start on PATH; fix: $(lane_start_install_act)" >&2
            exit 2
          }
        fi
        # THE WORKSTATION IS RESOLVED AND EXPORTED BEFORE ANYTHING IS
        # STARTED (`R-A11-14`): act 1 threads it into the session it creates,
        # and the Claude this launch execs inherits it either way.
        lane_export_workstation
        # ...AND THE THREE FACTS THAT SAY WHERE IT IS RUNNING, in the same
        # breath and by the same rule (Amendment 18 clause (a),
        # opensoft/workBenches#98): host, os and container, resolved on the host
        # and threaded into the session act 1 creates beside the workstation.
        lane_export_binding_facts
        capture_lane_window
        if claude_run_is_interactive "$@"; then
          start_profile_tmux "$profile" "$@"
        fi
        export_tmux_identity
        if [[ "$shared_mcp" == true && "${1:-}" == mcp \
          && ( "${2:-}" == add || "${2:-}" == add-json ) ]]; then
          metadata="$config_dir/.claude.json"
          before="$(mktemp "$config_dir/.mcp-before.XXXXXX.json")"
          after="$(mktemp "$config_dir/.mcp-after.XXXXXX.json")"
          claude_mcp_snapshot "$metadata" "$before"
          managed_args=("$@")
          if ! claude_add_has_scope "$@"; then
            managed_args=(mcp "$2" --scope user "${@:3}")
          fi
          set +e
          CLAUDE_CONFIG_DIR="$config_dir" "$claude_bin" \
            --allow-dangerously-skip-permissions \
            --dangerously-skip-permissions \
            --permission-mode bypassPermissions \
            "${managed_args[@]}"
          command_status=$?
          set -e
          if [[ "$command_status" -eq 0 ]]; then
            claude_mcp_snapshot "$metadata" "$after"
            "$mcp_sync" import-claude-diff "$family" "$profile" "$before" "$after"
            "$mcp_sync" sync-claude-profile "$family" "$metadata"
          fi
          find "$before" "$after" -delete
          exit "$command_status"
        fi
        if [[ "$shared_mcp" == true && "${1:-}" == mcp && "${2:-}" == remove && -n "${3:-}" ]] \
          && "$mcp_sync" has "$family" "$3"; then
          "$mcp_sync" remove "$family" "$3"
          "$mcp_sync" sync-claude-profile "$family" "$config_dir/.claude.json"
          exit 0
        fi
        resolve_lane "$@"
        resolve_lane_dir
        # Evidence 3: the lane's directory is ENTERED before anything is
        # launched, and a recorded one that is gone is a refusal naming it
        # (RV-W2). Before the `--dir` probe below, because the `cd` is this
        # launcher's own act and holds whether or not lane-start can be told.
        enter_lane_dir
        lane_argv=(lane-start)
        # Amendment 11(3). `--dir` is lane-start's oldest option, but a
        # lane-start that somehow has none must not be handed one: the probe is
        # the same `--help` read every capability check in this launcher
        # shares, and it is made once.
        if [[ -n "${lane:-}" && -n "${lane_dir:-}" ]]; then
          if lane_start_supports --dir; then
            lane_argv+=(--dir "$lane_dir")
          else
            lane_dir=""
            lane_dir_source=""
          fi
        fi
        # PRECEDENCE 4's swap-record guess no longer reaches this point at all
        # (lane-collision-protocol Amendment 18 Addendum 1, clause (i-5)):
        # `resolve_lane` either exits the whole launch already — the picker's
        # exit 0 or 8 — or returns with `lane` empty on a picker refusal, no
        # `lane` on PATH, or no terminal. So `lane_source` is never `record`
        # here any more, and every lane this launcher still hands to
        # lane-start — flag, window, window-record — is one lane-start may
        # take BARE, byte for byte what `--lane` always did: no `--confirm`,
        # and therefore no `--yes` beside it either (`--yes` was always inert
        # unless `--confirm` came with it, and this launcher passes
        # `--confirm` to lane-start nowhere any more).
        claude_flags=(--allow-dangerously-skip-permissions
                      --dangerously-skip-permissions
                      --permission-mode bypassPermissions)
        # Published only once every part of it is settled: the lane, where it
        # came from, the window's address, and the directory that is actually
        # being passed rather than the one that was merely derived.
        export_lane_identity
        if [[ -n "${lane:-}" ]]; then
          # LANE-START IS RUN, NEVER EXEC'D — A8 Addendum 2 R-A8-3, widened to
          # every lane source by Amendment 11(3).
          #
          # Under Amendment 8 only the confirm path ran it; `--lane` and the
          # window name were `exec`ed, byte-for-byte as `--lane` always had
          # been. Then `pclaude --lane openXfactory-5 run team01l` met a lane
          # whose checkout is not `$PROJECTS_ROOT/<repo>`: lane-start exited 1
          # with "no such directory … pass --dir", the exec'd process was the
          # only command of the tmux session the launcher had just made, and
          # tmux printed `[exited]` over a window with no Claude in it
          # (new-workstation#20, Evidence 2). An exec cannot catch anything, so
          # the one place that could keep that window alive was gone before the
          # refusal happened. There is no lane source for which that trade is
          # worth making, so there is now one path for all of them.
          # STDERR IS ALSO CAPTURED, LIVE, INTO A FILE (opensoft/workBenches#77).
          # `lane-start --confirm` still asks even where `lanes-edit.sh
          # live-holder` named a live FORK of this lane's transcript first
          # (decision 8(e): a fork is a DEFECT, never a holder) — and a
          # decline there must not risk a second live process on that same
          # transcript. The confirm question itself needs the REAL terminal,
          # so this TEES rather than redirects: fd 9 carries a copy of every
          # byte lane-start (or whatever it execs) writes to stderr into
          # $lane_defect_capture, and the `tee` on the far end puts the same
          # byte back on the real stderr (`>&2`) unchanged — the operator
          # sees exactly what they always saw, in the same order, live.
          # `wait` is on the TEE's own pid, not this command's: the pipe's
          # reader is a separate process, and a read of the capture file
          # made before that process has drained it would race an
          # almost-instantly-declined confirm (the fake this PR's test uses
          # is exactly that race, made deterministic by this wait).
          # NO AGE-BASED SWEEP OF OLD KEPT CAPTURES (Copilot round 1 on
          # opensoft/workBenches#96 added one, `-mmin +60`, on the reasoning
          # that a capture's mtime stops moving once the tee that owns it
          # stops writing; round 2 found the reasoning wrong — an ordinary
          # interactive Claude session's own display goes to stdout, so a
          # session can sit fully alive for well over an hour without ONE
          # byte landing on the stderr this tees, leaving a live capture's
          # mtime just as stale as an abandoned one's. `rm`ing it out from
          # under that still-open tee does not corrupt the WRITING
          # process's own data (the inode survives as long as its fd is
          # open), but it does mean that same launch's own later keep/print
          # logic — path-based, like the truncation right below — finds
          # nothing there once it finally runs. A time-only signal cannot
          # tell "quiet but alive" from "abandoned", and getting this wrong
          # loses evidence a live session still owns, which is worse than
          # the unbounded-across-TIME accumulation it would have bounded;
          # a correct version needs to know the owning process is actually
          # dead (a pid recorded alongside the capture, checked with `kill
          # -0`), which is a distinct feature this issue never asked for.
          # The per-file byte cap right below still bounds any ONE capture,
          # kept or not, and carries no such risk — it only ever touches
          # the file THIS invocation itself owns.
          lane_defect_capture="$(mktemp "${TMPDIR:-/tmp}/pclaude-lane-defect.XXXXXX")"
          # THE PATH IS PRINTED BEFORE THE EXEC (opensoft/workBenches#95): a
          # launcher-made window that exits fast can take this whole pane —
          # and the live tee below with it — the instant the command below
          # returns, so this is the one line an operator glancing at a pane
          # already on its way out, or a terminal whose scrollback outlives
          # the pane by a moment, might still catch. Belt and braces beside
          # the keep-and-print below, never the load-bearing half alone.
          echo "pclaude: lane defect capture: $lane_defect_capture" >&2
          lane_defect_fast_exit_seconds="${WORKBENCHES_CLAUDE_LANE_DEFECT_SECONDS:-20}"
          # VALIDATED (Copilot round 2 on opensoft/workBenches#96,
          # claude-profile:2756): a malformed or negative override reaching
          # the `-ge` comparison below is not just a stray "integer
          # expression expected" on stderr — a NEGATIVE number would make
          # that comparison true for status 0 no matter how fast the run
          # was, silently defeating the whole keep rule it guards. Anything
          # that is not a bare non-negative integer falls back to the
          # documented default instead of reaching that comparison at all.
          [[ "$lane_defect_fast_exit_seconds" =~ ^[0-9]+$ ]] \
            || lane_defect_fast_exit_seconds=20
          # NORMALIZED, NOT JUST SHAPE-CHECKED (Copilot round 3 on
          # opensoft/workBenches#96, claude-profile:2776): the regex above
          # accepts "08"/"09"/"010" as digit strings, but `[[ -ge ]]` reads a
          # leading-zero operand as OCTAL — "08" and "09" are not even valid
          # octal digits and error outright, and "010" silently means 8, not
          # the ten someone typed. Stripped down to the decimal number it
          # looks like ("0" itself left alone) before it is ever compared.
          while [[ "$lane_defect_fast_exit_seconds" == 0* \
            && "${#lane_defect_fast_exit_seconds}" -gt 1 ]]; do
            lane_defect_fast_exit_seconds="${lane_defect_fast_exit_seconds#0}"
          done
          lane_defect_started="$SECONDS"
          set +e
          exec 9> >(tee "$lane_defect_capture" >&2)
          lane_defect_tee_pid=$!
          CLAUDE_CONFIG_DIR="$config_dir" CLAUDE_BIN="$claude_bin" \
            "${lane_argv[@]}" "$lane" -- "${claude_flags[@]}" "$@" 2>&9
          lane_status=$?
          # CAPTURED HERE, NOT AFTER `wait` (Copilot round 3 on
          # opensoft/workBenches#96, claude-profile:2814): `wait` only
          # rejoins the TEE process, which can still be draining buffered
          # output for a moment after the command it was reading from has
          # already exited. Timing the LANE COMMAND — was $lane_status
          # decided fast? — means stopping the clock the instant it is
          # decided, not after whatever the tee has left to flush.
          lane_defect_elapsed=$(( SECONDS - lane_defect_started ))
          exec 9>&-
          wait "$lane_defect_tee_pid" 2>/dev/null
          set -e
          lane_defect_line="$(lane_defect_retire_line "$lane_defect_capture" || true)"
          # opensoft/workBenches#95: an UNCONDITIONAL `rm -f` here deleted the
          # only evidence of a fast exit in the same breath the window that
          # showed it live could also be gone. KEPT now unless this run is
          # provably nothing new: statuses 1 and 2 are lane-start's own two
          # documented refusals (below) — nothing renamed, nothing written,
          # Claude never started — so they are redundant with what already
          # printed live, PROVIDED the window is CONFIRMED not already the
          # lane's own — a read that succeeded and named something else, not
          # merely a read that failed (`lane_window_confirmed_elsewhere`,
          # Copilot round 1 on #96: tmux being unreachable looks exactly like
          # the pane this launcher would be keeping evidence FOR having
          # already closed, so unreadable keeps rather than deletes). Where
          # the window IS the lane's, or is unreadable, that same status could
          # just as easily be a Claude lane-start took the lane and exec'd
          # (Evidence 2/5g), and the ambiguity is exactly why this keeps
          # rather than guesses. A status 0 that held the pane at least
          # $lane_defect_fast_exit_seconds is an ordinary long-lived run and
          # is deleted; anything faster, or any other status, is kept with
          # its tail printed below — "nothing to see" and "the evidence of
          # what broke" look identical from a status and an elapsed time
          # alone, and guessing wrong the deleting way is the bug this
          # closes. ($lane_defect_elapsed itself was captured right after
          # $lane_status, above — before `wait`, not after.)
          lane_defect_clean=false
          if { [[ "$lane_status" -eq 1 || "$lane_status" -eq 2 ]] \
              && lane_window_confirmed_elsewhere "$lane"; } \
            || { [[ "$lane_status" -eq 0 ]] \
              && [[ "$lane_defect_elapsed" -ge "$lane_defect_fast_exit_seconds" ]]; }; then
            lane_defect_clean=true
          fi
          if [[ "$lane_defect_clean" == true ]]; then
            rm -f "$lane_defect_capture"
          else
            # BOUND WHAT IS KEPT, NOT JUST WHAT IS PRINTED (Copilot round 1 on
            # opensoft/workBenches#96, claude-profile:2752, revised round 2
            # and round 3): the tail below is 15 lines, but until now the
            # FILE ITSELF carried the whole stderr stream, unbounded — one
            # very chatty fast exit could keep megabytes. BY BYTES, not
            # lines (round 2: a line-count cap does not bound storage
            # against one very long line), and written with `mktemp` rather
            # than a plain redirect (round 2: a plain `>` creates the
            # replacement under the shell's umask — commonly
            # world-readable, unlike the original capture's own 0600 — and
            # a predictable `.trunc` name in a shared TMPDIR can be
            # pre-planted as a symlink). There is NO sweep of OLD kept
            # captures across separate invocations — round 1 added one,
            # round 2 retracted it as unsafe (see the comment above the
            # mktemp this file's own capture came from) — so 200000 bytes
            # only bounds any ONE capture, never how many accumulate over
            # time. The LIVE stream this tees from is left unbounded on
            # purpose, so the operator watching it live still sees
            # everything, exactly as documented above. EVERY STEP HERE IS
            # GUARDED (round 3: `mktemp`/`tail`/`mv` were bare statements
            # after `set -e` was restored, so any one of them failing —
            # disk pressure, most plausibly — killed the launcher before it
            # ever reached the tail-and-causes print below, the opposite of
            # "best-effort"): a failed `mktemp` leaves nothing to truncate
            # into and this is skipped; a failed `tail` or `mv` cleans up
            # its own scratch file and leaves the untruncated capture in
            # place, oversized rather than lost.
            if [[ "$(wc -c < "$lane_defect_capture" 2>/dev/null)" -gt 200000 ]]; then
              lane_defect_trunc=""
              lane_defect_trunc="$(mktemp "$lane_defect_capture.trunc.XXXXXX" 2>/dev/null)" \
                || lane_defect_trunc=""
              if [[ -n "$lane_defect_trunc" ]]; then
                if tail -c 200000 "$lane_defect_capture" > "$lane_defect_trunc" 2>/dev/null; then
                  mv -f "$lane_defect_trunc" "$lane_defect_capture" 2>/dev/null \
                    || rm -f "$lane_defect_trunc"
                else
                  rm -f "$lane_defect_trunc"
                fi
              fi
            fi
            {
              echo "pclaude: $lane exited after ${lane_defect_elapsed}s (status $lane_status); lane defect capture kept: $lane_defect_capture"
              tail -n 15 "$lane_defect_capture"
              echo "pclaude: known causes — a title resume opened the interactive picker: resume by the exact uuid instead; a background or fork holder: claude agents, or claude attach <id>, or lane-end $lane --retire <pid>"
            } >&2
          fi
          # WHICH STATUSES ARE LANE-START'S OWN. It documents exactly two:
          # 1 environment — not inside tmux, no register, NO SUCH DIRECTORY —
          # and 2 refusal — an argument error, a name a window cannot take, a
          # lane live in another window. In both, nothing was renamed, nothing
          # was written and Claude never started. Every other status came from
          # a Claude that lane-start exec'd, and is this launcher's status too;
          # so is 0, which is also how a lane-start that DECLINED the confirm
          # question reports having launched Claude bare itself. Starting a
          # second Claude behind either would be worse than the dead end this
          # catches.
          #
          # 1 and 2 are also statuses a Claude can return on its own, and the
          # window is what tells the two apart: taking a lane renames the
          # window to it (Amendment 5(f)), and a lane-start that never took one
          # left the name alone. That read is EXACT wherever the window was not
          # already the lane's — the `--lane`, record and no-window paths, which
          # is every path a restart can close a window on. Where the window was
          # ALREADY the lane (the window default, Amendment 11(2)) the rename
          # is a no-op and the read cannot separate them: there the status is
          # handed back, because the launcher is a command in an existing
          # window's shell there and a refusal returns the operator to the
          # prompt with lane-start's own words above it — while a bare Claude
          # started behind a session that may still be the lane's would mint a
          # new transcript in the lane's own window, which is the lineage fault
          # the whole protocol exists to prevent.
          #
          # AND THE WINDOW-ALREADY-THE-LANE'S ARM STOPS AT THE ONE PLACE IT
          # WOULD EXIT A PANE (`R-A11-4`: "no path exits the pane"). Where this
          # process is the only command of its tmux pane, handing a refusal back
          # is not "returning the operator to a prompt": there is no prompt
          # behind it, and tmux prints `[exited]` over a window with no Claude
          # in it, which is Evidence 2 exactly. Act 1 step 3 now names that
          # window for the lane at birth and step 2 reuses a window that already
          # carries the name, so this arm became reachable there in a way it was
          # not before, through a door act 1 itself opened. The lineage
          # objection does not reach it either: a window this launcher just
          # created, or one whose pane it just respawned, has nothing of the
          # lane's running behind it to mint a second transcript beside.
          #
          # `lane_is_pane_root` is that test, and since `R-A11-16` it is a test
          # about the PANE and not only about the environment marker act 1
          # sets: the window whose only command is `pclaude` and which this
          # launcher did not create — RV-W3's open case — is now inside the
          # fence, because the pane's own root process says so.
          # A LIVE FORK NAMED, AND THIS WINDOW DID NOT TAKE THE LANE, IS A STOP,
          # NOT A LAUNCH (opensoft/workBenches#77, Amendment 18 DRAFT clause
          # (h)). `lane_status` is 0 either way here — the same 0 a lane-start
          # that TOOK the lane returns — so the window is what tells them
          # apart, exactly as it already does two checks below: taking the
          # lane renames it (Amendment 5(f)), and a decline leaves the name
          # alone. Where the defect was named and the window was NOT renamed,
          # whatever lane-start (or a Claude it may have exec'd bare) already
          # did is done; this launcher starts NOTHING further in this window
          # rather than risk a second live process on the fork decision 8(e)
          # just named — it prints the retire act named for it and stops.
          if [[ "$lane_status" -eq 0 ]] && [[ -n "$lane_defect_line" ]] \
            && ! lane_window_is "$lane"; then
            echo "pclaude: $lane is not taken in this window — a live fork of its transcript exists; $lane_defect_line" >&2
            exit 1
          fi
          if [[ "$lane_status" -eq 0 ]] \
            || { [[ "$lane_status" -ne 1 && "$lane_status" -ne 2 ]]; } \
            || { ! lane_is_pane_root && lane_window_is "$lane"; }; then
            exit "$lane_status"
          fi
          # lane-start's own refusal is already on the terminal: it is never
          # captured here, so nothing swallows it and nothing repeats it. This
          # is the launcher's one line beside it (F-W3), and it says what
          # happens next.
          lane_note_no_lane "lane-start did not take $lane (exit $lane_status); starting Claude with no lane in this window${lane_dir_note:+; $lane_dir_note}"
          # And this session is not in that lane, so nothing downstream may
          # read that it is — the usage guard's automatic swap would otherwise
          # write a PAUSED record for a lane this window never took. The raw
          # `CLAUDE_LANE`/`CLAUDE_LANE_DIR` go too: they are read at precedence
          # 1 and at the directory order's rung 1, so leaving them would let a
          # nested `pclaude` re-select the very lane lane-start just refused.
          unset WORKBENCHES_CLAUDE_LANE WORKBENCHES_CLAUDE_LANE_SOURCE \
                WORKBENCHES_CLAUDE_LANE_DIR CLAUDE_LANE CLAUDE_LANE_DIR
        fi
        CLAUDE_CONFIG_DIR="$config_dir" exec "$claude_bin" "${claude_flags[@]}" "$@"
        ;;
    esac
    ;;
  *) echo "Usage: claude-profile {list|login|status|run} [PROFILE]" >&2; exit 2 ;;
esac
