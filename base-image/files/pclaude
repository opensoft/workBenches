#!/usr/bin/env bash
# Profile-only entry point. With no arguments claude-profile reuses the last
# run profile; explicit lane options remain compatible while the ordinary
# command always bypasses lane resolution.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  set -- run
fi

lane_requested=false
for argument in "$@"; do
  case "$argument" in
    --lane|--lane=*|--dir|--dir=*|--with-lane)
      lane_requested=true
      break ;;
    --no-lane) ;;
    *) break ;;
  esac
done

if [[ "$lane_requested" == true ]]; then
  exec claude-profile "$@"
fi
exec claude-profile --no-lane "$@"
