#!/usr/bin/env bash
set -euo pipefail

manifest="${CODEX_PROFILES_MANIFEST:-${CHATGPT_PROFILES_MANIFEST:-${XDG_CONFIG_HOME:-$HOME/.config}/workbenches/openai-profiles.json}}"
base="${CODEX_PROFILES_HOME:-${CHATGPT_PROFILES_HOME:-$HOME/.chatgpt-profiles}}"
command -v jq >/dev/null 2>&1 || { echo "jq is required." >&2; exit 1; }

codex_bin="${CODEX_BIN:-$(command -v codex || true)}"
if [[ -z "$codex_bin" && -x "$HOME/.local/bin/codex" ]]; then
  codex_bin="$HOME/.local/bin/codex"
fi
mcp_sync="${WORKBENCHES_MCP_SYNC_BIN:-$(command -v workbenches-mcp-sync || true)}"
if [[ -z "$mcp_sync" ]]; then
  launcher_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  [[ -x "$launcher_dir/workbenches-mcp-sync" ]] && mcp_sync="$launcher_dir/workbenches-mcp-sync"
fi

family_uses_shared_mcp() {
  local family="$1"
  local configured=",${WORKBENCHES_SHARED_MCP_FAMILIES:-opensoft},"
  [[ "$configured" == *",$family,"* ]]
}

profile_metadata() {
  local requested="$1" normalized row metadata candidate profile_path fallback_row
  local preferred_row preferred_depth=-1 path_depth
  normalized="$(printf '%s' "$requested" | tr '[:upper:]' '[:lower:]')"
  if [[ -f "$manifest" ]]; then
    row="$(jq -r --arg name "$normalized" \
      '.profiles[]
       | select(
           ((.name | ascii_downcase) == $name)
           or any(.aliases[]?; (ascii_downcase == $name))
         )
       | [.name,.email,.family,(.profilePath // .name)] | @tsv' \
      "$manifest" | head -n 1)"
    if [[ -n "$row" ]]; then
      printf '%s\n' "$row"
      return 0
    fi
  fi

  while IFS= read -r -d '' metadata; do
    candidate="$(jq -r --arg name "$normalized" '
      if (((.name // "") | ascii_downcase) == $name)
         or any(.aliases[]?; (ascii_downcase == $name))
      then "match" else empty end
    ' "$metadata")"
    if [[ "$candidate" == "match" ]]; then
      profile_path="${metadata#"$base/profiles/"}"
      profile_path="${profile_path%/.profile.json}"
      row="$(jq -r --arg path "$profile_path" '[.name,.email,.family,$path] | @tsv' "$metadata")"
      if jq -e '(.profilePath // "") | length > 0' "$metadata" >/dev/null; then
        path_depth="$(awk -F/ '{print NF}' <<<"$profile_path")"
        if (( path_depth > preferred_depth )); then
          preferred_row="$row"
          preferred_depth="$path_depth"
        fi
      elif [[ -z "${fallback_row:-}" ]]; then
        fallback_row="$row"
      fi
    fi
  done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
  if [[ -n "${preferred_row:-}" ]]; then
    printf '%s\n' "$preferred_row"
    return 0
  fi
  if [[ -n "${fallback_row:-}" ]]; then
    printf '%s\n' "$fallback_row"
    return 0
  fi
  return 1
}

action="${1:-list}"
if [[ "$action" == "list" || "$action" == "login" || "$action" == "status" || "$action" == "logout" || "$action" == "run" ]]; then
  [[ $# -eq 0 ]] || shift
else
  action="run"
fi

case "$action" in
  list)
    {
      if [[ -f "$manifest" ]]; then
        jq -r '.profiles[] | [.name, .family, .email, ((.aliases // []) | join(","))] | @tsv' "$manifest"
      fi
      while IFS= read -r -d '' metadata; do
        jq -r '[.name,.family,.email,((.aliases // []) | join(","))] | @tsv' "$metadata"
      done < <(find "$base/profiles" -mindepth 2 -type f -name .profile.json -print0 2>/dev/null || true)
    } | awk -F '\t' '!seen[tolower($1)]++'
    ;;
  login|status|logout|run)
    profile="${1:?Usage: codex-profile $action PROFILE [arguments]}"; shift
    row="$(profile_metadata "$profile" || true)"
    [[ -n "$row" ]] || { echo "Unknown Codex profile: $profile" >&2; exit 2; }
    IFS=$'\t' read -r profile email family profile_path <<<"$row"
    config_dir="$base/profiles/$profile_path"
    [[ -d "$config_dir" ]] || { echo "Codex profile is not configured: $config_dir" >&2; exit 2; }
    [[ -n "$codex_bin" ]] || { echo "Codex CLI not found." >&2; exit 1; }

    export CODEX_PROFILE_NAME="$profile"
    export CODEX_PROFILE_EMAIL="$email"
    export CODEX_PROFILE_FAMILY="$family"
    codex_auth_config=(
      -c 'forced_login_method="chatgpt"'
      -c 'cli_auth_credentials_store="file"'
    )
    codex_runtime_config=()
    shared_mcp=false
    if family_uses_shared_mcp "$family" && [[ -n "$mcp_sync" && -x "$mcp_sync" ]]; then
      shared_mcp=true
      "$mcp_sync" ensure "$family"
      mapfile -t shared_mcp_config < <("$mcp_sync" codex-args "$family")
      codex_runtime_config+=("${shared_mcp_config[@]}")
    fi
    if [[ -n "${CODEX_SONARQUBE_MCP_URL:-}" ]]; then
      sonarqube_mcp_url_toml="$(jq -Rn --arg value "$CODEX_SONARQUBE_MCP_URL" '$value')"
      codex_runtime_config+=(
        -c "mcp_servers.sonarqube.url=$sonarqube_mcp_url_toml"
      )
    fi
    if family_uses_shared_mcp "$family"; then
      vibe_annotations_mcp_url="${CODEX_VIBE_ANNOTATIONS_MCP_URL:-}"
      if [[ -z "$vibe_annotations_mcp_url" && -f /.dockerenv \
        && "${WORKBENCHES_DISABLE_DEFAULT_VIBE_MCP:-0}" != 1 ]]; then
        vibe_annotations_mcp_url="http://host.docker.internal:3846/mcp"
      fi
      if [[ -n "$vibe_annotations_mcp_url" ]]; then
        vibe_annotations_mcp_url_toml="$(jq -Rn --arg value "$vibe_annotations_mcp_url" '$value')"
        codex_runtime_config+=(
          -c "mcp_servers.vibe-annotations.url=$vibe_annotations_mcp_url_toml"
        )
      fi
    fi

    case "$action" in
      login)
        printf 'Starting ChatGPT login for %s (%s).\n' "$profile" "$email" >&2
        CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" login "$@"
        ;;
      status)
        CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" login status "$@"
        ;;
      logout)
        CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" logout "$@"
        ;;
      run)
        if [[ "$shared_mcp" == true && "${1:-}" == mcp && "${2:-}" == add ]]; then
          before="$(mktemp "$config_dir/.mcp-before.XXXXXX.json")"
          after="$(mktemp "$config_dir/.mcp-after.XXXXXX.json")"
          CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" mcp list --json >"$before"
          set +e
          CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" "$@"
          command_status=$?
          set -e
          if [[ "$command_status" -eq 0 ]]; then
            CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" mcp list --json >"$after"
            "$mcp_sync" import-codex-diff "$family" "$profile" "$before" "$after"
          fi
          find "$before" "$after" -delete
          exit "$command_status"
        fi
        if [[ "$shared_mcp" == true && "${1:-}" == mcp && "${2:-}" == remove && -n "${3:-}" ]]; then
          shared_removed=false
          if "$mcp_sync" has "$family" "$3"; then
            "$mcp_sync" remove "$family" "$3"
            shared_removed=true
          fi
          set +e
          CODEX_HOME="$config_dir" "$codex_bin" "${codex_auth_config[@]}" "$@"
          command_status=$?
          set -e
          if [[ "$shared_removed" == true ]]; then
            exit 0
          fi
          exit "$command_status"
        fi
        CODEX_HOME="$config_dir" exec "$codex_bin" \
          "${codex_auth_config[@]}" \
          "${codex_runtime_config[@]}" \
          "$@"
        ;;
    esac
    ;;
  *) echo "Usage: codex-profile {list|login|status|logout|run} [PROFILE]" >&2; exit 2 ;;
esac
