#!/usr/bin/env python3
"""Forward a native workstation command; never substitute a container install."""
import os
import sys
from workbenches_host import run

result = run([os.path.basename(sys.argv[0]), *sys.argv[1:]],
             input=sys.stdin.buffer.read() if not sys.stdin.isatty() else None,
             capture_output=True)
sys.stdout.buffer.write(result.stdout)
sys.stderr.buffer.write(result.stderr)
sys.exit(result.returncode)
