#!/usr/bin/env python3
"""Open only Rclone's local OAuth entry point on the native workstation."""
import sys
import os
from pathlib import Path
from urllib.parse import urlsplit
import workbenches_host as host

url = sys.argv[1] if len(sys.argv) == 2 else ''
parsed = urlsplit(url)
if (parsed.scheme != 'http' or parsed.hostname != '127.0.0.1'
        or parsed.port != 53682 or parsed.path != '/auth' or parsed.username):
    raise SystemExit(2)
os.umask(0o077)
Path('browser-url').write_text(url)
for executable in ('wslview', 'xdg-open', 'open', 'explorer.exe'):
    if host.which(executable):
        raise SystemExit(host.run([executable, url], capture_output=True).returncode)
raise SystemExit(1)
